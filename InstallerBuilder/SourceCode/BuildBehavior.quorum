use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent

/*
    BuildBehavior is what the Build installers button does: it starts the
    build in the window. A button reports being pressed only through its
    behavior, so the button needs one.
*/
class BuildBehavior is Behavior
    Main window = undefined

    action SetWindow(Main window)
        me:window = window
    end

    action Run(BehaviorEvent event)
        if window not= undefined
            window:StartBuild()
        end
    end
end
