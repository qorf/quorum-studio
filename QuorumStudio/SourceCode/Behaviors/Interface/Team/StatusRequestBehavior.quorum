package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Studio.OutputEditorTabPane
use Libraries.Development.Environment.Studio.StudioFocusManager
use Libraries.Development.Environment.Projects.Project
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Development.Environment.Studio.Interface.TeamTab
use Libraries.Development.Versioning.Git
use Libraries.Development.Versioning.StatusResult
use Libraries.Development.Versioning.TeamStatus

/*
Reads the selected project's git status, on the git thread, and hands it to
the Team tab (Status A1). Team > Status (TeamStatusBehavior) and the tab's
own refreshes queue it; it doesn't open the tab or move focus.
*/
class StatusRequestBehavior is QuorumStudioBehavior
    action Run(BehaviorEvent event)
        QuorumStudio studio = GetMainApplication()
        StudioFocusManager manager = studio:GetStudioFocusManager()
        OutputEditorTabPane outPane = studio:GetOutputPane()
        TeamTab teamTab = outPane:GetTeamTabWithoutOpening()
        teamTab:PostStatus(GetStatus(manager:GetProjectFocus()))
    end

    /*
    This action reads a project's status. Run it on the git thread. Other
    steps' behaviors, already on the git thread, call it after their own
    work and post the result to the Team tab.
    */
    action GetStatus(Project project) returns TeamStatus
        TeamStatus status
        if not (project is QuorumProject)
            status:SetNoProject()
            return status
        end
        QuorumProject quorumProject = cast(QuorumProject, project)
        if not quorumProject:HasGitSupport()
            status:SetNoGit(quorumProject:GetName())
            return status
        end
        Git git
        StatusResult result = git:GetStatus(quorumProject:GetGitRepository())
        status:Setup(result, quorumProject:GetLocation(), quorumProject:GetName())
        return status
    end
end
