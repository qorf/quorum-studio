package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.TextChangeListener
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Development.Environment.Studio.Interface.NewBranchDialog

// B5: checks the name as you type.
class BranchNameListener is TextChangeListener
    NewBranchDialog dialog = undefined

    action SetDialog(NewBranchDialog value)
        dialog = value
    end

    action TextChanged(TextChangeEvent event)
        if dialog not= undefined
            dialog:NameChanged()
        end
    end
end
