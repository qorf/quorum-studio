package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.Interface.CommitDialog

/*
The Commit dialog's Commit button. An empty message keeps the dialog open
with C2's line; otherwise the dialog closes and the commit runs on the git
thread.
*/
class CommitDialogOkButtonBehavior is QuorumStudioBehavior
    CommitDialog dialog = undefined

    action Run(BehaviorEvent event)
        if dialog = undefined
            return now
        end
        text message = dialog:GetMessage()
        text trimmed = message:Trim()
        if trimmed = ""
            dialog:ShowMessageProblem()
            return now
        end

        dialog:CommitStarted()
        dialog:Hide()

        CommitInterfaceBehavior owner = dialog:GetOwner()
        CommitRequestBehavior commit = owner:GetCommitRequestBehavior()
        commit:Setup(dialog:GetProject(), trimmed, dialog:GetStagedCount(), dialog:GetCredentials(), owner)
        ThreadedBehavior threaded = owner:GetThreadedCommitRequestBehavior()
        threaded:Run(event)
    end

    action GetDialog returns CommitDialog
        return dialog
    end

    action SetDialog(CommitDialog dialog)
        me:dialog = dialog
    end
end
