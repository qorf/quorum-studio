package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Studio.OutputEditorTabPane
use Libraries.Development.Environment.Studio.CodeEditorTabPane
use Libraries.Development.Environment.Studio.TeamReporter
use Libraries.Development.Environment.Studio.Interface.TeamTab
use Libraries.Development.Environment.Studio.Interface.EditorTab
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Development.Environment.Projects.Credentials
use Libraries.Development.Versioning.Git
use Libraries.Development.Versioning.CommitRequest
use Libraries.Development.Versioning.CommitResult
use Libraries.Development.Versioning.StatusResult
use Libraries.Development.Versioning.TeamStatus
use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Interface.Controls.Tab

/*
Commits, on the git thread (Commit C5 and C6). After, the Team tab gets a
new status. A commit that worked is reported with TeamReporter (one
Console line when the Team tab isn't showing); one that failed reopens the
dialog with the reason and the message, so nothing typed is lost.
*/
class CommitRequestBehavior is QuorumStudioBehavior
    QuorumProject project = undefined
    text message = ""
    integer fileCount = 0
    Credentials credentials = undefined
    CommitInterfaceBehavior owner = undefined

    // Called on the main thread, before the git thread runs this.
    action Setup(QuorumProject projectValue, text messageValue, integer files, Credentials credentialsValue,
            CommitInterfaceBehavior ownerValue)
        project = projectValue
        message = messageValue
        fileCount = files
        credentials = credentialsValue
        owner = ownerValue
    end

    action Run(BehaviorEvent event)
        if project = undefined
            return now
        end
        QuorumStudio studio = GetMainApplication()
        OutputEditorTabPane outPane = studio:GetOutputPane()
        CodeEditorTabPane editor = studio:GetTabPane()

        CommitRequest request
        if credentials not= undefined
            request:SetCredentials(credentials)
        end
        request:SetMessage(message)
        Git git
        CommitResult result = git:Commit(project:GetGitRepository(), request)

        // As before: the editors' change marks compare with the new commit.
        Iterator<Tab> iterator = editor:GetOpenTabIterator()
        repeat while iterator:HasNext()
            Tab tab = iterator:Next()
            if tab is EditorTab
                EditorTab et = cast(EditorTab, tab)
                et:SetIsParseDirty(true)
            end
        end

        StatusRequestBehavior reader
        TeamStatus status = reader:GetStatus(project)
        TeamTab teamTab = outPane:GetTeamTabWithoutOpening()
        teamTab:PostStatus(status)

        if result:IsSuccessful()
            TeamReporter reporter
            reporter:Report(GetSentence(status))
        else
            ShowCommitDialogBehavior show
            show:Setup(project, owner, status, credentials, GetProblem(result), message)
            outPane:AddBehavior(show)
        end
        project = undefined
    end

    // C5: Committed "Make the hero jump higher" (3 files). 3 commits to push.
    private action GetSentence(TeamStatus status) returns text
        text dq = ""
        dq = dq:GetDoubleQuote()
        Array<text> lines = message:SplitIntoLines()
        text summary = message
        if not lines:IsEmpty()
            summary = lines:Get(0)
        end
        text sentence = "Committed " + dq + summary + dq + " (" + Words(fileCount, "file", "files") + ")."

        if not status:IsReady()
            return sentence
        end
        StatusResult result = status:GetResult()
        if result:HasUpstream()
            integer ahead = result:GetAheadCount()
            if ahead > 0
                sentence = sentence + " " + Words(ahead, "commit to push.", "commits to push.")
            end
        elseif result:HasRemote()
            sentence = sentence + " " + result:GetBranch() + " isn't on the server yet."
        end
        return sentence
    end

    // C6: the reason, in plain words, shown above the dialog's buttons.
    private action GetProblem(CommitResult result) returns text
        integer kind = result:GetFailureKind()
        if kind = result:NOTHING_STAGED
            return "Nothing is staged, so there was nothing to commit."
        elseif kind = result:NO_NAME
            return "Git needs your name and email to sign this commit."
        elseif kind = result:LOCKED
            return "Couldn't commit: the repository is locked by another program. Close other Git programs and try again."
        elseif kind = result:CONFLICTS
            return "Couldn't commit: some files still have conflicts. Fix them and stage them, then commit."
        end
        text reason = result:GetMessage()
        if reason = ""
            return "Couldn't commit."
        end
        return "Couldn't commit: " + reason
    end

    private action Words(integer count, text one, text many) returns text
        if count = 1
            return "1 " + one
        end
        return count + " " + many
    end

    action GetMessage returns text
        return message
    end

    action SetMessage(text message)
        me:message = message
    end
end
