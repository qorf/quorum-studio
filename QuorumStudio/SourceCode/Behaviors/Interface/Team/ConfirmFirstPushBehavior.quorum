package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent

// Push to the Server, when a new branch's first push asks: the same push,
// with the new branch allowed.
class ConfirmFirstPushBehavior is Behavior
    action Run(BehaviorEvent event)
        TeamPushBehavior push
        push:SetNewBranchConfirmed(true)
        push:Run(event)
    end
end
