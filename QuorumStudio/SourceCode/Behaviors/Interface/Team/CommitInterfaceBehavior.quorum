package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Studio.StudioFocusManager
use Libraries.Development.Environment.Studio.TeamReporter
use Libraries.Development.Environment.Projects.Project
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Development.Environment.Projects.Credentials
use Libraries.Development.Environment.Studio.Interface.CommitDialog
use Libraries.Development.Versioning.TeamStatus
use Libraries.Development.Versioning.StatusResult
use Libraries.Development.Versioning.GitProblem
use Libraries.Concurrency.ThreadRunner

/*
Team > Commit, and the way other steps open the Commit dialog
(Behaviors:GetCommitInterfaceBehavior): the Staged group's Commit... (C7)
and the project row's Commit... (Tree M3). It runs on the main thread; the
status is read on the git thread first (CommitPrepareBehavior), so the
dialog shows what's staged now. It also keeps what was typed when the
dialog closes without committing.
*/
class CommitInterfaceBehavior is QuorumStudioBehavior
    ThreadRunner gitRunner = undefined
    ThreadedBehavior threadedCommitRequestBehavior = undefined
    CommitRequestBehavior commitRequestBehavior = undefined
    text draft = ""
    text draftProject = ""

    action Run(BehaviorEvent event)
        QuorumStudio studio = GetMainApplication()
        StudioFocusManager manager = studio:GetStudioFocusManager()
        Project project = manager:GetProjectFocus()
        TeamReporter reporter
        if not (project is QuorumProject)
            reporter:Report("Select a project in the Project Tree to commit.")
            return now
        end
        QuorumProject quorumProject = cast(QuorumProject, project)
        if not quorumProject:HasGitSupport()
            reporter:Report(quorumProject:GetName() + " isn't in a Git repository, so there's nothing to commit.")
            return now
        end
        if gitRunner = undefined
            return now
        end
        CommitPrepareBehavior prepare
        prepare:Setup(quorumProject, me)
        gitRunner:Add(prepare)
    end

    /*
    This action opens the Commit dialog, on the main thread
    (ShowCommitDialogBehavior calls it). The message is a failed commit's
    message (C6), or "" to use the kept draft.
    */
    action ShowDialog(QuorumProject project, TeamStatus status, Credentials credentials, text problem, text message)
        if not status:IsReady()
            GitProblem gitProblem
            gitProblem:SetTitle("Commit")
            gitProblem:SetMessage("Couldn't read this project's changes, so there's nothing to show.")
            StatusResultDetails(gitProblem, status)
            TeamReporter reporter
            reporter:ReportProblem(gitProblem)
            return now
        end

        text startText = message
        text key = project:GetLocation():GetAbsolutePath()
        if startText = "" and draftProject = key
            startText = draft
        end
        CommitDialog dialog
        dialog:Setup(me, project, status, credentials, startText, problem)
        dialog:Show()
    end

    // What was typed, kept for the next time Commit opens for this project.
    action KeepDraft(QuorumProject project, text value)
        draftProject = project:GetLocation():GetAbsolutePath()
        draft = value
    end

    // JGit's message, for the problem dialog's Show Details.
    private action StatusResultDetails(GitProblem gitProblem, TeamStatus status)
        StatusResult result = status:GetResult()
        if result not= undefined
            gitProblem:SetDetails(result:GetMessage())
        end
    end

    action GetGitRunner returns ThreadRunner
        return gitRunner
    end

    action SetGitRunner(ThreadRunner gitRunner)
        me:gitRunner = gitRunner
    end

    action GetThreadedCommitRequestBehavior returns ThreadedBehavior
        return threadedCommitRequestBehavior
    end

    action SetThreadedCommitRequestBehavior(ThreadedBehavior threadedCommitRequestBehavior)
        me:threadedCommitRequestBehavior = threadedCommitRequestBehavior
    end

    action GetCommitRequestBehavior returns CommitRequestBehavior
        return commitRequestBehavior
    end

    action SetCommitRequestBehavior(CommitRequestBehavior commitRequestBehavior)
        me:commitRequestBehavior = commitRequestBehavior
    end
end
