package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Studio.OutputEditorTabPane
use Libraries.Development.Environment.Studio.Interface.TeamTab
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Development.Environment.Projects.Credentials
use Libraries.Development.Environment.Configuration.Options
use Libraries.Development.Versioning.Git
use Libraries.Development.Versioning.PullRequest
use Libraries.Development.Versioning.PullResult
use Libraries.Development.Versioning.StatusResult
use Libraries.Development.Versioning.TeamStatus
use Libraries.Development.Versioning.TeamProgressMonitor
use Libraries.Development.Versioning.GitConstants

/*
The pull itself, on the git thread (TeamPullBehavior queues it). It shows
the progress in the Team tab, pulls, reads the status again, and hands
everything to FinishPullBehavior, which updates the editor, the Project
Tree and the Team tab on the main thread. After a clean pull it runs the
behavior TeamPullBehavior was given (Push, for "Pull, then Push").
*/
class PullRequestBehavior is QuorumStudioBehavior
    QuorumProject project = undefined
    QuorumStudioBehavior afterCleanPull = undefined
    boolean pulling = false
    GitConstants constants

    // Main thread, before queuing: what to pull, and what to run after.
    action Prepare(QuorumProject value, QuorumStudioBehavior after)
        project = value
        afterCleanPull = after
        pulling = true
    end

    // A pull is queued or running.
    action IsPulling returns boolean
        return pulling
    end

    action Run(BehaviorEvent event)
        QuorumProject pullProject = project
        QuorumStudioBehavior afterPull = afterCleanPull
        project = undefined
        afterCleanPull = undefined
        if pullProject = undefined
            pulling = false
            return now
        end

        QuorumStudio studio = GetMainApplication()
        OutputEditorTabPane outPane = studio:GetOutputPane()
        TeamTab teamTab = outPane:GetTeamTabWithoutOpening()

        // The status before: the server branch, for the progress title,
        // and the commits to push, for L4's "combined them with your 2".
        StatusRequestBehavior reader
        TeamStatus beforeStatus = reader:GetStatus(pullProject)
        text upstream = ""
        StatusResult beforeResult = beforeStatus:GetResult()
        if beforeResult not= undefined
            upstream = beforeResult:GetUpstreamBranch()
        end

        TeamProgressMonitor monitor
        if upstream = ""
            monitor:SetTitle("Pulling")
        else
            monitor:SetTitle("Pulling from " + upstream)
        end
        teamTab:ShowProgress(monitor)

        PullRequest request
        request:SetProgressMonitor(monitor)
        Options options = studio:GetOptions()
        Credentials credentials = options:GetPassword(pullProject:GetLocation():GetAbsolutePath())
        if credentials not= undefined
            request:SetCredentials(credentials)
        end

        Git git
        PullResult result = git:Pull(pullProject:GetGitRepository(), request)
        monitor:Finish()
        TeamStatus afterStatus = reader:GetStatus(pullProject)

        FinishPullBehavior finish
        finish:Setup(pullProject, result, beforeStatus, afterStatus)
        outPane:AddBehavior(finish)
        pulling = false

        if afterPull not= undefined and IsClean(result)
            afterPull:Run(event)
        end
    end

    /*
    This action says whether a pull ended cleanly: no error, not stopped,
    the branch is on the server, and the merge was up to date, a
    fast-forward, or a merge without conflicts.
    */
    action IsClean(PullResult result) returns boolean
        if result:IsCancelled() or result:HasNoUpstream()
            return false
        end
        if result:GetErrorKind() not= constants:ERROR_NONE
            return false
        end
        integer status = result:GetMergeStatus()
        if status = constants:PULL_MERGE_ALREADY_UP_TO_DATE or status = constants:PULL_MERGE_FAST_FORWARD
            return true
        end
        return status = constants:PULL_MERGE_MERGED
    end
end
