package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.Interface.NewBranchDialog

// B5's "Use level-three" or "Switch to scores" button.
class BranchNameFixBehavior is Behavior
    NewBranchDialog dialog = undefined

    action SetDialog(NewBranchDialog value)
        dialog = value
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:ApplyFix()
        end
    end
end
