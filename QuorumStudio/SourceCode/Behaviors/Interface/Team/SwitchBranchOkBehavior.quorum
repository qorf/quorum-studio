package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.Interface.SwitchBranchDialog

// B1's Switch button, and Enter in the dialog.
class SwitchBranchOkBehavior is Behavior
    SwitchBranchDialog dialog = undefined

    action SetDialog(SwitchBranchDialog value)
        dialog = value
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:SwitchToSelected()
        end
    end
end
