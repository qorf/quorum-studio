package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.TreeItem
use Libraries.Interface.Selections.TreeSelection
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Studio.TeamReporter
use Libraries.Development.Environment.Projects.ProjectTree
use Libraries.Development.Environment.Projects.ProjectTreeItem
use Libraries.Development.Environment.Projects.Quorum.QuorumProject

/*
Team > Stage: stages what's selected in the Project Tree, the same way the
tree's own menu does (TreeStageBehavior): a file stages that file, a
folder stages everything under it (Stage Folder), and a project's row
stages all its changes (Stage All Changes). StageGate saves open files,
asks first when its rules say so (many files, media, Build and Run), and
stages on the git thread. The result shows in the Team tab, and as one
Console line when the Team tab isn't showing. When there's nothing to
stage, one line says why: nothing selected, a project not in Git, or a
file or folder with no changes.
*/
class AddRequestBehavior is QuorumStudioBehavior

    action Run(BehaviorEvent event)
        QuorumStudio studio = GetMainApplication()
        ProjectTree tree = studio:GetProjectTree()
        TeamReporter reporter

        ProjectTreeItem row = undefined
        TreeSelection selection = tree:GetSelection()
        if selection not= undefined and not selection:IsEmpty()
            TreeItem value = selection:GetTreeItem()
            if value is ProjectTreeItem
                row = cast(ProjectTreeItem, value)
            end
        end
        if row = undefined or row:GetFile() = undefined or row:GetProject() = undefined
            reporter:Report("Select a file or folder in the Project Tree to stage it.")
            return now
        end

        QuorumProject project = row:GetProject()
        if not project:HasGitSupport()
            reporter:Report(project:GetName() + " isn't in a Git repository, so there's nothing to stage.")
            return now
        end

        // The tree's Stage, Stage Folder or Stage All Changes. It says
        // "<name> has no changes to stage." when there are none.
        TreeStageBehavior stage
        stage:SetItem(row)
        stage:SetUnstage(false)
        stage:Run(event)
    end
end
