package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Containers.Support.Comparison
use Libraries.Interface.Controls.TextStyles.TextStyle

/*
    Orders text styles by where they start, so UpdateCodeEditorBehavior can
    add them to the block editor in file order.
*/
class TextStyleIndexComparison is Comparison
    action Compare(Object a, Object b) returns integer
        TextStyle left = cast(TextStyle, a)
        TextStyle right = cast(TextStyle, b)
        return Compare(left:GetIndex(), right:GetIndex())
    end
end
