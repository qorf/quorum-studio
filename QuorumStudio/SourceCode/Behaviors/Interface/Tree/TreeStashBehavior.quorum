package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Containers.Array
use Libraries.Concurrency.ThreadRunner
use Libraries.Game.GameStateManager
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Studio.TeamReporter
use Libraries.Development.Environment.Studio.Interface.TreeGitConfirmDialog
use Libraries.Development.Environment.Projects.ProjectTreeItem
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Development.Versioning.TeamStatus

/*
Stash Changes... on the project's row in the Project Tree's Git menu. Git
stashes the whole repository, so the dialog says how many changes are in
the project, and how many outside it are stashed too. Stash Changes queues
the stash on the git thread (StashWorkBehavior).
*/
class TreeStashBehavior is TreeGitBehavior

    action Continue(TeamStatus status)
        ProjectTreeItem row = GetItem()
        if row = undefined or status = undefined
            return now
        end
        QuorumProject project = row:GetProject()
        if project = undefined
            return now
        end
        TeamReporter reporter
        if not status:IsReady()
            reporter:Report("Couldn't read the changes in " + project:GetName() + ".")
            return now
        end

        integer inside = status:GetChangeCount()
        integer outside = status:GetOutside():GetSize()
        if inside + outside = 0
            reporter:Report("There are no changes to stash.")
            return now
        end

        GameStateManager manager
        QuorumStudio studio = cast(QuorumStudio, manager:GetGame())
        StashWorkBehavior work
        work:Setup(project, "Stashed from Quorum Studio")
        Behaviors behaviors = studio:GetBehaviors()
        ThreadRunner runner = behaviors:GetGitRunner()
        ThreadedBehavior threaded
        threaded:SetNestedBehavior(work)
        threaded:SetThreadRunner(runner)

        Array<text> lines
        lines:Add(CountWords(inside, "change", "changes") + " in " + project:GetName() + ".")
        if outside > 0
            lines:Add(CountWords(outside, "change", "changes") + " outside " + project:GetName() + " will be stashed too, because Git stashes the whole repository.")
        end
        lines:Add("Open files with unsaved changes keep them in the editor; those aren't stashed.")

        TreeGitConfirmDialog dialog
        dialog:Setup("Stash Changes", "Put your changes aside? Your files go back to the last commit, and Restore Stashed Changes brings the changes back.", lines, "Stash Changes", threaded)
        dialog:Show()
    end

    private action CountWords(integer count, text one, text many) returns text
        if count = 1
            return "1 " + one
        end
        return "" + count + " " + many
    end
end
