package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Containers.Array
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Item

/*
Deletes a group's items from the scene, after the user said yes
(SceneTreeDeleteBehavior). The tree builds its rows again once afterward.
*/
class SceneTreeDeleteItemsBehavior is QuorumStudioBehavior
    SceneEditor controller = undefined
    Array<Item> items

    action Setup(SceneEditor value, Array<Item> groupItems)
        controller = value
        integer index = 0
        repeat while index < groupItems:GetSize()
            items:Add(groupItems:Get(index))
            index = index + 1
        end
    end

    action Run(BehaviorEvent event)
        if controller = undefined
            return now
        end
        integer index = 0
        repeat while index < items:GetSize()
            controller:Delete(items:Get(index))
            index = index + 1
        end
    end
end
