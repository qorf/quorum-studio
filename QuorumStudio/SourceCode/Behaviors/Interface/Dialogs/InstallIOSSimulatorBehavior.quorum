package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.Mobile.IOSSimulatorInstaller

/*
    Runs the iOS Simulator download on a background thread. It blocks until the
    download is done; InstallIOSSimulatorDialog shows the progress meanwhile.
*/
class InstallIOSSimulatorBehavior is QuorumStudioBehavior
    action Run(BehaviorEvent event)
        IOSSimulatorInstaller installer
        installer:Download()
    end
end
