package Libraries.Development.Environment.Studio.Behaviors
use Libraries.Development.Environment.Studio.Interface.NewProjectDialog
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Button
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.System.File
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Projects.ProjectManager
use Libraries.Development.Environment.Studio.Interface.ErrorDialog


class NewProjectNextBehavior is QuorumStudioBehavior

    QuorumProject project
    NewProjectDialog dialog = undefined

    action SetDialog(NewProjectDialog dialog)
        me:dialog = dialog
    end

    action GetDialog returns NewProjectDialog
        return me:dialog
    end

    action Run(BehaviorEvent event)
        File file
    if dialog not= undefined 
            dialog:UpdateSecondPage()
            dialog:SetCurrentPage(dialog:GetProjectNamePage())
            dialog:GetProjectNamePage():GetFirstFocusableItem():Focus()
            dialog:SetBehavior(dialog:GetOkBehavior())
        end
    end
end