package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Behaviors.Behavior
use Libraries.Game.GameStateManager
use Libraries.Game.Game
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Studio.CodeEditorTabPane
use Libraries.Interface.Controls.Tab
use Libraries.Interface.Item2D
use Libraries.Development.Environment.Studio.Interface.CodeTextBox
use Libraries.Interface.Controls.TextBox
use Libraries.Interface.Controls.Dialog
use Libraries.Interface.Controls.Blocks.CodeEditor
use Libraries.Interface.Controls.Blocks.Block
use Libraries.Interface.Controls.Blocks.RootBlock

class GoToLineOkButtonBehavior is Behavior

    on create
        SetRunOnUpdate(true)
    end

    text lineIn = "0"
    Dialog dialog = undefined

    action SetDialog(Dialog dialog)
        me:dialog = dialog
    end

    action GetDialog returns Dialog
        return dialog
    end

    action GetLine returns text
        return lineIn
    end

    action SetLine(text line)
        me:lineIn = line
    end

    action Run(BehaviorEvent event)
        integer line = 0
        GameStateManager manager
        Game game = manager:GetGame()
        QuorumStudio studio = cast(QuorumStudio, game)
        CodeEditorTabPane editors = studio:GetTabPane()
        Item2D related = editors:GetCurrentItem()
        if related not= undefined
            check
                line = lineIn:ParseInteger()
                line = line - 1
            detect e
                if dialog not= undefined
                    dialog:Hide()
                end
                return now
            always

                if line < 0
                    line = 0
                end
    
                if dialog not= undefined
                    dialog:Hide()
                end
    
                if related is TextBox
                    TextBox box = cast(TextBox, related)

                    if line > box:GetLineCount()
                        line = box:GetLineCount() - 1
                    end
        
                    box:SetCaretPositionToLine(line)
                    box:GoToLine(line)
                    box:Focus()
                elseif related is CodeEditor
                    CodeEditor editor = cast(CodeEditor, related)
                    integer lastLine = editor:GetRawTextLineCount() - 1
                    if line > lastLine
                        line = lastLine
                    end

                    Block target = FindBlockAtTextLine(editor, line)
                    if target = undefined
                        editor:Focus()
                    else
                        // Scroll first: that draws the block and puts it back
                        // in the screen reader's tree. Then focus it, which
                        // reads it aloud and moves the selection to it.
                        editor:GoToBlock(target)
                        target:Focus()
                    end
                end
            end
        end
    end


    /*
    The block to land on for a text line (from 0). It's the block that ends
    on the line, or else the innermost one that holds it, the same rule as
    the renderer's GetNavigableBlockAtTextLine. On a blank line it's the next
    block, and past the end of the code it's the last one.
    */
    private action FindBlockAtTextLine(CodeEditor editor, integer line) returns Block
        RootBlock root = editor:GetRootBlock()
        if root = undefined
            return undefined
        end

        Block candidate = undefined
        Block following = undefined
        Block last = undefined
        Block current = root:GetNextNavigableBlock()
        repeat until current = undefined
            integer start = current:GetStartLine()
            integer finish = current:GetEndLine()
            if start <= line
                if finish = line
                    return current
                elseif finish > line
                    candidate = current
                end
            elseif following = undefined
                following = current
            end
            last = current
            current = current:GetNextNavigableBlock()
        end

        if candidate not= undefined
            return candidate
        end
        if following not= undefined
            return following
        end
        return last
    end
end