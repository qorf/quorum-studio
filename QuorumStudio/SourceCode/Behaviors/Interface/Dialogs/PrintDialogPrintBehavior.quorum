package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.Interface.PrintDialog

/*
    The PrintDialogPrintBehavior is the Print dialog's Print button, and
    its Enter key: it prints with the dialog's choices.
*/
class PrintDialogPrintBehavior is Behavior
    PrintDialog dialog = undefined

    action SetDialog(PrintDialog value)
        dialog = value
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:PrintNow()
        end
    end
end
