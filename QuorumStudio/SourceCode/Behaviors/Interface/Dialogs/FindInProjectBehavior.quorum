package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Development.Environment.Studio.Behaviors.QuorumStudioBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Containers.Array
use Libraries.System.File
use Libraries.Development.Environment.Studio.Interface.FindInProjectDialog
use Libraries.Development.Environment.Studio.Interface.SearchResultsTab
use Libraries.Development.Environment.Studio.OutputEditorTabPane
use Libraries.Game.GameStateManager
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Concurrency.ThreadRunner
use Libraries.Multitasking.Lines

/*
    The Find button's behavior in the Find in Project dialog. It reads the
    query and options, and starts the search as a
    Libraries.Development.Environment.Studio.Behaviors.FindInProjectTask, so
    the window keeps responding while it runs. A
    Libraries.Development.Environment.Studio.Behaviors.FindResultsBehavior
    on the search results tab shows the results once the task is done.
*/
class FindInProjectBehavior is QuorumStudioBehavior
    FindInProjectDialog dialog = undefined
    ThreadRunner runner = undefined

    action SetDialog(FindInProjectDialog dialog)
        me:dialog = dialog
    end

    action SetThread(ThreadRunner runner)
        me:runner = runner
    end

    action GetThread returns ThreadRunner
        return runner
    end
    
    action Run(BehaviorEvent event)
        if dialog not= undefined
            GameStateManager gameManager
            QuorumStudio studio = cast(QuorumStudio, gameManager:GetGame())
            OutputEditorTabPane tabPane = studio:GetOutputPane()

            SearchResultsTab searchResultsTab = tabPane:GetSearchResultsTab()
            text find = dialog:GetQuery()
            searchResultsTab:SetQuery(find)
            Array<File> files = dialog:GetSearchFiles()
            if find not= "" and not files:IsEmpty()
                // The task keeps its own copy of the files: the dialog
                // empties its list when it hides.
                FindInProjectTask task
                task:Setup(find, files:CopyToArray(), dialog:GetIsMatchCase(), dialog:GetIsWholeWord())
                searchResultsTab:SetCurrentSearch(task)
                Lines lines
                lines:LineUp(task)

                FindResultsBehavior results
                results:Setup(task, searchResultsTab)
                searchResultsTab:AddBehavior(results)
            end
            dialog:Hide()
            searchResultsTab:Activate()
        end
    end
end
