package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.Interface.NewFileDialog

// New File's Type choices, Quorum File and Scene: a choice was made, so the
// location and the line saying what will be made follow it.
class NewFileTypeBehavior is Behavior
    NewFileDialog dialog = undefined

    action SetDialog(NewFileDialog value)
        dialog = value
    end

    action Run(BehaviorEvent event)
        if dialog not= undefined
            dialog:TypeChanged()
        end
    end
end
