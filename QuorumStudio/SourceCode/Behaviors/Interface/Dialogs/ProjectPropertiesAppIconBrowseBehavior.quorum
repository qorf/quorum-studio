package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Interface.Controls.FileChooser
use Libraries.Interface.Controls.FileFilter
use Libraries.System.File
use Libraries.Development.Environment.Studio.Interface.ProjectPropertiesDialog

/*
    Chooses the app's icon, a PNG, for Project Properties' App Icon field.
*/
class ProjectPropertiesAppIconBrowseBehavior is QuorumStudioBehavior
    ProjectPropertiesDialog dialog = undefined

    action SetDialog(ProjectPropertiesDialog dialog)
        me:dialog = dialog
    end

    action Run(BehaviorEvent event)
        FileChooser chooser
        FileFilter filter
        filter:Add("png")
        QuorumProject project = dialog:GetProject()
        File file = chooser:OpenFileDialog(project:GetLocation(), filter)
        if file not= undefined
            dialog:SetAppIconLocation(file)
        end
    end
end
