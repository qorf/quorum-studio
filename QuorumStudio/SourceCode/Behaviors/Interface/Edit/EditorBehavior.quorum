package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Development.Environment.Studio.Behaviors.QuorumStudioBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.Interface.FindDialog
use Libraries.Interface.Controls.Dialog
use Libraries.Development.Environment.Studio.Interface.ReplaceDialog
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Item
use Libraries.Interface.Controls.TextBox
use Libraries.Interface.Selections.TextBoxSelection
use Libraries.Game.GameStateManager
use Libraries.Game.Game
use Libraries.Interface.Behaviors.Controls.TextBoxCopyToClipboardBehavior
use Libraries.Interface.Controls.MenuItem
use Libraries.Interface.Controls.MenuRoot
use Libraries.Game.FocusManager
use Libraries.Development.Environment.Projects.ProjectTree
use Libraries.Interface.Selections.TabPaneSelection
use Libraries.Development.Environment.Studio.CodeEditorTabPane
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Interface.Controls.Tab
use Libraries.Interface.Item2D
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Controls.Scenes.Items.EditorItem
use Libraries.Interface.Controls.Scenes.Dialogs.PropertiesDialog
use Libraries.Interface.Controls.Button

class EditorBehavior is QuorumStudioBehavior
    action Run (BehaviorEvent event)
        Item item = event:GetItem()

        QuorumStudio studio = GetMainApplication()
        CodeEditorTabPane editors = studio:GetTabPane()
        Item2D related = editors:GetCurrentItem()

        if item is Button and related not= undefined
            Run(related)
            return now
        end

        if item is MenuItem
            Item currentFocus = studio:GetCurrentFocus()
            if currentFocus = undefined
                return now
            end
            Run(currentFocus)
        else 
            Run(item)
        end        
    end

    blueprint action Run(Item item)

    /*
        Returns the scene editor an item belongs to: the editor itself, a
        scene item or selection highlight in it, or a control in its
        Properties panel. Otherwise, undefined. Undo and Redo use it, so they
        reach the scene wherever the focus is in its tab.

        Attribute: Parameter item The focused item
        Attribute: Returns The scene editor, or undefined
    */
    action FindSceneEditor(Item item) returns SceneEditor
        if item is SceneEditor
            return cast(SceneEditor, item)
        elseif item is EditorItem
            EditorItem sceneItem = cast(EditorItem, item)
            return sceneItem:GetSceneEditor()
        elseif item is Item2D
            Item2D current = cast(Item2D, item)
            repeat while current not= undefined
                if current is PropertiesDialog
                    PropertiesDialog dialog = cast(PropertiesDialog, current)
                    return dialog:GetSceneEditor()
                end
                current = current:GetParent()
            end
        end
        return undefined
    end
end