package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Interface.Controls.TextBox
use Libraries.Interface.Controls.Blocks.CodeEditor
use Libraries.Interface.Controls.ListItem
use Libraries.Interface.Controls.Tab
use Libraries.Development.Environment.Studio.CodeEditorTabPane
use Libraries.Development.Environment.Studio.Interface.EditorTab
use Libraries.Development.Environment.Studio.Interface.CallStackItem
use Libraries.System.File

/*
Goes to a Call Stack frame's line (C1): the row it's run on (Return or a
double click), or, from the tab's menu, the selected row. A frame in
Java code has no file, so nothing happens.
*/
class JumpToCallStackBehavior is QuorumStudioBehavior

    action Run(BehaviorEvent event)
        CallStackItem row = undefined
        if event:GetItem() is CallStackItem
            row = cast(CallStackItem, event:GetItem())
        else
            QuorumStudio mainStudio = GetMainApplication()
            ListItem selected = mainStudio:GetOutputPane():GetCallStackTab():GetSelectedRow()
            if selected is CallStackItem
                row = cast(CallStackItem, selected)
            end
        end
        if row = undefined
            return now
        end

        check
            File file = row:GetFile()
            if file = undefined
                return now
            end
            integer line = row:GetFrame():GetLine()

            QuorumStudio studio = GetMainApplication()
            CodeEditorTabPane editors = studio:GetTabPane()
            Tab tab1 = editors:OpenNewTab(file)
            if not (tab1 is EditorTab)
                return now
            end
            EditorTab tab = cast(EditorTab, tab1)
            if line < 1
                return now
            end

            // A tab holds a text box in text mode, and the block editor in
            // block mode; each moves to the line its own way.
            TextBox box = tab:GetTextBox()
            CodeEditor blocks = tab:GetBlockEditor()
            if box not= undefined
                box:SetCaretPositionToLine(line - 1)
                box:GoToLine(line - 1)
            elseif blocks not= undefined
                blocks:SelectBlockAtTextLine(line - 1)
                blocks:GoToLine(line - 1)
            end
        detect e
            e:OutputStackTrace()
        end
    end
end
