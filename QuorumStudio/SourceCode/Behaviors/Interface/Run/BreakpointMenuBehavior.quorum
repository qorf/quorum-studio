package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.ListItem
use Libraries.Interface.Controls.PopupMenu
use Libraries.Development.Environment.Studio.Interface.BreakpointsTab

/*
Opens the Breakpoints tab's menu at the selected row, for Shift+F10. A right
click opens it through the row's own input group instead.
*/
class BreakpointMenuBehavior is Behavior
    BreakpointsTab breakpointsTab = undefined

    action SetBreakpointsTab(BreakpointsTab tab)
        breakpointsTab = tab
    end

    action Run(BehaviorEvent event)
        if breakpointsTab = undefined
            return now
        end

        ListItem row = breakpointsTab:GetSelectedRow()
        if row = undefined
            return now
        end
        PopupMenu menu = row:GetPopupMenu()
        if menu not= undefined
            menu:OpenAt(row:GetGlobalX(), row:GetGlobalY())
        end
    end
end
