package Libraries.Development.Environment.Studio.Behaviors

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.ListItem
use Libraries.Interface.Controls.PopupMenu
use Libraries.Development.Environment.Studio.Interface.CallStackTab

/*
Opens the Call Stack tab's menu at the selected row, for Shift+F10. A
right click opens it through the row's own input group instead.
*/
class CallStackMenuBehavior is Behavior
    CallStackTab callStackTab = undefined

    action SetCallStackTab(CallStackTab tab)
        callStackTab = tab
    end

    action Run(BehaviorEvent event)
        if callStackTab = undefined
            return now
        end

        ListItem row = callStackTab:GetSelectedRow()
        if row = undefined
            return now
        end
        PopupMenu menu = row:GetPopupMenu()
        if menu not= undefined
            menu:OpenAt(row:GetGlobalX(), row:GetGlobalY())
        end
    end
end
