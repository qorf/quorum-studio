package Libraries.Development.Versioning

/*
One commit, as the Team tab lists it (Push P9): its id, the first line of
its message, who made it and when. Git.java fills the fields.
*/
class CommitSummary
    text id = ""
    text shortId = ""
    text message = ""
    text author = ""
    // "10:51" for today, or a date.
    text time = ""

    action GetId returns text
        return id
    end

    action GetShortId returns text
        return shortId
    end

    action GetMessage returns text
        return message
    end

    action GetAuthor returns text
        return author
    end

    action GetTime returns text
        return time
    end
end
