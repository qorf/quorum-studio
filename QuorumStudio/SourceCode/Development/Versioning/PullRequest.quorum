package Libraries.Development.Versioning
use Libraries.Development.Environment.Projects.Credentials

/*
What to pull with: the saved username and password, if there are any
(CredentialsRequest), and the monitor that shows the pull's progress in
the Team tab (Pull L2).
*/
class PullRequest is CredentialsRequest
    VersionProgressMonitor monitor = undefined

    action GetProgressMonitor returns VersionProgressMonitor
        return monitor
    end

    action SetProgressMonitor(VersionProgressMonitor monitor)
        me:monitor = monitor
    end
end
