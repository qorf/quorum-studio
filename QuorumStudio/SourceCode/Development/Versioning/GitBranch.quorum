package Libraries.Development.Versioning

/*
One branch for Switch Branch (B1): on this computer, or on the server only.
Git.java fills the fields.
*/
class GitBranch
    // "main", or "origin/menu-music" for a server branch.
    text branchName = ""
    // The name it has (or will have) on this computer: "menu-music".
    text localName = ""
    // "refs/heads/main" or "refs/remotes/origin/menu-music".
    text fullName = ""
    boolean isLocal = false
    boolean isCurrent = false
    // The server branch it pulls from and pushes to, "origin/main", or "".
    text upstream = ""
    text lastMessage = ""
    // "2 days ago", "today".
    text lastAge = ""

    action GetBranchName returns text
        return branchName
    end

    action GetLocalName returns text
        return localName
    end

    action GetFullName returns text
        return fullName
    end

    action IsLocal returns boolean
        return isLocal
    end

    action IsCurrent returns boolean
        return isCurrent
    end

    action GetUpstream returns text
        return upstream
    end

    action GetLastMessage returns text
        return lastMessage
    end

    action GetLastAge returns text
        return lastAge
    end
end
