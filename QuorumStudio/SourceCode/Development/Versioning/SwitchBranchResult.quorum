package Libraries.Development.Versioning

use Libraries.Containers.Array

// What Git:SwitchBranch did. Git.java fills the fields.
class SwitchBranchResult
    text branchName = ""
    boolean successful = false
    text message = ""
    // Repository paths git wouldn't overwrite (B3).
    Array<text> conflictingFiles

    action GetBranchName returns text
        return branchName
    end

    action IsSuccessful returns boolean
        return successful
    end

    action GetMessage returns text
        return message
    end

    action GetConflictingFiles returns Array<text>
        return conflictingFiles
    end
end
