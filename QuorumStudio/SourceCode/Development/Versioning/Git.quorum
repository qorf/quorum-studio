package Libraries.Development.Versioning
use Libraries.System.File

class Git
    system action Clone(CloneRequest request) returns CloneResult
    system action Add(Repository repo, AddRequest request) returns AddResult
    system action Unstage(Repository repo, UnstageRequest request) returns UnstageResult
    system action Reset(Repository repo, text path) returns ResetResult
    system action Delete(Repository repo, DeleteRequest request) returns DeleteResult
    system action Commit(Repository repo, CommitRequest request) returns CommitResult
    system action Push(Repository repo, PushRequest request) returns PushResult
    system action Pull(Repository repo, PullRequest request) returns PullResult
    system action RequestDiff(Repository repository, DiffRequest request) returns DiffResult
    system action GetStatus(Repository repo) returns StatusResult
    system action ListBranches(Repository repo) returns BranchListResult
    system action SwitchBranch(Repository repo, SwitchBranchRequest request) returns SwitchBranchResult
    system action IsValidBranchName(text value) returns boolean
    system action OpenRepository(File file) returns Repository
    system action FindRepository(File file) returns Repository

    // Ignoring a file or folder in the .gitignore at the top of the
    // repository (the Project Tree's Git menu). GetIgnoreLine gives the line
    // Ignore adds, such as "/Games/Pong/Build/", or "" outside the
    // repository. IsTracked says whether git tracks it, or anything in it;
    // Ignore's stopTracking also takes it out of git, keeping it on disk.
    system action GetIgnoreLine(Repository repo, File file) returns text
    system action IsIgnored(Repository repo, File file) returns boolean
    system action IsTracked(Repository repo, File file) returns boolean
    system action Ignore(Repository repo, File file, boolean stopTracking) returns IgnoreResult

    // Stash puts every change in the repository aside (JGit 5.6.1 can't
    // stash only some paths). RestoreStash puts a stash back and deletes it,
    // or keeps it when the changes collide; "" means the newest stash.
    system action Stash(Repository repo, text message) returns StashResult
    system action RestoreStash(Repository repo, text stashId) returns StashResult
    system action CountStashes(Repository repo) returns integer
end