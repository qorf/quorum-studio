package Libraries.Development.Versioning

// Whether Git:Ignore worked, the line it added to .gitignore, and JGit's
// message when it didn't.
class IgnoreResult
    boolean successful = false
    text message = ""
    text line = ""

    action IsSuccessful returns boolean
        return successful
    end

    action GetMessage returns text
        return message
    end

    action GetLine returns text
        return line
    end
end
