package Libraries.Development.Versioning

/*
What Git:Stash or Git:RestoreStash did. Successful means the changes were
stashed, or put back and the stash deleted. NothingToStash means there
were no changes to stash, or no stash to restore. Kept means a restore's
changes collided with changes made since, so the stash was kept.
*/
class StashResult
    boolean successful = false
    boolean nothingToStash = false
    boolean kept = false
    text message = ""
    // The stash's id, so Stash and Pull restores the stash it made.
    text stashId = ""

    action IsSuccessful returns boolean
        return successful
    end

    action IsNothingToStash returns boolean
        return nothingToStash
    end

    action IsKept returns boolean
        return kept
    end

    action GetMessage returns text
        return message
    end

    action GetStashId returns text
        return stashId
    end
end
