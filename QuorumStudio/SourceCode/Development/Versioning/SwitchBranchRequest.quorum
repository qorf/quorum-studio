package Libraries.Development.Versioning

/*
What Git:SwitchBranch should do:
- switch to a branch on this computer: the name only;
- switch to a server-only branch: creating, start point "origin/scores",
  tracking;
- New Branch: creating, start point "refs/heads/main", and switching or not.
*/
class SwitchBranchRequest
    text branchName = ""
    text startPoint = ""
    boolean creating = false
    boolean switching = true
    boolean tracking = false
    // From New Branch (B4), for the sentence after.
    boolean fromNewBranch = false

    action GetBranchName returns text
        return branchName
    end

    action SetBranchName(text value)
        branchName = value
    end

    action GetStartPoint returns text
        return startPoint
    end

    action SetStartPoint(text value)
        startPoint = value
    end

    action IsCreating returns boolean
        return creating
    end

    action SetCreating(boolean value)
        creating = value
    end

    action IsSwitching returns boolean
        return switching
    end

    action SetSwitching(boolean value)
        switching = value
    end

    action IsTracking returns boolean
        return tracking
    end

    action SetTracking(boolean value)
        tracking = value
    end

    action IsFromNewBranch returns boolean
        return fromNewBranch
    end

    action SetFromNewBranch(boolean value)
        fromNewBranch = value
    end
end
