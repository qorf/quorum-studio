package Libraries.Concurrency
use Libraries.Interface.Behaviors.Behavior

/*
    This class Runs Threads.
*/
class ThreadRunner 
    system action Add(Behavior behavior)

    system action Empty()

    /*
    This action says whether a job is waiting or running. A cancelled job,
    or one that ended with an error, counts as done.

    Attribute: Returns True while the runner has work.
    */
    system action IsBusy returns boolean
    system action ShutDown
end