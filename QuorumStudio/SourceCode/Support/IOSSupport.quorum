package Libraries.Development.Environment.Studio.Mobile

use Libraries.System.Properties
use Libraries.System.File
use Libraries.Containers.List
use Libraries.Containers.Array
use Libraries.System.ProcessListener
use Libraries.System.Process
use Libraries.System.ProcessEvent
use Libraries.Development.Environment.Studio.Build.MobileListener
use Libraries.Language.Compile.Symbol.Class
use Libraries.Development.Environment.Studio.Build.BuildInformation
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.System.DateTime

class IOSSupport is ProcessListener
    text FILE_SEPARATOR = "/"
    constant text PATH_TO_MAIN = FILE_SEPARATOR + "ios" + FILE_SEPARATOR + "src" + FILE_SEPARATOR + "main" + FILE_SEPARATOR
    constant text PATH_TO_APP_BUILD_GRADLE = FILE_SEPARATOR + "ios" + FILE_SEPARATOR  + "build.gradle"
    constant text PATH_TO_APP_BUILD_ROBOVM_PROPERTIES = 
        FILE_SEPARATOR + "ios" + FILE_SEPARATOR  + "robovm.properties"
    constant text PATH_TO_IOS_PLIST = 
        FILE_SEPARATOR + "ios" + FILE_SEPARATOR  + "info.plist.xml"
    constant text PATH_TO_APP_BUILD_ROBOVM_XML = 
        FILE_SEPARATOR + "ios" + FILE_SEPARATOR  + "robovm.xml"
    constant text PATH_TO_MAIN_XML = PATH_TO_MAIN + "AndroidManifest.xml"
    /*
        RoboVM and Gradle run in Run/Mobile/ios, so the project's Run folder is two
        folders up. The jars and the natives (jni/ios.a, jni/iosSimulator.a) are
        used from there rather than copied: a copy gets a new date, and RoboVM then
        recompiles every class in it.
    */
    constant text RUN_FOLDER_FROM_IOS = "../.."
    constant text FOLDER_NAME = "Mobile"
    text pathToRunFolder = ""
    text pathToBuildFolder = ""
    text log = ""
    Array<MobileListener> listeners
    text java = ""    
    AppleDevice device = undefined
    text deviceMessage = ""
    integer lastExit = -1
    boolean simulatorAppMissing = false
    boolean simulatorBootFailed = false
    boolean phoneLocked = false
    // The send's checklist (SendProgressPanel), and whether the app has
    // started, after which its own lines go to the Console.
    SendProgress progress = undefined
    boolean appStarted = false

    

    action AddListener(MobileListener listener)
        listeners:Add(listener)
    end

    action SetProgress(SendProgress value)
        progress = value
        appStarted = false
    end

    /*
        Moves the checklist along on MobiVM's messages (Gradle's --info), and
        ends it when the app prints its first line or the build fails.
    */
    private action TrackProgress(text message)
        if progress = undefined or message = undefined
            return now
        end
        if message:StartsWith("> Task :ios:launch")
            progress:StartStep(progress:COMPILE_IOS)
        elseif message:Contains("No classes were modified") or message:Contains("Building ios binary") or message:Contains("Building fat binary")
            progress:StartStep(progress:LINK)
        elseif message:Contains("Deploying app")
            progress:StartStep(progress:INSTALL)
        elseif message:Contains("Launching app")
            progress:StartStep(progress:START_APP)
        elseif message:Contains("could not be, unlocked")
            progress:StartStep(progress:START_APP)
            progress:SetWaitingForUnlock(true)
        elseif message:StartsWith("IOSApplication:")
            appStarted = true
            progress:Finish(true)
        elseif message:Contains("BUILD FAILED")
            progress:Finish(false)
        end
    end

    /*
        Whether a line is the build's own, hidden unless asked for: every
        line before the app starts, except ones that look like a problem, and
        after it starts, MoltenVK's start-up lines.
    */
    private action IsBuildDetail(text message) returns boolean
        if progress = undefined or message = undefined
            return false
        end
        if not appStarted
            return not LooksLikeProblem(message)
        end
        return message:StartsWith("[mvk-info]") or message:StartsWith(message:GetTab())
    end

    private action LooksLikeProblem(text message) returns boolean
        // Lines that only name something with "Error" in it, such as a class
        // being compiled, a phantom class warning, or Gradle's daemon
        // settings (HeapDumpOnOutOfMemoryError), aren't problems.
        if message:StartsWith("Compiling ") or message:StartsWith("Warning: ")
                or message:Contains("DaemonInfo") or message:Contains("DaemonContext")
            return false
        end
        return message:Contains("error") or message:Contains("Error") or message:Contains("FAILURE")
            or message:Contains("What went wrong") or message:Contains("Exception")
            or message:Contains("BUILD FAILED") or message:Contains("failed")
    end

    private action SendDetailToListeners(text message)
        integer i = 0
        repeat while i < listeners:GetSize()
            listeners:Get(i):Detail(message)
            i = i + 1
        end
    end

    action ProcessStarted(ProcessEvent event)
    end

    action ProcessStopped(ProcessEvent event)
        lastExit = event:GetExit()
        File file
        file:SetAbsolutePath(GetLogLocation())

        if file:Exists()
            file:Delete()
        end
        file:Write(log)
        log = ""
    end

    action GetLogLocation returns text
        return pathToBuildFolder + FILE_SEPARATOR + "log.txt"
    end

    action Error(ProcessEvent event)
        text current = event:GetOutput()
        log = log + current + current:GetLineFeed()
        CheckForMissingSimulatorApp(current)
        CheckForLockedPhone(current)
        TrackProgress(current)
        if IsBuildDetail(current)
            SendDetailToListeners(current)
            return now
        end
        i = 0
        repeat while i < listeners:GetSize()
            MobileListener listener = listeners:Get(i)
            listener:Error(current)
            i = i + 1
        end
    end

    action Output(ProcessEvent event)
        text current = event:GetOutput()
        log = log + current + current:GetLineFeed()
        CheckForMissingSimulatorApp(current)
        CheckForLockedPhone(current)
        TrackProgress(current)
        if IsBuildDetail(current)
            SendDetailToListeners(current)
        else
            SendMessageToListeners(current)
        end
    end

    /*
        Xcode 27 replaced the Simulator app with DeviceHub, and MobiVM 2.3.20 only
        knows how to open the Simulator app (open -a Simulator). When that fails,
        RoboVM has already built and signed the app, but stops before installing
        it, so Studio installs and launches it instead (InstallOnSimulator).
        The same happens when RoboVM's own boot of the simulator fails, which it
        does after building and signing the app.
    */
    private action CheckForMissingSimulatorApp(text message)
        if message = undefined
            return now
        end

        if message:Contains("Unable to find application named 'Simulator'")
            simulatorAppMissing = true
        elseif message:Contains("Unable to boot the Simulator")
            simulatorBootFailed = true
        end
    end

    /*
        True when RoboVM built the app but couldn't start it on the simulator:
        the Simulator app is missing (Xcode 27 and later), or RoboVM's boot failed.
        Studio then installs and launches the app itself (InstallOnSimulator).
    */
    action NeedsStudioLaunch returns boolean
        return simulatorAppMissing or simulatorBootFailed
    end

    /*
        MobiVM installs the app on a phone, then launches it. iOS won't start an
        app on a locked phone, so when MobiVM says the phone "could not be
        unlocked", the app is installed and only the launch is missing.
        BuildManager then waits for an unlock (WaitForUnlockAndLaunch).
    */
    private action CheckForLockedPhone(text message)
        if message not= undefined and message:Contains("could not be, unlocked")
            phoneLocked = true
        end
    end

    /* True when the app was installed on a phone but couldn't start because the phone was locked. */
    action WasPhoneLocked returns boolean
        return phoneLocked
    end

    /*
        Asks the chosen phone whether it is locked, with xcrun devicectl device
        info lockState. Its JSON has "passcodeRequired" : true while the phone is
        locked. Returns false when there's no phone or the question fails, so a
        failed check never holds up a send.
    */
    action IsPhoneLocked returns boolean
        if device = undefined
            return false
        end

        Array<text> params
        params:Add("devicectl")
        params:Add("device")
        params:Add("info")
        params:Add("lockState")
        params:Add("-d")
        params:Add(device:GetSignature())
        params:Add("-q")
        params:Add("-j")
        params:Add("-")
        AppleDevicesReader reader
        AppleCommandOutput result = reader:RunCommand("xcrun", params)
        if result:GetExit() not= 0
            return false
        end

        text json = result:GetOutput():Replace(" ", "")
        text dq = json:GetDoubleQuote()
        return json:Contains(dq + "passcodeRequired" + dq + ":true")
    end

    /*
        Starts the installed app on the chosen phone with xcrun devicectl, the same
        way MobiVM does. The process lasts until the app quits, and passes on what
        the app prints. BuildManager only calls this when a phone was chosen.
    */
    action GetDeviceLaunchProcess(QuorumProject project) returns Process
        Process process
        Array<text> params
        params:Add("devicectl")
        params:Add("device")
        params:Add("process")
        params:Add("launch")
        params:Add("--device")
        params:Add(device:GetSignature())
        params:Add("--console")
        params:Add("--terminate-existing")
        params:Add(project:GetIOSBundle())
        process:SetName("xcrun")
        process:SetParameters(params)
        return process
    end

    private action SendMessageToListeners(text message)
        i = 0
        repeat while i < listeners:GetSize()
            MobileListener listener = listeners:Get(i)
            
            if message:Contains("Starting Build")
                listener:StartingBuild()
            elseif message:Contains("Building RoboVM app") //version
                listener:BuildingArchitecture(message)
            elseif message:Contains("Compiling classes using")
                listener:BuildingPlatform(message)
            elseif message:Contains("Building ios binary")
                listener:Linking(message)
            elseif message:Contains("Compile RoboVM app completed")
                listener:FinishedBuild(true, message)
            elseif message:Contains("Booting simulator")
                listener:BootingSimulator(message)
            else
                listener:Error(message)
            end
            i = i + 1
        end
    end

    action Setup(QuorumProject project, text pathToRunFolder, text jarName)
        me:pathToRunFolder = pathToRunFolder
        me:pathToBuildFolder = pathToRunFolder + FILE_SEPARATOR + FOLDER_NAME
    end

    

    action CopyAndRename(text templateLocation, text pathToRunFolder, text applicationName)
        CopyFolder(templateLocation, pathToBuildFolder)
    end

    /*
        Brings the Gradle settings of a Mobile folder made by an older Studio up to
        date with the template: build.gradle (without the Android plugin),
        gradle.properties (Gradle's daemon on), the Gradle version (the wrapper's
        properties) and the daemon's Java (gradle-daemon-jvm.properties). Writes
        only when they differ. The older wrapper scripts and jar left in the
        folder still download and start the Gradle version named here.
    */
    action UpdateGradleSettings(text templateLocation)
        Array<text> names
        names:Add("build.gradle")
        names:Add("gradle.properties")
        names:Add("gradle" + FILE_SEPARATOR + "wrapper" + FILE_SEPARATOR + "gradle-wrapper.properties")
        names:Add("gradle" + FILE_SEPARATOR + "gradle-daemon-jvm.properties")
        i = 0
        repeat while i < names:GetSize()
            File from
            File to
            from:SetAbsolutePath(templateLocation + FILE_SEPARATOR + names:Get(i))
            to:SetAbsolutePath(pathToBuildFolder + FILE_SEPARATOR + names:Get(i))
            if from:Exists()
                text value = from:Read()
                if not to:Exists() or to:Read() not= value
                    to:Write(value)
                end
            end
            i = i + 1
        end
    end

    /*
        Picks the device to send to, and remembers it for BuildForSimulator.

        For a simulator, in order: the project's saved device, the same model on
        the newest iOS (for names saved by older versions of Studio), a simulator
        that is already running, the newest iPhone on the newest iOS, then any
        simulator. If the saved device wasn't used, the project saves the new one.

        For a physical device, only the saved one, and it must be connected.

        Returns true when a device was found. GetDeviceMessage then says which
        device was used if it changed, or why none was found.
    */
    action ChooseDevice(QuorumProject project) returns boolean
        device = undefined
        deviceMessage = ""
        text saved = project:GetIOSDevice()
        if saved = undefined
            saved = ""
        end
        boolean physical = project:IsIOSPhysicalDevice()

        AppleDevicesReader reader
        Array<AppleDevice> devices = reader:GetAvailableDevices()
        AppleDevice sameModel = undefined
        AppleDevice booted = undefined
        AppleDevice newest = undefined
        AppleDevice first = undefined
        i = 0
        repeat while i < devices:GetSize()
            AppleDevice candidate = devices:Get(i)
            text name = candidate:GetName()
            text actual = candidate:GetActualDeviceName()
            if physical and candidate:IsDevice()
                if name = saved
                    device = candidate
                end
            elseif not physical and candidate:IsSimulator()
                if name = saved
                    device = candidate
                elseif sameModel = undefined and (actual = saved or actual + " Simulator" = saved)
                    sameModel = candidate
                end

                if booted = undefined and candidate:IsBooted()
                    booted = candidate
                end

                if newest = undefined and actual:StartsWith("iPhone")
                    newest = candidate
                end

                if first = undefined
                    first = candidate
                end
            end
            i = i + 1
        end

        if physical
            if device = undefined
                if saved:IsEmpty()
                    deviceMessage = "No iOS device is chosen. Connect your iPhone or iPad, unlock it, and choose it in Project Properties, iOS."
                else
                    deviceMessage = saved + " isn't connected. Connect it and unlock it, then send to iOS again. Or choose another device in Project Properties, iOS."
                end
                return false
            end
            return true
        end

        if device = undefined
            device = sameModel
        end
        if device = undefined
            device = booted
        end
        if device = undefined
            device = newest
        end
        if device = undefined
            device = first
        end

        if device = undefined
            deviceMessage = "No iOS simulators were found. Open Xcode, then Window, Devices and Simulators, and add one. Then send to iOS again."
            return false
        end

        if device:GetName() not= saved
            if saved:IsEmpty()
                deviceMessage = "Using the " + device:GetName() + " simulator. You can choose another in Project Properties, iOS."
            else
                deviceMessage = saved + " isn't installed, so the " + device:GetName() + " simulator is used instead."
            end
            project:SetIOSDevice(device:GetName())
            check
                project:Save()
            detect e
                //The choice is still used for this build.
            end
        end
        return true
    end

    action GetDeviceMessage returns text
        return deviceMessage
    end

    action GetDevice returns AppleDevice
        return device
    end

    /* The exit code of the last Gradle or launch process, 0 when it worked. */
    action GetLastExit returns integer
        return lastExit
    end

    /*
        Installs the app RoboVM built on the chosen simulator, after starting the
        simulator and opening the window that shows it. Returns "" when it worked,
        or what went wrong.

        Used when RoboVM couldn't open the Simulator app; see
        CheckForMissingSimulatorApp. (RoboVM's robovm.skipLaunch can't be used
        instead: it also skips making the .app.)
    */
    action InstallOnSimulator returns text
        if device = undefined
            return "No simulator was chosen, so the app wasn't installed."
        end
        text udid = device:GetSignature()
        AppleDevicesReader reader

        text problem = reader:BootSimulator(udid)
        if not problem:IsEmpty()
            return "The " + device:GetName() + " simulator couldn't start. Send to iOS again. If it keeps happening, restart the Mac. " + problem
        end

        OpenSimulatorWindow(udid)

        File app = FindBuiltApp()
        if app = undefined
            return "RoboVM finished, but the app wasn't found in " + pathToBuildFolder + "/ios/build/robovm.tmp."
        end

        Array<text> install
        install:Add("simctl")
        install:Add("install")
        install:Add(udid)
        install:Add(app:GetAbsolutePath())
        AppleCommandOutput result = reader:RunCommand("xcrun", install)
        if result:GetExit() not= 0
            return "The app couldn't be installed on the simulator. " + result:GetErrors():Trim()
        end
        return ""
    end

    /*
        Starts the installed app on the chosen simulator. The process lasts until the
        app quits, and passes on what the app prints, like RoboVM's launch did.
    */
    action GetSimulatorLaunchProcess(QuorumProject project) returns Process
        Process process
        Array<text> params
        params:Add("simctl")
        params:Add("launch")
        params:Add("--console")
        params:Add("--terminate-running-process")
        if device not= undefined
            params:Add(device:GetSignature())
        end
        params:Add(project:GetIOSBundle())
        process:SetName("xcrun")
        process:SetParameters(params)
        return process
    end

    /* DeviceHub on Xcode 27 and later, and the Simulator app before that. */
    private action OpenSimulatorWindow(text udid)
        AppleDevicesReader reader
        Array<text> deviceHub
        deviceHub:Add("-b")
        deviceHub:Add("com.apple.dt.Devices")
        AppleCommandOutput result = reader:RunCommand("open", deviceHub)
        if result:GetExit() = 0
            return now
        end

        Array<text> simulator
        simulator:Add("-a")
        simulator:Add("Simulator")
        simulator:Add("--args")
        simulator:Add("-CurrentDeviceUDID")
        simulator:Add(udid)
        reader:RunCommand("open", simulator)
    end

    /* RoboVM builds the app into ios/build/robovm.tmp, named after the program. */
    private action FindBuiltApp returns File
        File folder
        folder:SetAbsolutePath(pathToBuildFolder + "/ios/build/robovm.tmp")
        if not folder:Exists()
            return undefined
        end

        Array<File> files = folder:GetDirectoryListing()
        i = 0
        repeat while i < files:GetSize()
            File next = files:Get(i)
            if next:IsDirectory() and next:GetPath():EndsWith(".app")
                return next
            end
            i = i + 1
        end
        return undefined
    end

    action RewriteConfig(BuildInformation info)
        text gradle = GetBuildGradle(info)
        File gradleFile
        gradleFile:SetAbsolutePath(pathToBuildFolder + PATH_TO_APP_BUILD_GRADLE)
        gradleFile:Write(gradle)

        text robovmProp = GetRoboVMProperties(info)
        File robovmPropFile
        robovmPropFile:SetAbsolutePath(pathToBuildFolder + PATH_TO_APP_BUILD_ROBOVM_PROPERTIES)
        robovmPropFile:Write(robovmProp)

        text robovmXML = GetRoboVMXML(info)
        File robovmXMLFile
        robovmXMLFile:SetAbsolutePath(pathToBuildFolder + PATH_TO_APP_BUILD_ROBOVM_XML)
        robovmXMLFile:Write(robovmXML)

        text plistXML = GetPList(info)
        File plist
        plist:SetAbsolutePath(pathToBuildFolder + PATH_TO_IOS_PLIST)
        plist:Write(plistXML)
    end

    private action SanitizeMediaFolder(text value) returns text
        text result = value
        if result not= undefined and result:GetSize() > 1 and result:GetCharacter(0) = "/"
            result = result:GetSubtext(1)
        end
        return result
    end

    /*
        The app's Info.plist. Since iOS 27, apps must use the scene life cycle or
        they won't launch (Apple's TN3187), so it names the scene delegate in the
        standard library's iOS plugin (IOSSceneDelegate, whose Objective-C name is
        QuorumSceneDelegate). GetRoboVMXML force-links that class, since iOS finds
        it only by this name. UILaunchScreen (empty) says the app handles every
        screen size; without it, iOS runs the app in a 320 by 480 compatibility
        window.
    */
    private action GetPList(BuildInformation info) returns text
        text result = ""
        QuorumProject project = info:project
        text name = project:GetExecutableName()
        text dq = result:GetDoubleQuote()
result = 
"<?xml version="+dq+"1.0"+dq+" encoding="+dq+"UTF-8"+dq+"?>
<!DOCTYPE plist PUBLIC "+dq+"-//Apple//DTD PLIST 1.0//EN"+dq+" " +dq+ "http://www.apple.com/DTDs/PropertyList-1.0.dtd"+dq+">
<plist version="+dq+"1.0"+dq+">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>"+name+"</string>
    <key>CFBundleExecutable</key>
    <string>"+name+"</string>
    <key>CFBundleIdentifier</key>
    <string>${app.id}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>${app.name}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${app.version}</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>${app.build}</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>MinimumOSVersion</key>
    <string>15.0</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>UIStatusBarHidden</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>opengles-2</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>QuorumSceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
</dict>
</plist>
"
        return result
    end

    /*
        The PNGs stay standard PNGs (skipPngCrush). For device builds MobiVM
        otherwise runs Xcode's pngcrush -iphone on them, which swaps their
        blue and red for Apple's own decoder, and Quorum decodes images itself.
    */
    private action GetRoboVMXML(BuildInformation info) returns text
        QuorumProject project = info:project
        boolean physical = project:IsIOSPhysicalDevice() 
        text name = project:GetExecutableName()
        text media = SanitizeMediaFolder(project:GetIOSAssetsPath())

        
        text result = 
"
<config>
  <mainJar>"+RUN_FOLDER_FROM_IOS+"/"+name+".jar</mainJar>
  <os>ios</os>
  <target>ios</target>
  <resources>
    <resource>
      <directory>"+media+"</directory>
      <targetPath>"+media+"</targetPath>
      <skipPngCrush>true</skipPngCrush>
    </resource>
  </resources>
  <classpath>
    <classpathentry>"+RUN_FOLDER_FROM_IOS+"/"+name+".jar</classpathentry>
    <classpathentry>"+RUN_FOLDER_FROM_IOS+"/QuorumStandardLibrary.jar</classpathentry>
    <classpathentry>"+RUN_FOLDER_FROM_IOS+"/QuorumStandardPlugins.jar</classpathentry>
  </classpath>
  <libs>
    <lib>"+RUN_FOLDER_FROM_IOS+"/jni"
    
    if not physical
        result = result + "/iosSimulator.a"
    else
        result = result + "/ios.a"
    end
    result = result + "</lib>
  </libs>
  <weakFrameworks>
    <framework>OpenGLES</framework>
    <framework>UIKit</framework>
    <framework>QuartzCore</framework>
    <framework>CoreGraphics</framework>
    <framework>OpenAL</framework>
    <framework>AudioToolbox</framework>
    <framework>AVFoundation</framework>
    <framework>Metal</framework>
    <framework>IOSurface</framework>
  </weakFrameworks>
  <iosInfoPList>Info.plist.xml</iosInfoPList>
  <forceLinkClasses>
    <pattern>plugins.quorum.Libraries.Game.IOSSceneDelegate</pattern>
  </forceLinkClasses>
</config>
"
        return result
    end

    private action GetRoboVMProperties(BuildInformation info) returns text
        QuorumProject project = info:project
        text name = project:GetExecutableName()
        text bundle = project:GetIOSBundle()
        text version = project:GetProjectVersion()
//this app.id might need change
text result = 
"
app.version="+version+"
app.id="+bundle+"
app.build=1
app.name="+name+"

"
        return result
    end

    private action GetBuildGradle(BuildInformation info) returns text
        QuorumProject project = info:project
        text name = project:GetExecutableName()
        text provision = project:GetIOSProvisioning()
        text signature = project:GetIOSSignature()
        text dq = name:GetDoubleQuote()

        // No Java toolchain: the ios module has no Java sources, and a
        // toolchain of 8 would need a Java 8 Gradle can find. MobiVM 2.3.26
        // removed stdoutFifo and stderrFifo, and Gradle stops on unknown
        // settings, so they aren't written.
        text result =
"
robovm {"

if provision not= undefined and signature not= undefined
    and not provision:IsEmpty() and not signature:IsEmpty()
    result = result +"
        iosSignIdentity = " + dq + signature + dq + "
        iosProvisioningProfile = " + dq + provision + dq + "
        iosSkipSigning = false
}"
else
    result = result + "
    }"
end
result = result + "

dependencies {
    implementation files('" + RUN_FOLDER_FROM_IOS + "/" + name + ".jar')
    implementation files('" + RUN_FOLDER_FROM_IOS + "/QuorumStandardLibrary.jar')
    implementation files('" + RUN_FOLDER_FROM_IOS + "/QuorumStandardPlugins.jar')
}
"
        return result
    end
    action GetAvailableDevices returns Array<AppleDevice>
        AppleDevicesReader reader
        return reader:GetAvailableDevices()
    end

    action HasMobileFolder returns boolean
        File native
        native:SetAbsolutePath(pathToBuildFolder)
        if native:Exists()
            return true
        else
            return false
        end  
    end

    action GetBuildForSimulatorProcess(QuorumProject project) returns Process
        Properties properties
        Process process
        File directory
        directory:SetAbsolutePath(pathToBuildFolder)
        process:SetDirectory(directory)
        //This likely needs to change because it isn't going to work on Windows
        //given limitations on Mac
        if properties:IsMac()
            File file
            file:SetAbsolutePath(pathToBuildFolder + "/gradlew")
            if file:Exists()
                file:SetExecutable(true)
            end
            process:SetName("./gradlew")
            Array<text> params = BuildForSimulator(project)
            process:SetParameters(params)
        end

        return process
    end

    action BuildForSimulator(QuorumProject project) returns Array<text>
        text value = ""
        text dq = value:GetDoubleQuote()

        boolean physical = project:IsIOSPhysicalDevice()
        Array<text> params
        params:Add("-p")  
        params:Add(pathToBuildFolder)
//        output "Path: " + pathToBuildFolder
//        output "JDK: " + java
        params:Add("-Dorg.gradle.java.home=" + java)
        if physical
            params:Add("ios:launchIOSDevice")
        else
            params:Add("ios:launchIPhoneSimulator")
        end

        //The device comes from ChooseDevice. RoboVM finds a simulator by name and
        //iOS version, and a connected device by its ID.
        if device not= undefined
            if physical
                params:Add("-Probovm.device.udid=" + device:GetSignature())
            else
                params:Add("-Probovm.device.name=" + device:GetActualDeviceName())
                params:Add("-Probovm.sdk.version=" + device:GetVersion())
            end
        end
        // MobiVM's step messages, for the checklist (SendProgress). The
        // extra lines go to the details, not the Console.
        params:Add("--info")
        //params:Add("--stacktrace")
        //params:Add("--scan")
        //params:Add("--debug")
        return params
    end

    action CopyAssets(File mediaFolder, text value)
        if not mediaFolder:Exists() or value = undefined
            return now
        end //bail if it isn't there

        File assetsFolder
        text pathtemp = pathToBuildFolder + FILE_SEPARATOR + "ios" + FILE_SEPARATOR + value
        assetsFolder:SetAbsolutePath(pathtemp)
        if not assetsFolder:Exists()
            assetsFolder:CreateDirectories()
        end

        CopyChanged(mediaFolder, assetsFolder)
    end

    /*
        Copies the files in one folder to another, and its folders inside it, but
        only the files that are missing or newer than the copy. Files deleted from
        the project stay in the copy until Clean and Build.
    */
    private action CopyChanged(File from, File to)
        if not to:Exists()
            to:CreateDirectories()
        end

        Array<File> files = from:GetDirectoryListing()
        i = 0
        repeat while i < files:GetSize()
            File next = files:Get(i)
            if not next:IsHidden()
                File copyTo
                copyTo:SetWorkingDirectory(to:GetAbsolutePath() + FILE_SEPARATOR)
                copyTo:SetPath(next:GetPath())
                if next:IsDirectory()
                    CopyChanged(next, copyTo)
                elseif not copyTo:Exists()
                    next:Copy(copyTo)
                else
                    DateTime fileTime = next:GetLastModifiedDate()
                    DateTime copyTime = copyTo:GetLastModifiedDate()
                    if fileTime:GetEpochTime() > copyTime:GetEpochTime()
                        next:Copy(copyTo)
                    end
                end
            end
            i = i + 1
        end
    end

    action ReplaceLineTextInFile(text filePath, text toReplace, text newString)
        File file
        file:SetAbsolutePath(filePath)
        text value = file:Read()
        Array<text> lines = value:SplitIntoLines()

        text finalValue = ""
        i = 0
        repeat while i < lines:GetSize()
            text line = lines:Get(i)
            if line:Contains(toReplace)
                lines:Set(i, newString)
            end

            finalValue = finalValue + lines:Get(i) + finalValue:GetLineFeed()
            i = i + 1
        end
        file:Write(finalValue)
    end

    //This isn't clean, but we need to get it working before refactoring and cleaning up.
    private action CopyFolder(text from, text to)
        File toFile
        File fromFile

        toFile:SetAbsolutePath(to)
        fromFile:SetAbsolutePath(from)

        if toFile:Exists()
            toFile:Delete(true)
        end

        fromFile:Copy(toFile, true)
    end
    
    action GetJava returns text
        return java
    end

    action SetJava(text java)
        me:java = java
    end

end