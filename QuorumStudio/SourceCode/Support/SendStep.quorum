package Libraries.Development.Environment.Studio.Mobile

/*
    One step of sending an app to a device (SendProgress): its name, the
    key its time is saved under, how long it took the last time, and when
    it started and finished this time.
*/
class SendStep
    public constant integer WAITING = 0
    public constant integer RUNNING = 1
    public constant integer DONE = 2
    public constant integer FAILED = 3

    public text name = ""
    public text key = ""
    // How long it took the last time, in seconds, or a typical time.
    public number estimate = 0
    public integer state = WAITING
    // In seconds since the epoch.
    public number startTime = 0
    public number endTime = 0
end
