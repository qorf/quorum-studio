package Libraries.Development.Environment.Studio.Mobile
use Libraries.Containers.Array

/*
    One iOS simulator or connected iOS device. The name is what Studio shows
    and saves in the project, for example "iPhone 18 Pro (iOS 27.0)". The actual
    device name is the bare name RoboVM matches, for example "iPhone 18 Pro".
    The signature is the device's ID (its UDID).
*/
class AppleDevice
    text name = ""
    text signature = ""
    text version = ""
    text total = ""
    text actualDeviceName = ""
    boolean parsed = false
    boolean isDevice = false
    boolean isSimulator = false
    boolean booted = false

    action GetName returns text
        return name
    end

    action GetVersion returns text
        return version
    end

    action GetSignature returns text
        return signature
    end

    action GetTotal returns text
        return total
    end

    /* Fills in a simulator from xcrun simctl list devices available --json. */
    action SetSimulator(text deviceName, text udid, text iosVersion, boolean isBooted)
        actualDeviceName = deviceName
        signature = udid
        version = iosVersion
        booted = isBooted
        name = deviceName + " (iOS " + iosVersion + ")"
        total = name
        isSimulator = true
        isDevice = false
        parsed = true
    end

    /*
        Reads a line from the Devices section of xcrun xctrace list devices, for
        example "Andreas's iPhone (18.0) (00008030-001A2B3C4D5E6F70)". Lines without
        an iOS version, like the Mac itself, are left unparsed.
    */
    action ParseDevice(text line)
        isDevice = true
        if line = undefined or line:IsEmpty()
            return now
        end
        total = line

        integer idStart = LastIndexOf(line, "(")
        if idStart <= 0
            return now
        end

        text beforeID = line:GetSubtext(0, idStart):Trim()
        integer versionStart = LastIndexOf(beforeID, "(")
        if versionStart <= 0
            return now
        end

        actualDeviceName = beforeID:GetSubtext(0, versionStart):Trim()
        version = beforeID:GetSubtext(versionStart + 1):Replace(")", ""):Trim()
        signature = line:GetSubtext(idStart + 1):Replace(")", ""):Trim()
        name = actualDeviceName + " (iOS " + version + ", device)"
        parsed = true
    end

    private action LastIndexOf(text value, text character) returns integer
        i = value:GetSize() - 1
        repeat while i >= 0
            if value:GetCharacter(i) = character
                return i
            end
            i = i - 1
        end
        return -1
    end

    action IsParsed returns boolean
        return parsed
    end

    action IsBooted returns boolean
        return booted
    end

    action IsSimulator returns boolean
        return isSimulator
    end

    action SetIsSimulator(boolean isSimulator)
        me:isSimulator = isSimulator
    end

    action IsDevice returns boolean
        return isDevice
    end

    action SetIsDevice(boolean isDevice)
        me:isDevice = isDevice
    end
    action GetActualDeviceName returns text
        return actualDeviceName
    end

end
