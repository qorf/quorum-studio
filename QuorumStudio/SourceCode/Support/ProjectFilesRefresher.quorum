package Libraries.Development.Environment.Studio

use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Containers.HashTable
use Libraries.Containers.MultipleLineText
use Libraries.System.File
use Libraries.Game.GameStateManager
use Libraries.Interface.Controls.Tab
use Libraries.Interface.Controls.TreeItem
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Development.Environment.Projects.ProjectView
use Libraries.Development.Environment.Projects.QuorumProjectView
use Libraries.Development.Environment.Projects.ProjectTree
use Libraries.Development.Environment.Projects.ProjectTreeItem
use Libraries.Development.Environment.Studio.Interface.EditorTab
use Libraries.Development.Environment.Studio.Interface.CodeTextBox
use Libraries.Interface.Controls.Blocks.CodeEditor
use Libraries.Development.Environment.Projects.ProjectManager

/*
After git changed files on disk (a pull, a branch switch): reloads the
project's open tabs, closes tabs whose file is gone, and rebuilds the
project's item in the Project Tree. A tab with unsaved text is never
reloaded or closed. Main thread only.

A pull names the files it changed (AddChangedFile), so only their tabs are
reloaded; a branch switch names none, so every open tab in the project is
compared with its file. Either way, a tab whose file is gone is closed.

Also used by DiskChangeChecker (files changed outside Studio, 01c): with
no project (undefined), ReloadOpenTabs and RefreshProjectTree work on every
open project. Tabs in block mode are reloaded too. The tabs left alone for
their unsaved text are handed back (GetKeptTabs), so a caller can ask
about them. HasTabText, GetTabText and ReloadTab are the pieces the
checker shares.
*/
class ProjectFilesRefresher
    integer reloadedCount = 0
    Array<text> closedNames
    // Tabs left alone because they have unsaved text.
    Array<text> keptNames
    Array<EditorTab> keptTabs
    // The files git changed, with / between folders. Empty: every tab.
    Array<text> changedPaths
    // How a closed tab is explained, after the file's name (one) or the
    // number of files (more than one).
    text closedOne = "isn't on this branch, so its tab was closed."
    text closedMany = "files aren't on this branch, so their tabs were closed."

    /*
    This action does all three and returns a sentence for the result, such
    as " 2 open files were reloaded. Boss.quorum isn't on this branch, so
    its tab was closed." It starts with a space, or is "".
    */
    action Refresh(QuorumProject project) returns text
        ReloadOpenTabs(project)
        RefreshProjectTree(project)
        return Sentence()
    end

    /*
    This action limits reloading to the files git changed (Pull). Call it
    for each file before Refresh. Without any, every open tab in the
    project is checked (a branch switch).
    */
    action AddChangedFile(File file)
        if file = undefined
            return now
        end
        changedPaths:Add(Normalize(file:GetAbsolutePath()))
    end

    /*
    This action sets how a closed tab is explained: after the file's name
    ("was deleted by the pull, so its tab was closed.") and after a number
    of files ("files were deleted by the pull, so their tabs were
    closed.").
    */
    action SetClosedWords(text one, text many)
        closedOne = one
        closedMany = many
    end

    /*
    This action reloads the open tabs of a project (or, with undefined, of
    every open file) from disk, closes clean tabs whose file is gone, and
    keeps tabs with unsaved text as they are (GetKeptTabs).
    */
    action ReloadOpenTabs(QuorumProject project)
        reloadedCount = 0
        closedNames:Empty()
        keptNames:Empty()
        keptTabs:Empty()
        GameStateManager manager
        QuorumStudio studio = cast(QuorumStudio, manager:GetGame())
        CodeEditorTabPane editor = studio:GetTabPane()
        text folderPath = ""
        if project not= undefined
            File folder = project:GetLocation()
            folderPath = Normalize(folder:GetAbsolutePath())
        end

        // Collected first: closing a tab while walking the tabs would
        // change what's being walked.
        Array<EditorTab> tabsInProject
        Iterator<Tab> tabs = editor:GetOpenTabIterator()
        repeat while tabs:HasNext()
            Tab tab = tabs:Next()
            if tab is EditorTab
                EditorTab editorTab = cast(EditorTab, tab)
                File file = editorTab:GetFile()
                if file not= undefined
                    text path = Normalize(file:GetAbsolutePath())
                    if project = undefined or path:StartsWith(folderPath + "/")
                        tabsInProject:Add(editorTab)
                    end
                end
            end
        end

        integer counter = 0
        repeat while counter < tabsInProject:GetSize()
            EditorTab editorTab = tabsInProject:Get(counter)
            File file = editorTab:GetFile()
            boolean gone = not file:Exists()
            boolean changed = gone or changedPaths:IsEmpty() or changedPaths:Has(Normalize(file:GetAbsolutePath()))
            // A tab for a file git didn't touch is left as it is.
            if changed
                if editorTab:IsDirty()
                    // Unsaved text stays, even if the file is gone.
                    keptNames:Add(file:GetFileName())
                    keptTabs:Add(editorTab)
                elseif gone
                    closedNames:Add(file:GetFileName())
                    editor:CloseFile(file)
                elseif HasTabText(editorTab)
                    check
                        text newText = file:Read()
                        if GetTabText(editorTab) not= newText
                            ReloadTab(editorTab, newText)
                            reloadedCount = reloadedCount + 1
                        end
                        // What's on disk now is what the tab shows, so the
                        // watcher's check that follows finds nothing to do.
                        DiskChangeChecker checker = studio:GetDiskChangeChecker()
                        if checker not= undefined
                            checker:Remember(file)
                        end
                    detect e
                    end
                end
            end
            counter = counter + 1
        end
    end

    /*
    This action says whether a tab has text this class can read and set:
    a text box, or a block editor.

    Attribute: Parameter tab The tab.
    Attribute: Returns True for a text box or a block editor.
    */
    action HasTabText(EditorTab tab) returns boolean
        if tab = undefined
            return false
        end
        CodeTextBox box = tab:GetTextBox()
        if box not= undefined
            return true
        end
        CodeEditor blocks = tab:GetBlockEditor()
        return blocks not= undefined
    end

    /*
    This action returns a tab's text, from its text box or, in block mode,
    its block editor's code. Call HasTabText first; without either, "".

    Attribute: Parameter tab The tab.
    Attribute: Returns The tab's text.
    */
    action GetTabText(EditorTab tab) returns text
        CodeTextBox box = tab:GetTextBox()
        if box not= undefined
            return box:GetText()
        end
        CodeEditor blocks = tab:GetBlockEditor()
        if blocks not= undefined
            MultipleLineText code = blocks:GetCode()
            return code:GetText()
        end
        return ""
    end

    /*
    This action puts new text into a tab, as read from its file, and marks
    the tab as saved. In a text box the caret stays on its line when the
    new text still has that line (SetText would put it at the start). A
    block editor takes the code as a whole.

    Attribute: Parameter tab The tab.
    Attribute: Parameter newText The file's text.
    */
    action ReloadTab(EditorTab tab, text newText)
        CodeTextBox box = tab:GetTextBox()
        if box not= undefined
            integer line = box:GetCaretLine()
            box:SetText(newText)
            integer lineCount = box:GetLineCount()
            if line >= lineCount
                line = lineCount - 1
            end
            if line > 0
                box:SetCaretPositionToLine(line)
            end
        else
            CodeEditor blocks = tab:GetBlockEditor()
            if blocks = undefined
                return now
            end
            blocks:SetCode(newText)
        end
        // SetText reports a change, which marks the tab as edited.
        tab:SetIsDirty(false)
        tab:SetIsParseDirty(true)
    end

    // As NewFileDialog:AppendToProjectTree does: build the project's item
    // again and put it where the old one was, keeping what was open. With
    // undefined, every open project's item is built again.
    action RefreshProjectTree(QuorumProject project)
        if project = undefined
            GameStateManager allManager
            QuorumStudio allStudio = cast(QuorumStudio, allManager:GetGame())
            ProjectManager projects = allStudio:GetProjectManager()
            Array<QuorumProject> openProjects
            Iterator<QuorumProject> projectIterator = projects:GetIterator()
            repeat while projectIterator:HasNext()
                openProjects:Add(projectIterator:Next())
            end
            integer index = 0
            repeat while index < openProjects:GetSize()
                RefreshProjectTree(openProjects:Get(index))
                index = index + 1
            end
            return now
        end
        ProjectView view = project:GetProjectView()
        if not (view is QuorumProjectView)
            return now
        end
        QuorumProjectView projectView = cast(QuorumProjectView, view)
        TreeItem treeItem = projectView:GetLogicalTree()
        if treeItem = undefined
            return now
        end

        GameStateManager manager
        QuorumStudio studio = cast(QuorumStudio, manager:GetGame())
        ProjectTree projectTree = studio:GetProjectTree()
        Iterator<TreeItem> items = projectTree:GetTreeItems()
        boolean found = false
        TreeItem oldItem = undefined
        integer counter = 0
        repeat while items:HasNext() and found = false
            TreeItem candidate = items:Next()
            if candidate is ProjectTreeItem
                ProjectTreeItem header = cast(ProjectTreeItem, candidate)
                if header:GetProject() = project
                    found = true
                    oldItem = candidate
                end
            end
            if found = false
                counter = counter + 1
            end
        end

        if found = false
            return now
        end

        HashTable<text, text> expand = projectTree:GetExpandState()
        projectTree:Remove(oldItem)
        projectTree:Add(counter, treeItem)
        projectTree:LoadExpandState(expand)
    end

    action GetReloadedCount returns integer
        return reloadedCount
    end

    action GetClosedNames returns Array<text>
        return closedNames
    end

    action GetKeptCount returns integer
        return keptNames:GetSize()
    end

    action GetKeptNames returns Array<text>
        return keptNames
    end

    // The tabs left alone because they have unsaved text, for a dialog.
    action GetKeptTabs returns Array<EditorTab>
        return keptTabs
    end

    // The same path on every system: / between folders.
    private action Normalize(text path) returns text
        return path:Replace("\", "/")
    end

    private action Sentence returns text
        text result = ""
        if reloadedCount = 1
            result = " 1 open file was reloaded."
        elseif reloadedCount > 1
            result = " " + reloadedCount + " open files were reloaded."
        end
        if closedNames:GetSize() = 1
            result = result + " " + closedNames:Get(0) + " " + closedOne
        elseif closedNames:GetSize() > 1
            result = result + " " + closedNames:GetSize() + " " + closedMany
        end
        if keptNames:GetSize() = 1
            result = result + " " + keptNames:Get(0) + " has unsaved changes, so it was left as it is."
        elseif keptNames:GetSize() > 1
            result = result + " " + keptNames:GetSize() + " tabs with unsaved changes were left as they were."
        end
        return result
    end
end
