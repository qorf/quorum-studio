package Libraries.Development.Environment.Projects

use Libraries.Interface.Controls.PopupMenu
use Libraries.Interface.Controls.MenuItem
use Libraries.Interface.Behaviors.Behavior
use Libraries.Containers.Array
use Libraries.System.File
use Libraries.Game.GameStateManager
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Studio.Behaviors.TreeStageBehavior
use Libraries.Development.Environment.Studio.Behaviors.TreeResetBehavior
use Libraries.Development.Environment.Studio.Behaviors.TreeCommitBehavior
use Libraries.Development.Environment.Studio.Behaviors.TreeIgnoreBehavior
use Libraries.Development.Environment.Studio.Behaviors.TreeStashBehavior
use Libraries.Development.Environment.Studio.Behaviors.TreeRestoreStashBehavior
use Libraries.Development.Versioning.Git
use Libraries.Development.Versioning.TeamStatus
use Libraries.Development.Versioning.TeamFileChange

/*
The Project Tree's Git submenu, last in a row's menu, only for a project
in Git, and only the items that fit the row's state; nothing is greyed
out. With nothing to offer, there's no Git item at all. It's built each
time the menu opens, from the tree's last status. Before the tree has a
status for the project, only Commit... on the project's row and Ignore
File... or Ignore Folder... are offered, and a status is asked for, so
the next time the menu opens it has the rest.
*/
class ProjectTreeGitMenu
    /*
    This action adds the Git submenu for a row to a menu, and returns it so
    a kept menu (the project's row) can take it off next time. A row whose
    project isn't in Git, or with nothing to offer, gets none.
    */
    action AddItems(PopupMenu menu, ProjectTreeItem row) returns Array<MenuItem>
        Array<MenuItem> added
        if row = undefined
            return added
        end
        QuorumProject project = row:GetProject()
        File file = row:GetFile()
        if project = undefined or file = undefined or not project:HasGitSupport()
            return added
        end

        GameStateManager manager
        QuorumStudio studio = cast(QuorumStudio, manager:GetGame())
        ProjectTree tree = studio:GetProjectTree()
        TeamStatus status = tree:GetGitStatus(project)
        boolean known = status not= undefined
        if known
            known = status:IsReady()
        end
        if not known
            tree:RefreshGitMarks(project)
        end

        // The submenu goes on the menu before its items: a submenu shows its
        // arrow only if it has a parent menu when its first item is added.
        MenuItem gitItem
        gitItem:SetName("Git")
        menu:Add(gitItem)

        boolean isProjectRow = (row:GetParentTreeItem() = undefined)
        if isProjectRow
            AddProjectItems(gitItem, row, status, known)
        elseif file:IsDirectory()
            if known
                AddFolderItems(gitItem, row, status)
            end
            AddIgnoreItem(gitItem, row)
        else
            if known
                AddFileItems(gitItem, row, status)
            end
            AddIgnoreItem(gitItem, row)
        end

        if gitItem:IsEmpty()
            menu:Remove(gitItem)
        else
            added:Add(gitItem)
        end
        return added
    end

    // Stage and Reset to Last Commit.
    private action AddFileItems(MenuItem gitItem, ProjectTreeItem row, TeamStatus status)
        File file = row:GetFile()
        TreeStageBehavior counter
        Array<TeamFileChange> unstagedRows = counter:GetFileChanges(status, file, false)
        Array<TeamFileChange> stagedRows = counter:GetFileChanges(status, file, true)
        boolean hasUnstaged = not unstagedRows:IsEmpty()
        boolean hasStaged = not stagedRows:IsEmpty()

        if hasUnstaged
            TreeStageBehavior stage
            stage:SetItem(row)
            stage:SetUnstage(false)
            if hasStaged
                AddItem(gitItem, "Stage Changes Since", stage)
            else
                AddItem(gitItem, "Stage", stage)
            end
        end
        if hasStaged
            TreeStageBehavior unstage
            unstage:SetItem(row)
            unstage:SetUnstage(true)
            AddItem(gitItem, "Unstage (keeps your changes)", unstage)
        end

        // Only a file in the last commit that has changes.
        TreeResetBehavior reset
        if reset:CanReset(status:GetChanges(file))
            reset:SetItem(row)
            AddItem(gitItem, "Reset to Last Commit...", reset)
        end
    end

    // Unstage.
    private action AddFolderItems(MenuItem gitItem, ProjectTreeItem row, TeamStatus status)
        TreeStageBehavior counter
        integer unstaged = counter:CountUnder(status, row:GetFile(), false)
        integer staged = counter:CountUnder(status, row:GetFile(), true)
        if unstaged > 0
            TreeStageBehavior stage
            stage:SetItem(row)
            stage:SetUnstage(false)
            AddItem(gitItem, "Stage Folder (" + CountWords(unstaged, "change", "changes") + ")", stage)
        end
        if staged > 0
            TreeStageBehavior unstage
            unstage:SetItem(row)
            unstage:SetUnstage(true)
            AddItem(gitItem, "Unstage Folder (" + staged + " staged)", unstage)
        end
    end

    // Commit... is there whether or not the status is known yet.
    private action AddProjectItems(MenuItem gitItem, ProjectTreeItem row, TeamStatus status, boolean known)
        QuorumProject project = row:GetProject()
        if known
            TreeStageBehavior counter
            integer unstaged = counter:CountUnder(status, project:GetLocation(), false)
            if unstaged > 0
                TreeStageBehavior stage
                stage:SetItem(row)
                stage:SetUnstage(false)
                AddItem(gitItem, "Stage All Changes (" + unstaged + ")", stage)
            end
        end
        TreeCommitBehavior commitBehavior
        commitBehavior:SetProject(project)
        AddItem(gitItem, "Commit...", commitBehavior)

        // Stash Changes... when there's anything to stash, in the project
        // or elsewhere in the repository (git stashes all of it).
        if known
            integer changes = status:GetChangeCount() + status:GetOutside():GetSize()
            if changes > 0
                TreeStashBehavior stash
                stash:SetItem(row)
                AddItem(gitItem, "Stash Changes...", stash)
            end
        end
        // Restore Stashed Changes when there's a stash.
        Git git
        if git:CountStashes(project:GetGitRepository()) > 0
            TreeRestoreStashBehavior restore
            restore:SetItem(row)
            AddItem(gitItem, "Restore Stashed Changes", restore)
        end
    end

    /*
    Ignore File... or Ignore Folder...: for any file or folder git doesn't
    already ignore, whether or not it has changes. Not for .gitignore itself.
    */
    private action AddIgnoreItem(MenuItem gitItem, ProjectTreeItem row)
        QuorumProject project = row:GetProject()
        File file = row:GetFile()
        if file:GetFileName() = ".gitignore"
            return now
        end
        Git git
        if git:IsIgnored(project:GetGitRepository(), file)
            return now
        end
        TreeIgnoreBehavior ignore
        ignore:SetItem(row)
        if file:IsDirectory()
            AddItem(gitItem, "Ignore Folder...", ignore)
        else
            AddItem(gitItem, "Ignore File...", ignore)
        end
    end

    private action AddItem(MenuItem gitItem, text name, Behavior behavior)
        MenuItem item
        item:SetName(name)
        item:SetBehavior(behavior)
        gitItem:Add(item)
    end

    private action CountWords(integer count, text one, text many) returns text
        if count = 1
            return "1 " + one
        end
        return "" + count + " " + many
    end
end
