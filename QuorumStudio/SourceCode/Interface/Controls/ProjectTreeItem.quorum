package Libraries.Development.Environment.Projects

use Libraries.Interface.Controls.TreeItem
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.System.File
use Libraries.Interface.Controls.PopupMenu
use Libraries.Development.Environment.Studio.Behaviors.OpenTabBehavior
use Libraries.Interface.Controls.MenuItem
use Libraries.Development.Environment.Studio.Behaviors.DeleteFileBehavior
use Libraries.Development.Environment.Studio.Behaviors.OpenNewFileBehavior
use Libraries.Game.GameStateManager
use Libraries.Game.Game
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Studio.Behaviors.SetProgramStartBehavior
use Libraries.Development.Environment.Studio.StudioFocusManager
use Libraries.Development.Environment.Studio.Behaviors.OpenFindInProjectDialogBehavior
use Libraries.Development.Environment.Studio.Behaviors.Behaviors
use Libraries.Game.Graphics.ColorGroup
use Libraries.Containers.Array

class ProjectTreeItem is TreeItem
    QuorumProject project = undefined
    File file = undefined
    GameStateManager manager
    // The Git items last added to the project row's kept menu (Tree M3).
    Array<MenuItem> gitMenuItems
    // An item kept at the bottom of the project row's menu, after the Git
    // items (Properties; QuorumProjectView sets it).
    MenuItem lastMenuItem = undefined
    ProjectTreeGitMenu gitMenu
    
    action GetProject returns QuorumProject
        return project
    end

    action SetProject(QuorumProject project)
        me:project = project
    end

    action GetFile returns File
        return file
    end

    action SetFile(File file)
        me:file = file
        SetName(file:GetFileName())
    end

    /*
    This action sets a file row's git mark (Tree L2): a thin bar at the
    tree's left edge in the given color, filled or outlined
    (TreeItem:SetLeadingBar). No word after the name: the bar and the Team
    tab say it (the user, 2026-11-04). The mark in words goes in the row's
    description ("Modified"), which a screen reader reads after the row's
    name when the row gets focus. With no bar color (the theme's Git
    colors couldn't be read), the row has no bar.
    */
    action SetGitMark(ColorGroup barColor, boolean outlined, text words)
        SetGitBar(barColor, outlined)
        SetTrailingText("")
        SetGitWords(words)
    end

    /*
    This action sets a folder's or the project's row git mark (Tree R2): a
    filled bar at the tree's left edge, no word, and the mark in words as
    the row's description ("Changes inside", "On branch main, 6 changes").
    */
    action SetGitMark(ColorGroup barColor, text words)
        SetGitBar(barColor, false)
        SetTrailingText("")
        SetGitWords(words)
    end

    /*
    This action takes the row's bar and word away and sets only its
    description (the project's row with no changes: "On branch main").
    */
    action SetGitDescription(text words)
        RemoveLeadingBar()
        SetTrailingText("")
        SetGitWords(words)
    end

    // Takes the row's git mark away: no bar, no word, no description.
    action ClearGitMark
        SetGitDescription("")
    end

    // The word after the row's name ("modified"), or "".
    action GetGitMark returns text
        return GetTrailingText()
    end

    private action SetGitBar(ColorGroup color, boolean outlined)
        if color = undefined
            RemoveLeadingBar()
        else
            SetLeadingBar(color, outlined)
        end
    end

    private action SetGitWords(text words)
        if GetDescription() not= words
            SetDescription(words)
        end
    end

    // Sets an item to keep last in the project row's menu (Properties).
    action SetLastMenuItem(MenuItem item)
        lastMenuItem = item
    end

    action GetPopupMenu returns PopupMenu
        // The project's row keeps one menu (QuorumProjectView); its Git items
        // are taken off and added again each time, from the current state.
        PopupMenu kept = parent:Control:GetPopupMenu()
        if kept not= undefined
            integer index = 0
            repeat while index < gitMenuItems:GetSize()
                kept:Remove(gitMenuItems:Get(index))
                index = index + 1
            end
            // Properties stays last: taken off, then put back after the Git
            // items.
            if lastMenuItem not= undefined
                kept:Remove(lastMenuItem)
            end
            gitMenuItems = gitMenu:AddItems(kept, me)
            if lastMenuItem not= undefined
                kept:Add(lastMenuItem)
            end
            return kept
        end

        PopupMenu exampleContextMenu
        if file:IsDirectory()
            text dq = ""
            dq = dq:GetDoubleQuote()

            OpenNewFileBehavior openNewFileBehavior
            MenuItem newFileMenuItem
            newFileMenuItem:SetName("New File")
            newFileMenuItem:SetBehavior(openNewFileBehavior)
            exampleContextMenu:Add(newFileMenuItem)

            OpenNewFileBehavior openNewFolderBehavior
            openNewFolderBehavior:SetIsFolder(true)
            MenuItem newFolderMenuItem
            newFolderMenuItem:SetName("New Folder")
            newFolderMenuItem:SetBehavior(openNewFolderBehavior)
            exampleContextMenu:Add(newFolderMenuItem)

            MenuItem renameMenuItem
            renameMenuItem:SetName("Rename")
            //exampleContextMenu:Add(renameMenuItem)
            //value:SetPopupMenu(exampleContextMenu)

            MenuItem deleteFolderMenuItem
            deleteFolderMenuItem:SetName("Delete")
            DeleteFileBehavior deleteFileBehavior
            deleteFileBehavior:SetFile(file)
            deleteFileBehavior:SetItem(me)
            deleteFolderMenuItem:SetBehavior(deleteFileBehavior)
            exampleContextMenu:Add(deleteFolderMenuItem)

            MenuItem findInProjectMenuItem
            findInProjectMenuItem:SetName("Find")
            findInProjectMenuItem:SetBehavior(GetFindInProjectBehavior())
            exampleContextMenu:Add(findInProjectMenuItem)

            // Tree M2: only in a Git project.
            gitMenu:AddItems(exampleContextMenu, me)
        else
            OpenTabBehavior openTabBehavior

            
            MenuItem openMenuItem
            openMenuItem:SetName("Open")
            exampleContextMenu:Add(openMenuItem)
            openMenuItem:SetBehavior(openTabBehavior)

            MenuItem renameMenuItem
            renameMenuItem:SetName("Rename")
            //exampleContextMenu:Add(renameMenuItem)

            DeleteFileBehavior deleteFileBehavior
            MenuItem deleteMenuItem
            deleteMenuItem:SetName("Delete")
            deleteFileBehavior:SetFile(file)
            deleteFileBehavior:SetItem(me)
            deleteMenuItem:SetBehavior(deleteFileBehavior)
            exampleContextMenu:Add(deleteMenuItem)

            MenuItem findInProjectMenuItem
            findInProjectMenuItem:SetName("Find")
            findInProjectMenuItem:SetBehavior(GetFindInProjectBehavior())
            exampleContextMenu:Add(findInProjectMenuItem)

            SetProgramStartBehavior startBehavior
            MenuItem setMainFileMenuItem
            setMainFileMenuItem:SetBehavior(startBehavior)
            setMainFileMenuItem:SetName("Set Program Start")
            exampleContextMenu:Add(setMainFileMenuItem)

            QuorumStudio studio = cast(QuorumStudio, manager:GetGame())
            openTabBehavior:SetMainApplication(studio)
            //openTabBehavior:SetFile(file)

            // Tree M1 and M4: only in a Git project.
            gitMenu:AddItems(exampleContextMenu, me)
        end
        return exampleContextMenu
    end

    /*
    The shared Find in Project behavior. It keeps one dialog for every file
    and folder menu. A new behavior per menu made a new dialog on every
    right-click, filled before its first layout (Bug A). It reads the tree
    selection when it runs, so it still searches the clicked row.
    */
    private action GetFindInProjectBehavior returns OpenFindInProjectDialogBehavior
        QuorumStudio studio = cast(QuorumStudio, manager:GetGame())
        Behaviors behaviors = studio:GetBehaviors()
        return behaviors:GetOpenFindInProjectDialogBehavior()
    end

    action GainedSelection
        QuorumStudio studio = cast(QuorumStudio, manager:GetGame())
        StudioFocusManager focusManager = studio:GetStudioFocusManager()
        
        if project not= undefined
            focusManager:SetProjectFocus(project)
        end

        parent:TreeItem:GainedSelection()
    end
end