package Libraries.Development.Environment.Studio.Interface

use Libraries.Interface.Controls.Blocks.CodeEditor
use Libraries.Interface.Controls.Blocks.CodeEditorRenderer
use Libraries.Interface.Controls.Blocks.Block
use Libraries.Interface.Controls.Control
use Libraries.Interface.Controls.Gutter
use Libraries.Interface.Controls.LineNumberGutter
use Libraries.Interface.Controls.AnnotationLineGutter
use Libraries.Interface.Events.GutterEvent
use Libraries.Development.Environment.Studio.Build.BuildManager
use Libraries.Language.Compile.Symbol.Class
use Libraries.Language.Debug.BreakpointManager
use Libraries.Game.Graphics.Drawable
use Libraries.System.File
use Libraries.Containers.Array
use Libraries.Development.Versioning.DiffResult
use Libraries.Development.Versioning.DiffEdit
use Libraries.Development.Versioning.GitConstants
use Libraries.Game.GameStateManager
use Libraries.Interface.Accessibility
use Libraries.Game.Shapes.Rectangle
use Libraries.Containers.MultipleLineText

/*
Studio's block editor. A click in its line number gutter toggles the
breakpoint through the BuildManager, as CodeTextBox does, so the debugger
hears about it while a program is being debugged. The library's editor
changes only the breakpoint list.

Its gutters are Studio's, the same as the text editor's (G1): line numbers
with the breakpoint dot and the stopped-line arrow, then the git lane. The
library's number and annotation gutters are taken out. The annotation
gutter still gets its annotations, which blocks read aloud.
*/
class StudioBlockEditor is CodeEditor
    BuildManager manager = undefined
    StudioLineGutter studioGutter
    StatusLineGutter statusGutter
    GitConstants gitConstants
    // The faint band across the code on the stopped row, made when first
    // shown. It's the renderer's, drawn under the blocks.
    Drawable debuggerBand = undefined
    boolean bandAdded = false
    GutterSupport support

    on create
        LineNumberGutter libraryNumbers = parent:CodeEditor:lineGutter
        libraryNumbers:RemoveGutterListener(me)
        Remove(cast(Gutter, libraryNumbers))
        AnnotationLineGutter libraryAnnotations = GetAnnotationLineGutter()
        Remove(cast(Gutter, libraryAnnotations))

        studioGutter:SetPositionOnBaseLine(false)
        studioGutter:AddGutterListener(me)
        Add(cast(Gutter, studioGutter))
        Add(cast(Gutter, statusGutter))
        // Shift+F1 on a changed block shows the change's tooltip.
        SetTooltipEnabled(true)
    end

    // The tooltip of the change on a line since the last commit.
    GitChangeTooltip changeTooltip

    action GetBuildManager returns BuildManager
        return manager
    end

    action SetBuildManager(BuildManager manager)
        me:manager = manager
    end

    action GetLineNumberGutter returns LineNumberGutter
        return studioGutter
    end

    action GetStatusGutter returns StatusLineGutter
        return statusGutter
    end

    action SetFile(File file)
        parent:CodeEditor:SetFile(file)
        studioGutter:SetFile(file)
    end

    // Not the library's: its number gutter is out and mustn't hear about
    // breakpoints, since it has no editor to draw in.
    action SetBreakpointManager(BreakpointManager breakpointManager)
        parent:CodeEditor:breakpoints = breakpointManager
        studioGutter:SetBreakpointManager(breakpointManager)
    end

    /*
        This action selects the line and informs
        the system that the debugger is stopped at this particular
        block.
    */
    action SelectDebuggerLine(integer line)
        Block block = SelectBlockAtTextLine(line)
        if block not= undefined
            studioGutter:SetDebuggerLine(block:GetNavigationIndex())
        end
    end

    action ClearDebuggerLine
        studioGutter:SetDebuggerLine(-1)
    end

    action GetDebuggerLine returns integer
        return studioGutter:GetDebuggerLine()
    end

    /*
    This action shows the faint green band across the code on the row the
    debugger is stopped on (G1). The gutter calls it as it draws, with the
    row's y and height, which are the editor's own: the gutters start at its
    bottom-left corner. The band belongs to the renderer and is drawn over
    its background and under the blocks, so its position is the renderer's.
    The renderer leaves out the gutters and scroll bars and clips to itself.
    */
    action ShowDebuggerBand(number y, number height)
        CodeEditorRenderer region = GetRenderer()
        if region = undefined
            HideDebuggerBand()
            return now
        end
        number bottom = y - region:GetY()
        number top = bottom + height
        if bottom < 0
            bottom = 0
        end
        if top > region:GetHeight()
            top = region:GetHeight()
        end
        number width = region:GetWidth()
        if width <= 0 or top <= bottom
            HideDebuggerBand()
            return now
        end

        if debuggerBand = undefined
            Drawable band
            band:LoadFilledRectangle(1, 1)
            band:SetAcceptsMouseInput(false)
            debuggerBand = band
        end
        debuggerBand:SetColor(support:GetStoppedBandColor())
        debuggerBand:SetSize(cast(integer, width), cast(integer, top - bottom))
        debuggerBand:SetPosition(0, bottom)
        // Added once and then shown or hidden: removing a child asks for a layout.
        if not bandAdded
            region:AddUnderlay(debuggerBand)
            bandAdded = true
        end
        debuggerBand:Show()
    end

    // The library editor's renderer, its scrollable region.
    private action GetRenderer returns CodeEditorRenderer
        Control region = GetScrollableRegion()
        if region is CodeEditorRenderer
            return cast(CodeEditorRenderer, region)
        end
        return undefined
    end

    action HideDebuggerBand
        if debuggerBand not= undefined
            debuggerBand:Hide()
        end
    end

    action GutterClicked(GutterEvent event)
        if manager = undefined
            parent:CodeEditor:GutterClicked(event)
            return now
        end

        Gutter gutter = event:GetGutter()
        if gutter = undefined
            return now
        end
        if not (gutter is LineNumberGutter)
            return now
        end
        Block block = GetBlockAtNavigationIndex(event:GetLine())
        integer line = GetBreakpointLine(block)
        File file = GetBreakpointFile()
        if line < 0 or file = undefined
            return now
        end
        manager:ToggleBreakpoint(file, line)
        RefreshAccessibility(block)
    end

    /*
    This action tells screen readers that a block's details changed, such
    as its breakpoint, so they read the new ones (Block's description).
    */
    action RefreshAccessibility(Block block)
        if block = undefined
            return now
        end
        GameStateManager gameState
        Accessibility access = gameState:GetAccessibility()
        if access not= undefined
            access:DescriptionChanged(block)
        end
    end

    /*
    This action returns what git sees on a text line, for screen readers,
    as the git lane shows it (StatusLineGutter): "Added.", "Changed.",
    "Lines deleted below." or "".
    */
    action GetLineStatus(integer line) returns text
        DiffResult diff = statusGutter:GetDiffResult()
        if diff = undefined or line < 0
            return ""
        end
        Array<DiffEdit> edits = diff:GetEdits()
        if edits = undefined or line >= edits:GetSize()
            return ""
        end
        DiffEdit edit = edits:Get(line)
        integer editType = edit:GetEditType()
        if editType = gitConstants:EDIT_INSERT
            return "Added."
        elseif editType = gitConstants:EDIT_CHANGE
            return "Changed."
        elseif editType = gitConstants:EDIT_EQUAL and edit:HasDeletion()
            return "Lines deleted below."
        end
        return ""
    end

    /*
    This action returns the line a block's breakpoint goes on: its first
    line, whichever of its rows was clicked or selected. The gutter and the
    keyboard both use it, so they agree. It returns -1 for no block.
    */
    action GetBreakpointLine(Block block) returns integer
        if block = undefined
            return -1
        end
        return block:GetStartLine()
    end

    // The editor's own file, or its class's.
    action GetBreakpointFile returns File
        File file = GetFile()
        Class clazz = GetClass()
        if file = undefined and clazz not= undefined
            file = clazz:GetFile()
        end
        return file
    end

    // One line of the code's text, counting from 0.
    action GetTextLine(integer line) returns text
        MultipleLineText code = GetCode()
        if line < 0 or line >= code:GetLineCount()
            return ""
        end
        return code:GetLine(line):GetText()
    end

    // The text line of the selected block, or -1 when none is selected.
    private action GetSelectedTextLine returns integer
        return GetBreakpointLine(GetSelection():GetBlock())
    end

    /*
    The editor's tooltip is the change on the selected block's line
    (GitChangeTooltip): Shift+F1 shows it, with the focus on its first
    button. Resting the mouse on the blocks doesn't; the change lane shows it
    for the mouse.
    */
    action IsTooltipShownOnHover returns boolean
        return false
    end

    action HasTooltipContent returns boolean
        return changeTooltip:GetChange(me, GetSelectedTextLine()) not= undefined
    end

    action GetTooltipTitle returns text
        DiffEdit edit = changeTooltip:GetChange(me, GetSelectedTextLine())
        if edit = undefined
            return ""
        end
        return changeTooltip:GetTitle(edit)
    end

    action GetTooltipText returns text
        return ""
    end

    /*
    The words screen readers get as the editor's help stay its description:
    the change tooltip follows the selection, and is read when it opens.
    */
    action GetTooltipWords returns text
        text description = GetDescription()
        if description = undefined
            return ""
        end
        return description
    end

    action CreateTooltipContent returns Control
        integer line = GetSelectedTextLine()
        DiffEdit edit = changeTooltip:GetChange(me, line)
        if edit = undefined
            return undefined
        end
        return changeTooltip:MakeContent(me, edit, line)
    end

    action IsTooltipInteractive returns boolean
        return true
    end

    // Below the selected block.
    action GetTooltipArea returns Rectangle
        Block block = GetSelection():GetBlock()
        if block = undefined
            return undefined
        end
        Rectangle area
        area:SetRectangle(block:GetScreenX(), block:GetScreenY(), block:GetWidth(), block:GetHeight())
        return area
    end

    /*
    Puts a change back as it was at the last commit, as one step that Undo
    takes back: a changed block of lines gets its old lines again, added
    lines are removed, and deleted lines go back below their line. The
    block where the change was is then selected.

    Attribute: Parameter edit The change, from the change lane's diff.
    Attribute: Parameter line The line the change was shown on.
    */
    action RestoreChange(DiffEdit edit, integer line)
        if edit = undefined
            return now
        end
        text lineFeed = ""
        lineFeed = lineFeed:GetLineFeed()
        integer type = edit:GetEditType()
        integer lineCount = GetRawTextLineCount()
        integer size = GetCode():GetSize()
        integer first = edit:GetBlockStart()
        integer last = edit:GetBlockEnd()
        integer selectLine = line

        if type = gitConstants:EDIT_CHANGE
            if first >= 0 and last < lineCount
                integer startIndex = GetIndexOfLineStart(first)
                ReplaceText(startIndex, GetIndexOfLineEnd(last) - startIndex, edit:GetOldText())
                selectLine = first
            end
        elseif type = gitConstants:EDIT_INSERT
            if first >= 0 and last < lineCount
                if last + 1 < lineCount
                    // The lines and the line break after the last one.
                    integer startIndex = GetIndexOfLineStart(first)
                    ReplaceText(startIndex, GetIndexOfLineStart(last + 1) - startIndex, "")
                elseif first > 0
                    // The last lines: the line break before them too.
                    integer endIndex = GetIndexOfLineEnd(first - 1)
                    ReplaceText(endIndex, size - endIndex, "")
                else
                    ReplaceText(0, size, "")
                end
                selectLine = first - 1
                if selectLine < 0
                    selectLine = 0
                end
            end
        elseif edit:GetDeletedLineCount() > 0 and line < lineCount
            ReplaceText(GetIndexOfLineEnd(line), 0, lineFeed + edit:GetDeletedText())
            selectLine = line + 1
        end

        if selectLine < GetRawTextLineCount()
            SelectBlockAtTextLine(selectLine, true)
        end
    end

    /*
    Selects the block of the next change after a line: a line added or
    changed, or one with lines deleted below it, as the change lane marks.
    */
    action GoToNextChange(integer line)
        DiffResult result = statusGutter:GetDiffResult()
        if result = undefined
            return now
        end
        Array<DiffEdit> edits = result:GetEdits()
        integer index = line + 1
        repeat while index < edits:GetSize()
            DiffEdit edit = edits:Get(index)
            integer type = edit:GetEditType()
            if type = gitConstants:EDIT_INSERT or type = gitConstants:EDIT_CHANGE or edit:HasDeletion()
                SelectBlockAtTextLine(index, true)
                return now
            end
            index = index + 1
        end
    end

end
