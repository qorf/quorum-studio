package Libraries.Development.Environment.Studio.Interface

/*
A list row with a fold control, such as a chevron, that one click folds or
unfolds. FoldClickBehavior asks the row whether a click landed on it.
*/
class FoldClickRow
    /*
    This action returns whether a point, in the layer's coordinates, is on
    this row's fold control.
    */
    blueprint action IsOnFoldControl(number x, number y) returns boolean
end
