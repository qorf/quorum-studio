        newBranchMenuItem:SetShortcut(keyMap:GetNewBranchKey())
        newBranchMenuItem:SetBehavior(behaviors:GetNewBranchBehavior())
        newBranchMenuItem:SetMnemonic("n")
        teamItems:Add(newBranchMenuItem)

        teamMenu:SetName("Team")
        teamMenu:Add(teamItems)
    end

