        MenuItem StatusMenuItem
        StatusMenuItem:SetName("Status")
        StatusMenuItem:SetShortcut(keyMap:GetStatusRequestKey())
        StatusMenuItem:SetBehavior(behaviors:GetTeamStatusBehavior())
        StatusMenuItem:SetMnemonic("s")
        teamItems:Add(StatusMenuItem)

        // Stages what's selected in the Project Tree (a file, a folder or a
        // project), as the tree's own Stage items do.
        MenuItem stageMenuItem
        stageMenuItem:SetName("Stage")
        stageMenuItem:SetShortcut(keyMap:GetAddRequestKey())
        stageMenuItem:SetBehavior(behaviors:GetAddRequestBehavior())
        stageMenuItem:SetMnemonic("a")
