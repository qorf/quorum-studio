        pushMenuItem:SetBehavior(behaviors:GetTeamPushBehavior())
        pushMenuItem:SetMnemonic("u")
        teamItems:Add(pushMenuItem)

        MenuItem switchBranchMenuItem
        switchBranchMenuItem:SetName("Switch Branch...")
        switchBranchMenuItem:SetShortcut(keyMap:GetSwitchBranchKey())
        switchBranchMenuItem:SetBehavior(behaviors:GetSwitchBranchBehavior())
        switchBranchMenuItem:SetMnemonic("b")
        teamItems:Add(switchBranchMenuItem)

        MenuItem newBranchMenuItem
