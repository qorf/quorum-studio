package Libraries.Development.Environment.Projects
use Libraries.Interface.Controls.Tree
use Libraries.Interface.Selections.Selection
use Libraries.Interface.Events.SelectionListener
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Containers.Iterator
use Libraries.Interface.Selections.TreeSelection
use Libraries.Containers.Array
use Libraries.Interface.Controls.TreeItem
use Libraries.Development.Environment.Resources
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Interface.Layouts.Layout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Concurrency.ThreadRunner
use Libraries.Development.Environment.Studio.Behaviors.ProjectLoadBehavior
use Libraries.Development.Environment.Studio.Behaviors.ThreadedBehavior
use Libraries.Interface.Events.FocusEvent
use Libraries.Containers.HashTable
use Libraries.Interface.Events.TreeChangeListener
use Libraries.Interface.Events.TreeChangeEvent
use Libraries.Game.InputTable
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Game.InputSet
use Libraries.Interface.Accessibility
use Libraries.System.File
use Libraries.Development.Versioning.TeamStatus
use Libraries.Development.Environment.Studio.Behaviors.TreeGitStatusBehavior

class ProjectTree is Tree, SelectionListener, ProjectListener, TreeChangeListener
    ProjectManager manager = undefined
    Resources resources = undefined
    QuorumStudio studio = undefined
    HashTable<text, text> opened
    // The last git status of each project, by its folder (Tree R2 and L2).
    HashTable<text, TeamStatus> gitStatuses
    ProjectTreeGitMarks gitMarks
    // A status from another thread, applied on the next Update, as the
    // Team tab takes its status (TeamTab:PostStatus).
    TeamStatus pendingGitStatus = undefined
    // The projects' folders, in the order they were opened (Bugs 05 B). A
    // project's row goes at this place, whichever project loads first.
    Array<text> projectOrder
    on create
        SetName("Projects")
        AddTreeChangeListener(me)
    end

    action GainedFocus(FocusEvent event)
        if IsEmpty() and studio not= undefined
            Accessibility accessibility = studio:GetAccessibility()
            if accessibility not= undefined
                accessibility:Notify(me, "No projects open")
            end
        end
    end

    action SetMainApplication(QuorumStudio studio)
        me:studio = studio
    end

    action GetMainApplication returns QuorumStudio
        return studio
    end

    action GetResources returns Resources
        return resources
    end

    action SetResources(Resources resources)
        me:resources = resources
    end

    action SetProjectManager(ProjectManager manager)
        me:manager = manager
    end

    action GetProjectManager returns ProjectManager
        return manager
    end

    action GetExpandState returns HashTable<text, text>
        return opened
    end

    action LoadSelection(text path)
        //tree is expected to have relevant treeItems already open
        if path not= ""
            Iterator<TreeItem> items = GetTreeItems()
            repeat while items:HasNext()
                ProjectTreeItem curr = cast(ProjectTreeItem, items:Next())
                if path = curr:GetFile():GetAbsolutePath()
                    Select(curr:GetTreePath())
                    return now
                end
                if curr:IsOpen()
                    if LoadSelection(path, curr)
                        return now
                    end
                end
            end
        end
    end

    //helper recursive search for selection
    private action LoadSelection(text path, ProjectTreeItem item) returns boolean
        Iterator<TreeItem> items = item:GetTreeItems()
        repeat while items:HasNext()
            ProjectTreeItem curr = cast(ProjectTreeItem, items:Next())
            if path = curr:GetFile():GetAbsolutePath()
                Select(curr:GetTreePath())
                return true
            end
            // Keep looking in the next folders if it isn't in this one (this
            // used to return after the first open folder, found or not).
            if curr:IsOpen()
                if LoadSelection(path, curr)
                    return true
                end
            end
        end
        return false
    end

    //pass in hash table of all treeitems that were open
    action LoadExpandState(HashTable<text, text> states)
        if states:IsEmpty()
            return now
        end
        integer counter = 0
        Iterator<TreeItem> items = GetTreeItems()
        ProjectTreeItem curr
        repeat while items:HasNext()
            curr = cast(ProjectTreeItem, items:Next())
            if states:HasKey(curr:GetFile():GetAbsolutePath())
                curr:Resize()
                curr:Open()
                if curr:IsSubtree()
                    OpenExpandState(states, curr)
                end
            end
            counter = counter + 1
        end
    end

    //recursive helper function that goes deeper into the project tree
    private action OpenExpandState(HashTable<text, text> states, ProjectTreeItem parentItem)
        Iterator<TreeItem> value = parentItem:GetTreeItems()
        integer counter = 0
        repeat while value:HasNext()
            ProjectTreeItem curr = cast(ProjectTreeItem, value:Next())
            if states:HasKey(curr:GetFile():GetAbsolutePath())
                curr:Resize()
                curr:Open()
                if curr:IsSubtree()
                    OpenExpandState(states, curr)
                end
            end
            counter = counter + 1
        end
    end

    action OpenedTree(TreeChangeEvent event)
        ProjectTreeItem item = cast(ProjectTreeItem, event:GetTreeItem())
        opened:Add(item:GetFile():GetAbsolutePath(), item:GetFile():GetAbsolutePath())
    end

    action ClosedTree(TreeChangeEvent event)
        ProjectTreeItem item = cast(ProjectTreeItem, event:GetTreeItem())
        opened:RemoveKey(item:GetFile():GetAbsolutePath())
    end

    action SelectionChanged(Selection selection)
    end

    /*
    A project's row is added when it loads and again each time it's rebuilt
    (a new file, a pull, a branch switch). It gets its project's last marks
    at once; a fresh status, if one is coming, replaces them.
    */
    action Add(TreeItem item)
        parent:Tree:Add(item)
        ShowKnownMarks(item)
    end

    action Add(integer location, TreeItem item)
        parent:Tree:Add(location, item)
        ShowKnownMarks(item)
    end

    /*
    This action shows a project's git status as marks on its rows (Tree R2 and L2)
    and keeps it for the project. Call it on the main thread; other threads
    use PostGitStatus. A status with no project folder (no project, or a
    project not in Git) is ignored, and so is one for a project that isn't
    in Git.
    */
    action ApplyGitStatus(TeamStatus status)
        if status = undefined
            return now
        end
        File folder = status:GetProjectFolder()
        if folder = undefined
            return now
        end
        text key = PathKey(folder)
        ProjectTreeItem row = GetProjectRow(key)
        if row not= undefined
            // GetProjectRow only returns rows that have a project.
            QuorumProject rowProject = row:GetProject()
            if not rowProject:HasGitSupport()
                return now
            end
        end
        gitStatuses:Add(key, status)
        if row not= undefined
            gitMarks:Apply(row, status)
        end
    end

    // The same, from any thread: applied on the tree's next Update.
    action PostGitStatus(TeamStatus status)
        pendingGitStatus = status
    end

    action Update(number seconds)
        if pendingGitStatus not= undefined
            TeamStatus value = pendingGitStatus
            pendingGitStatus = undefined
            ApplyGitStatus(value)
        end
    end

    /*
    This action reads a project's git status on the git thread and shows it
    as marks. Projects not in Git are skipped. Main thread.
    */
    action RefreshGitMarks(QuorumProject project)
        if project = undefined or studio = undefined
            return now
        end
        if not project:HasGitSupport()
            return now
        end
        TreeGitStatusBehavior reader
        reader:Setup(me, project)
        ThreadRunner runner = studio:GetBehaviors():GetGitRunner()
        runner:Add(reader)
    end

    // The last status read for a project, or undefined (step 13's menus).
    action GetGitStatus(QuorumProject project) returns TeamStatus
        if project = undefined
            return undefined
        end
        text key = PathKey(project:GetLocation())
        if gitStatuses:HasKey(key)
            return gitStatuses:GetValue(key)
        end
        return undefined
    end

    // A project row's last marks, if its project is in Git and has a status.
    private action ShowKnownMarks(TreeItem item)
        if not (item is ProjectTreeItem)
            return now
        end
        ProjectTreeItem row = cast(ProjectTreeItem, item)
        QuorumProject rowProject = row:GetProject()
        if rowProject = undefined
            return now
        end
        if not rowProject:HasGitSupport()
            return now
        end
        text key = PathKey(rowProject:GetLocation())
        if gitStatuses:HasKey(key)
            gitMarks:Apply(row, gitStatuses:GetValue(key))
        end
    end

    // The row of the project whose folder has this key.
    private action GetProjectRow(text key) returns ProjectTreeItem
        Iterator<TreeItem> items = GetTreeItems()
        repeat while items:HasNext()
            TreeItem item = items:Next()
            if item is ProjectTreeItem
                ProjectTreeItem row = cast(ProjectTreeItem, item)
                QuorumProject rowProject = row:GetProject()
                if rowProject not= undefined
                    if PathKey(rowProject:GetLocation()) = key
                        return row
                    end
                end
            end
        end
        return undefined
    end

    // A folder's path with / between folders, the same on every system.
    private action PathKey(File folder) returns text
        if folder = undefined
            return ""
        end
        text path = folder:GetAbsolutePath()
        return path:Replace("\", "/")
    end

    /*
    This action adds a loaded project's row before the first row of a project
    opened after it, so projects keep the order they were opened in, whichever
    loads first. Projects still load in parallel.
    */
    action AddProjectRow(QuorumProject project, TreeItem item)
        integer position = GetOpenPosition(project)
        integer location = -1
        integer counter = 0
        Iterator<TreeItem> items = GetTreeItems()
        repeat while items:HasNext() and location < 0
            TreeItem current = items:Next()
            if current is ProjectTreeItem
                ProjectTreeItem row = cast(ProjectTreeItem, current)
                if GetOpenPosition(row:GetProject()) > position
                    location = counter
                end
            end
            counter = counter + 1
        end
        if location < 0
            Add(item)
        else
            Add(location, item)
        end
    end

    // Where a project is in the open order. One not in it goes last.
    private action GetOpenPosition(QuorumProject project) returns integer
        if project = undefined
            return projectOrder:GetSize()
        end
        integer position = projectOrder:GetFirstLocation(PathKey(project:GetLocation()))
        if position < 0
            return projectOrder:GetSize()
        end
        return position
    end

     action OpenedProject(QuorumProject project)
        text key = PathKey(project:GetLocation())
        if not projectOrder:Has(key)
            projectOrder:Add(key)
        end
        ThreadRunner runner
        ThreadedBehavior threadBehavior
        ProjectLoadBehavior behave
        behave:SetTree(me)
        behave:SetProject(project)
        behave:SetResources(resources)
        behave:SetMainApplication(studio)
        behave:SetThread(runner)
        AddBehavior(behave)
        // Files changed outside Studio are noticed (01c).
        if studio not= undefined
            studio:WatchProjectFolder(project:GetLocation())
        end
    end

    action ClosedProject(QuorumProject project)
        Iterator<TreeItem> iterator = GetTreeItems()
        repeat while iterator:HasNext() 
            TreeItem item = iterator:Next()
            ProjectTreeItem projectItem = cast(ProjectTreeItem, item)
            QuorumProject proj = projectItem:GetProject()
            if project:Equals(proj)
                Remove(item)
            end
        end
        // Reopened later, the project gets a fresh status.
        gitStatuses:RemoveKey(PathKey(project:GetLocation()))
        // and goes at the end.
        projectOrder:Remove(PathKey(project:GetLocation()))
        if studio not= undefined
            studio:UnwatchProjectFolder(project:GetLocation())
        end
        Resize()
    end
end