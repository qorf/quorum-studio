package Libraries.Development.Environment.Studio.Interface

use Libraries.Interface.Controls.Tab
use Libraries.Interface.Controls.TextBox
use Libraries.Containers.Array
use Libraries.Interface.Events.FocusEvent
use Libraries.Development.Environment.Studio.Behaviors.Behaviors
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Development.Environment.Studio.Behaviors.InputBehavior
use Libraries.Game.Graphics.Color
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Game.InputSet
use Libraries.Game.InputTable
use Libraries.Interface.Behaviors.Controls.TextBoxNewLineBehavior
use Libraries.Interface.Controls.Control
use Libraries.Interface.Controls.Button
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Options.InterfaceOptions
use Libraries.Game.Graphics.Label
use Libraries.Game.Graphics.Font
use Libraries.Game.GameStateManager
use Libraries.System.File
use Libraries.Development.Environment.Studio.Mobile.SendProgress

class OutputTab is Tab
    TextBox box = undefined
    Array<text> lines
    boolean empty = false
    Behaviors behaviors

    // How tall the input row is, before the interface scale.
    constant integer INPUT_ROW_HEIGHT = 40

    // The toolbar's icon font, for the send button's arrow.
    Font iconFont

    // A send's checklist above the output (SendProgressPanel), and the
    // build lines it hides until Show details.
    SendProgressPanel progressPanel
    Array<text> detailLines
    boolean detailsShown = false
    // Whether a send's checklist is up. Build lines only count while it is.
    boolean sending = false
    integer panelHeight = 0
    LayoutProperties outputLayout = undefined
    // The Console area the checklist and output are laid out in.
    Control consoleArea = undefined
 
    action SetTextBox(TextBox box)
        me:box = box
    end

    action GetTextBox returns TextBox
        return box
    end

    action GetBehaviors returns Behaviors
        return behaviors
    end

    action SetBehaviors(Behaviors behaviors)
        me:behaviors = behaviors
    end

    action GainedFocus(FocusEvent event)
        if box not= undefined
            box:Focus()
        end
    end
    action Empty
        empty = true
        // A finished send's checklist goes with the old output. A send in
        // progress keeps it: sending clears the Console after it starts.
        if progressPanel:ClearIfFinished()
            detailLines:Empty()
            detailsShown = false
        end
    end

    action Append(text line)
        lines:Add(line + line:GetLineFeed())
    end

    /*
        Adds a build line that is hidden while a send's checklist shows,
        unless Show details was chosen.
    */
    action AppendDetail(text line)
        if not sending
            return now
        end
        if detailsShown
            Append(line)
        else
            detailLines:Add(line)
        end
    end

    // Shows a send's checklist; its build lines start hidden.
    action ShowProgress(SendProgress progress)
        detailLines:Empty()
        detailsShown = false
        sending = true
        progressPanel:SetProgress(progress, me)
    end

    /*
        Ends a send's checklist: its hidden build lines are dropped and the
        Console gets one line saying how it went.
    */
    action EndProgress(text summary)
        sending = false
        detailLines:Empty()
        detailsShown = false
        Append(summary)
    end

    // Puts the hidden build lines into the output, and the next ones too.
    action ShowDetails
        if detailsShown
            return now
        end
        detailsShown = true
        integer index = 0
        repeat while index < detailLines:GetSize()
            Append(detailLines:Get(index))
            index = index + 1
        end
        detailLines:Empty()
    end

    // The steps show again: the build lines that come next are held back.
    action HideDetails
        detailsShown = false
    end

    action Setup
        Control outputPanel
        Color color
        LayoutProperties outputPanelLayout = outputPanel:GetDefaultLayoutProperties()
        outputPanelLayout:SetPercentageX(0)
        outputPanelLayout:SetPercentageY(0)
        outputPanelLayout:SetPercentageWidth(1)
        outputPanelLayout:SetPercentageHeight(1)

        FlowLayout flow
        outputPanel:SetLayout(flow)
        consoleArea = outputPanel
        // The checklist above the output is hidden between sends.
        flow:SetIgnoreHidden(true)

        TextBox textBoxForConsoleOutput  
        //textBoxForConsoleOutput:SetBackgroundColor(color:White())
        textBoxForConsoleOutput:GetTextBoxEditManager():SetOff(true)
        textBoxForConsoleOutput:SetText("Welcome to Quorum Studio!")
        textBoxForConsoleOutput:SetMoveFocusOnTab(true)
        textBoxForConsoleOutput:SetName("Console output")

        // The output takes the pane's height, less the input row's.
        LayoutProperties textBoxPanelLayout = textBoxForConsoleOutput:GetDefaultLayoutProperties()
        textBoxPanelLayout:SetPercentageWidth(1)
        textBoxPanelLayout:SetPercentageHeight(1)
        textBoxPanelLayout:SetPixelHeight(-INPUT_ROW_HEIGHT)
        outputLayout = textBoxPanelLayout

        TextBox inputTextBoxForOutputPane
        inputTextBoxForOutputPane:SetName("Input Text Box")

        // Inside the row: the width the prompt and the send button leave.
        LayoutProperties textBoxPanelLayoutForInput = inputTextBoxForOutputPane:GetDefaultLayoutProperties()
        textBoxPanelLayoutForInput:SetPercentageWidth(1)
        textBoxPanelLayoutForInput:SetPixelWidth(-64)
        textBoxPanelLayoutForInput:SetPercentageHeight(1)
        Color clear
        clear:SetColor(0, 0, 0, 0)
        inputTextBoxForOutputPane:SetBackgroundColor(clear)
        inputTextBoxForOutputPane:SetBorderThickness(0)

        //inputTextBoxForOutputPane:SetBackgroundColor(color:White())
        inputTextBoxForOutputPane:GetTextBoxEditManager():SetOff(true)
        inputTextBoxForOutputPane:SetMoveFocusOnTab(true)
        InputBehavior behavior = behaviors:GetInputBehavior()

        //input box will send on ENTER and newLine on SHIFT+ENTER
        KeyboardEvent keys
        InputSet enterSet
        enterSet:SetKeyboardInput(keys:ENTER)
        
        InputSet numEnterSet
        numEnterSet:SetKeyboardInput(keys:NUMPAD_ENTER)

        InputSet shiftEnterSet
        shiftEnterSet:SetKeyboardInput(keys:ENTER)
        shiftEnterSet:AddModifier(shiftEnterSet:SHIFT)

//        InputSet shiftNumEnterSet
//        numEnterSet:SetKeyboardInput(keys:NUMPAD_ENTER)
//        shiftNumEnterSet:AddModifier(shiftNumEnterSet:SHIFT)

        TextBoxNewLineBehavior newLine
        InputTable table = inputTextBoxForOutputPane:CopyAndActivateInputTable("InputBox")
        inputTextBoxForOutputPane:SetInputGroup("InputBox")
        table:Add(enterSet, behavior)
        table:Add(numEnterSet, behavior)
        table:Add(shiftEnterSet, newLine)
//        table:Add(shiftNumEnterSet, newLine)
        
        
        // A round button with an up arrow, in the accent color.
        File iconFile
        iconFile:SetPath("Resources/Fonts/Font Awesome 6 Free-Solid-900.otf")
        iconFont:LoadFont(iconFile)
        text arrow = ""
        // Font Awesome's arrow-up (f062).
        arrow = arrow:GetUnicodeValue(61538)

        GameStateManager gameState
        InterfaceOptions options = gameState:GetInterfaceOptions()

        Button sendButtonOutputPane
        LayoutProperties buttonProperties = sendButtonOutputPane:GetDefaultLayoutProperties()
        buttonProperties:SetHorizontalLayoutMode(buttonProperties:STANDARD)
        buttonProperties:SetVerticalLayoutMode(buttonProperties:STANDARD)
        // A little smaller than the row's 28, so it sits inside the field.
        buttonProperties:SetPixelWidth(22)
        buttonProperties:SetPixelHeight(22)
        buttonProperties:SetRightMargin(4)
        // The name first: Button:SetName also sets the label text.
        sendButtonOutputPane:SetName("Send")
        sendButtonOutputPane:SetFont(iconFont)
        sendButtonOutputPane:SetFontSize(14)
        sendButtonOutputPane:SetLabelText(arrow)
        sendButtonOutputPane:SetBackgroundColor(options:GetSelectionColor())
        sendButtonOutputPane:SetFontColor(options:GetSelectionFontColor())
        sendButtonOutputPane:SetBorderThickness(0)
        sendButtonOutputPane:SetTopLeftRounding(1.0)
        sendButtonOutputPane:SetTopRightRounding(1.0)
        sendButtonOutputPane:SetBottomLeftRounding(1.0)
        sendButtonOutputPane:SetBottomRightRounding(1.0)
        sendButtonOutputPane:SetDescription("Sends the input to your program. Enter does the same.")

        // The input row (C3): one rounded field with a ">" prompt, the input,
        // and the send button. It is a fixed height, so it is the same size
        // however tall the pane is.
        Control inputRow
        ControlShaderView rowView
        rowView:Initialize()
        inputRow:SetView2D(rowView)
        inputRow:SetInterfaceOptionsKey("TextField")
        inputRow:SetTopLeftRounding(1.0)
        inputRow:SetTopRightRounding(1.0)
        inputRow:SetBottomLeftRounding(1.0)
        inputRow:SetBottomRightRounding(1.0)
        // Not single line: FlowLayout's vertical centering needs the line's
        // bottom, which it only tracks when lines can wrap. The row's widths
        // fit on one line.
        FlowLayout rowLayout
        rowLayout:SetVerticalCentering(true)
        inputRow:SetLayout(rowLayout)
        LayoutProperties rowProperties = inputRow:GetDefaultLayoutProperties()
        rowProperties:SetPercentageWidth(1)
        rowProperties:SetPixelHeight(INPUT_ROW_HEIGHT - 12)
        rowProperties:SetLeftMargin(6)
        rowProperties:SetRightMargin(6)
        rowProperties:SetTopMargin(6)
        rowProperties:SetBottomMargin(6)
        inputRow:SetName("Input")

        // Sized like other control labels (from the bottom of its descent),
        // so the row's vertical centering centers it.
        Label prompt
        prompt:SetPositionOnBaseLine(false)
        prompt:SetText(">")
        prompt:SetFontColor(options:GetSelectionColor())
        prompt:SetColor(options:GetSelectionColor())
        prompt:SetLeftMargin(12)
        prompt:SetRightMargin(6)
        prompt:SetAccessibilityCode(prompt:parent:Item:NOT_ACCESSIBLE)

        //Set the focus system up for these controls
        sendButtonOutputPane:SetNextFocus(textBoxForConsoleOutput)
        sendButtonOutputPane:SetPreviousFocus(inputTextBoxForOutputPane)
        inputTextBoxForOutputPane:SetNextFocus(sendButtonOutputPane)
        inputTextBoxForOutputPane:SetPreviousFocus(textBoxForConsoleOutput)
        textBoxForConsoleOutput:SetNextFocus(inputTextBoxForOutputPane)
        textBoxForConsoleOutput:SetPreviousFocus(sendButtonOutputPane)

        //setup some behaviors
        behavior:SetInputTextBox(inputTextBoxForOutputPane)
        sendButtonOutputPane:SetBehavior(behavior)

        inputRow:Add(prompt)
        inputRow:Add(inputTextBoxForOutputPane)
        inputRow:Add(sendButtonOutputPane)

        outputPanel:Add(progressPanel)
        outputPanel:Add(textBoxForConsoleOutput)
        outputPanel:Add(inputRow)
        
        SetTextBox(textBoxForConsoleOutput)
        SetFocusTarget(textBoxForConsoleOutput)
        SetName("Console")
        SetRelatedItem(outputPanel)
        DisplayCloseButton(true)
    end

    action Update(number seconds)
        // The checklist takes room above the output while it shows.
        integer height = progressPanel:Refresh()
        if height not= panelHeight and outputLayout not= undefined and box not= undefined
            panelHeight = height
            progressPanel:SetPixelHeight(height)
            outputLayout:SetPixelHeight(-INPUT_ROW_HEIGHT - height)
            // The whole Console area, so the checklist gets its place above
            // the output, and not just the output's new height.
            if consoleArea not= undefined
                consoleArea:RequestLayout()
            end
        end

        if empty
            box:Empty()
            empty = false
        end

        if not lines:IsEmpty()
            i = 0
            text append = ""
            repeat while i < lines:GetSize()
                append = append + lines:Get(i)
                i = i + 1
            end

            box:SetText(box:GetText() + append)
            lines:Empty()
        end
    end
end