package Libraries.Development.Environment.Studio

use Libraries.Interface.Layouts.Layout
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Views.ImageControlView
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Button
use Libraries.Interface.Views.LabelBoxView
use Libraries.Development.Environment.Resources
use Libraries.Game.Graphics.Gradient
use Libraries.Game.Graphics.Color
use Libraries.Development.Environment.Studio.Behaviors.Behaviors
use Libraries.Game.Graphics.Texture
use Libraries.Interface.Item2D
use Libraries.Interface.Events.FocusEvent
use Libraries.Containers.Array
use Libraries.Interface.Layouts.ToolbarLayout
use Libraries.Interface.Controls.Control
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Controls.Icon
use Libraries.Interface.Controls.ToolBar
use Libraries.Game.Graphics.Font
use Libraries.Game.Graphics.Glyph
use Libraries.Game.Graphics.TextureRegion
use Libraries.Game.Graphics.Drawable
use Libraries.System.File
use Libraries.Development.Environment.Studio.Interface.KeyMap
use Libraries.Containers.HashTable
use Libraries.Development.Environment.Configuration.OptionsConstants
use Libraries.Game.GameStateManager
use Libraries.Interface.Options.InterfaceOptions
use Libraries.Game.Graphics.ColorGroup
use Libraries.Interface.Controls.CharacterIcon
use Libraries.Interface.Views.ControlShaderView

class Toolbar is ToolBar
    Layout layout = undefined
    Resources resources = undefined
    Color color
    number height = 0
    Behaviors behaviors = undefined
    KeyMap keymap = undefined
    Array<Button> buttons
    HashTable<text, Button> buttonMap
    Font fontAwesome
    OptionsConstants const
    Color transparent

    // The size of Run's and Debug's words; SetFontSize sets the icons' size.
    constant integer LABEL_FONT_SIZE = 14

    // The font size Run's and Debug's icons are made at, before the
    // interface scale: about a capital letter of LABEL_FONT_SIZE.
    constant integer LABEL_ICON_SIZE = 12

    // How tall Run and Debug are, before the interface scale. Each one's
    // icon is centered in this at the size it was made.
    constant integer LABELED_BUTTON_HEIGHT = 24
    // How much darker Run and Debug get under the mouse.
    constant number HOVER_SHADE = 0.85

    // Run and Debug, whose text keeps LABEL_FONT_SIZE when SetFontSize
    // changes the icons.
    Array<Button> labeledButtons
    // Run's and Debug's icon characters, in the order of labeledButtons.
    Array<integer> labeledCharacters
        
    on create
        SetFocusable(true)
        File file
        file:SetPath("Resources/Fonts/Font Awesome 6 Free-Solid-900.otf")
        fontAwesome:LoadFont(file)

        SetFont(fontAwesome)
        // Icon size. Run and Debug use LABEL_FONT_SIZE for their text.
        SetFontSize(22)
        LayoutProperties properties = GetDefaultLayoutProperties()
        SetVerticalLayoutMode(properties:FIT_CONTENTS)
        transparent:SetAlpha(0.0)
    end

    action SetFontSize(integer size)
        parent:Control:SetFontSize(size)
        integer counter = 0
        repeat while counter < buttons:GetSize()
            Button button = buttons:Get(counter)
            if labeledButtons:GetFirstLocation(button) < 0
                button:SetFontSize(size)
            end
            counter = counter + 1
        end
    end

    action GainedFocus(FocusEvent event)
        if buttons:GetSize() > 0
            Button first = buttons:Get(0)
            first:Focus()
        end
    end

    action SetBehaviors(Behaviors behaviors)
        me:behaviors = behaviors
    end

    action GetBehaviors returns Behaviors
        return behaviors
    end

    action GetResources returns Resources
        return resources
    end

    action SetResources(Resources resources)
        me:resources = resources
        me:keymap = resources:GetKeyMap()
    end

    action GetPreviousFocus returns Item
        return parent:Item:GetPreviousFocus()
    end

    action GetNextFocus returns Item
        return parent:Item:GetNextFocus()
    end

    action Setup
        // Files
        AddButtonToToolbar(61892, const:TOOLBAR_FILE_ICON_COLOR, behaviors:GetOpenNewProjectBehavior(), "New Project", keymap:GetNewProjectKey():GetDisplayName())
        AddButtonToToolbar(61897, const:TOOLBAR_FILE_ICON_COLOR, behaviors:GetOpenNewFileBehavior(), "New File", keymap:GetNewFileKey():GetDisplayName())
        AddButtonToToolbar(61564, const:TOOLBAR_FILE_ICON_COLOR, behaviors:GetOpenProjectBehavior(), "Open Project", keymap:GetOpenProjectKey():GetDisplayName())
        AddButtonToToolbar(61639, const:TOOLBAR_FILE_ICON_COLOR, behaviors:GetSaveAllBehavior(), "Save All", keymap:GetSaveAllKey():GetDisplayName())
        AddSeparator()
        // Undo and redo
        AddButtonToToolbar(61666, const:TOOLBAR_EDIT_ICON_COLOR, behaviors:GetUndoBehavior(), "Undo", keymap:GetUndoKey():GetDisplayName())
        AddButtonToToolbar(61470, const:TOOLBAR_EDIT_ICON_COLOR, behaviors:GetRedoBehavior(), "Redo", keymap:GetRedoKey():GetDisplayName())
        AddSeparator()
        // Build and run
        AddButtonToToolbar(63203, const:TOOLBAR_BUILD_ICON_COLOR, behaviors:GetThreadedBuildProjectBehavior(), "Build", keymap:GetBuildKey():GetDisplayName())
        AddButtonToToolbar(57450, const:TOOLBAR_BUILD_ICON_COLOR, behaviors:GetThreadedCleanBuildProjectBehavior(), "Clean and Build", keymap:GetCleanBuildKey():GetDisplayName())
        AddLabeledButtonToToolbar(61515, "Run", const:TOOLBAR_RUN_FILL_COLOR, behaviors:GetThreadedRunProjectBehavior(), "Run", keymap:GetRunKey():GetDisplayName())
        AddSeparator()
        // Debugging. Stop keeps its red: it is the one way to stop a program.
        AddLabeledButtonToToolbar(61832, "Debug", const:TOOLBAR_DEBUG_FILL_COLOR, behaviors:GetThreadedDebugProjectBehavior(), "Debug", keymap:GetDebugKey():GetDisplayName())
        AddButtonToToolbar(61517, const:TOOLBAR_STOP_BUTTON_COLOR, behaviors:GetThreadedStopBehavior(), "Stop", keymap:GetStopKey():GetDisplayName())
        AddButtonToToolbar(61516, const:TOOLBAR_STEP_ICON_COLOR, behaviors:GetThreadedPauseBehavior(), "Pause", keymap:GetPauseKey():GetDisplayName())
        AddButtonToToolbar(61520, const:TOOLBAR_STEP_ICON_COLOR, behaviors:GetThreadedContinueBehavior(), "Continue", keymap:GetContinueKey():GetDisplayName())
        AddButtonToToolbar(61537, const:TOOLBAR_STEP_ICON_COLOR, behaviors:GetThreadedStepOverBehavior(), "Step Over", keymap:GetStepOverKey():GetDisplayName())
        AddButtonToToolbar(61769, const:TOOLBAR_STEP_ICON_COLOR, behaviors:GetThreadedStepIntoBehavior(), "Step Into", keymap:GetStepIntoKey():GetDisplayName())
        AddButtonToToolbar(61768, const:TOOLBAR_STEP_ICON_COLOR, behaviors:GetThreadedStepOutBehavior(), "Step Out", keymap:GetStepOutKey():GetDisplayName())
        SetupButtonFocus()
    end

    action SetupButtonFocus
        i = 0
        repeat while i < buttons:GetSize()
            Button button = buttons:Get(i)
            if i + 1 < buttons:GetSize()
                Button next = buttons:Get(i+1)
                button:SetNextFocus(next)
                next:SetPreviousFocus(button)
            end
            i = i + 1
        end

        Button first = buttons:Get(0)
        Button last = buttons:Get(buttons:GetSize() - 1)
        first:SetPreviousFocus(last)
        last:SetNextFocus(first)

        SetNextFocus(first)
        SetPreviousFocus(last)
    end

    private action AddButtonToToolbar(integer unicode, text optionsKey, Behavior behavior, text name, text description)
        Button button
        button:SetFont(fontAwesome)
        button:SetFontSize(GetFontSize())
        text value = ""
        value = value:GetUnicodeValue(unicode)
        GameStateManager manager
        InterfaceOptions options = manager:GetInterfaceOptions()
        ColorGroup co = options:GetColorProperty(optionsKey)
        // A theme without the group colors uses the one icon color.
        if co = undefined
            co = options:GetColorProperty(const:TOOLBAR_ICON_COLOR)
        end
        if co not= undefined
            Color co2 = cast(Color, co)
            button:SetFontColor(co2)
        end

        ColorGroup bg = options:GetColorProperty(const:TOOLBAR_BUTTON_BACKGROUND_COLOR)
        if bg not= undefined
            
            
            //button:SetBackgroundColor(color:Black())
        end
        
        button:SetBackgroundColor(transparent)
        button:SetBorderThickness(0)
        // Toolbar buttons are icons on the bar, not raised buttons.
        button:SetTopAccent(false)
        button:SetRaised(false)
        ColorGroup hover = options:GetColorProperty(const:TOOLBAR_HOVER_COLOR)
        if hover not= undefined
            button:SetMouseOverColor(hover)
        end
        button:SetTopLeftRounding(0.3)
        button:SetTopRightRounding(0.3)
        button:SetBottomLeftRounding(0.3)
        button:SetBottomRightRounding(0.3)
        // Raised a little: Font Awesome's glyphs sit low for their line,
        // next to Run's and Debug's centered icons and words.
        button:SetTopMargin(1)
        button:SetBottomMargin(3)
        button:SetLeftMargin(5)
        button:SetName(name)
        button:SetLabelText(value)
        button:SetDescription(description)

        if behavior not= undefined
            button:SetBehavior(behavior)
        end
        Add(button)
        buttons:Add(button)

        buttonMap:Add(name, button)
    end

    /*
    Adds a filled button with an icon and a word, for the two actions used
    most (Run and Debug). The icon is the Font Awesome glyph; the word is in
    the default font.
    */
    private action AddLabeledButtonToToolbar(integer unicode, text label, text fillKey, Behavior behavior, text name, text description)
        Button button
        // The name first: Button:SetName also sets the label text.
        button:SetName(name)
        Font labelFont = button:GetDefaultFont()
        if labelFont not= undefined
            button:SetFont(labelFont)
        end
        button:SetFontSize(LABEL_FONT_SIZE)
        button:SetLabelText(label)

        // The icon is made from its own copy of the icon font, at about the
        // height of a capital letter of the word. The shared font is at its
        // default size when the toolbar is set up, and its size changes as
        // the other buttons draw.
        LoadLabeledIcon(button, unicode, GetInterfaceScale())

        /*
        Run and Debug share one fixed height. Each one's top and bottom
        padding is whatever is left around its own icon, so ButtonLayout (which
        makes the icon the button's height less the padding) draws the icon at
        the size it was made. A scaled icon is smoothed with Vulkan's repeating
        2D sampler, which blends its edge with the opposite edge: a faint line
        beside Run's triangle. A fixed height also avoids ButtonLayout sizing
        the icon before a font-fitted button has its full height. The word
        stays centered: one-line labels are centered on their letters, not
        their padding.
        */
        // Filled, but flat like the rest of the toolbar.
        button:SetTopAccent(false)
        button:SetRaised(false)
        LayoutProperties labeledProperties = button:GetDefaultLayoutProperties()
        labeledProperties:SetVerticalLayoutMode(labeledProperties:STANDARD)
        labeledProperties:SetPixelHeight(LABELED_BUTTON_HEIGHT)

        GameStateManager manager
        InterfaceOptions options = manager:GetInterfaceOptions()
        Color white
        white:SetColor(1, 1, 1, 1)
        ColorGroup fill = options:GetColorProperty(fillKey)
        if fill not= undefined
            button:SetBackgroundColor(fill)
            // Run and Debug keep their color when focused: the control
            // shader draws a focused control in its focus color instead.
            button:SetFocusColor(fill)
            // A hover a little darker than the fill, so the white word and
            // icon still read. The theme's own hover is near white in light
            // mode.
            if fill is Color
                Color fillColor = cast(Color, fill)
                Color hover
                hover:SetColor(fillColor:GetRed() * HOVER_SHADE, fillColor:GetGreen() * HOVER_SHADE, fillColor:GetBlue() * HOVER_SHADE, 1)
                button:SetMouseOverColor(hover)
            end
        end
        button:SetFontColor(white)
        button:SetIconColor(white)
        button:SetBorderThickness(0)
        button:SetTopLeftRounding(0.3)
        button:SetTopRightRounding(0.3)
        button:SetBottomLeftRounding(0.3)
        button:SetBottomRightRounding(0.3)
        button:SetLeftMargin(6)
        button:SetRightMargin(2)
        // Lines the box's top up with the tops of the icons beside it.
        button:SetTopMargin(8)
        button:SetDescription(description)
        if behavior not= undefined
            button:SetBehavior(behavior)
        end

        Add(button)
        buttons:Add(button)
        labeledButtons:Add(button)
        labeledCharacters:Add(unicode)
        buttonMap:Add(name, button)
    end

    /*
    Makes a labeled button's icon for an interface scale: Font Awesome at
    about a capital letter of the word, and the top and bottom padding that
    centers it in LABELED_BUTTON_HEIGHT, so ButtonLayout draws it at the
    size it was made.
    */
    private action LoadLabeledIcon(Button button, integer unicode, number scale)
        Font glyphFont = fontAwesome:Copy()
        glyphFont:SetSize(cast(integer, LABEL_ICON_SIZE * scale + 0.5))
        CharacterIcon glyph
        glyph:LoadCharacter(unicode, glyphFont)
        button:SetIcon(glyph)
        number glyphHeight = glyph:GetRegionHeight() / scale
        number inset = (LABELED_BUTTON_HEIGHT - glyphHeight) / 2.0
        if inset < 0
            inset = 0
        end
        button:SetTopPadding(inset)
        button:SetBottomPadding(inset)
    end

    // The toolbar is set up at scale 1, before it is added; Run's and
    // Debug's icons are made again for each new scale.
    action SetInterfaceScale(number scale)
        boolean changed = scale not= GetInterfaceScale()
        parent:Control:SetInterfaceScale(scale)
        if changed
            integer index = 0
            repeat while index < labeledButtons:GetSize()
                LoadLabeledIcon(labeledButtons:Get(index), labeledCharacters:Get(index), scale)
                index = index + 1
            end
        end
    end

    // A thin line between groups of buttons. It isn't a button, so it isn't
    // focused and screen readers skip it.
    private action AddSeparator
        GameStateManager manager
        InterfaceOptions options = manager:GetInterfaceOptions()
        Control separator
        ControlShaderView view
        view:Initialize()
        separator:SetView2D(view)
        ColorGroup lineColor = options:GetColorProperty(const:TOOLBAR_SEPARATOR_COLOR)
        if lineColor not= undefined
            separator:SetBackgroundColor(lineColor)
        end
        separator:SetPixelWidth(1)
        separator:SetPixelHeight(22)
        separator:SetTopMargin(7)
        separator:SetLeftMargin(8)
        separator:SetRightMargin(4)
        separator:SetName("Separator")
        separator:SetAccessibilityCode(separator:parent:Item:NOT_ACCESSIBLE)
        Add(separator)
    end

    action GetButton(text name) returns Button
        if buttonMap:HasKey(name)
            return buttonMap:GetValue(name)
        else
            return undefined
        end
    end
end
