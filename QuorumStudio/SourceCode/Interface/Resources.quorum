    Texture projectLogo
    Texture projectLogoDark
    Texture projectLogoLight
    Texture quorumFile
    Texture quorumFileLight
    Texture quorumFileDark
    Texture mainFile
    Texture mainFileLight
    Texture mainFileDark
    Texture folderImage
    Texture folderLight
    Texture folderDark
    Texture breakpointImage

    File applicationIcon

    //toolbar textures
