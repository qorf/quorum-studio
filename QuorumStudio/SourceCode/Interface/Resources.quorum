    Texture pause
    Texture continue
    Texture stepOver
    Texture stepInto
    Texture stepOut

    Texture gridTexture
    Texture lightTexture = undefined
    Texture audio3DTexture = undefined

    //colors
    Color backgroundColor
    
    Options options = undefined
    KeyMapLoader keyMap
    HashTable<text, Texture> textures

    /*
        For textures in the interface options instead of hard coded for a style,
        any loaded textures can be queried from this action. Hard coded resources
        are not in this hash.
    */
    action GetTexture(text key) returns Texture
        if textures:HasKey(key)
            return textures:GetValue(key)
        end
        return undefined
    end

    action GetOptions returns Options
        return options
    end
    
    action SetOptions(Options options)
        me:options = options
        keyMap:SetOptions(options)
    end

    action GetKeyMap returns KeyMap
        return keyMap
    end

    action Load
        //project logo
        projectLogo:LoadFromFile(PROJECT_LOGO)
        projectLogoDark:LoadFromFile(PROJECT_LOGO_DARK)
        projectLogoLight:LoadFromFile(PROJECT_LOGO_LIGHT)
        textures:Add(PROJECT_LOGO_DARK, projectLogoDark)
        textures:Add(PROJECT_LOGO_LIGHT, projectLogoLight)

        //non main file
        quorumFile:LoadFromFile(QUORUM_FILE)
        quorumFileLight:LoadFromFile(QUORUM_FILE_LIGHT)
        quorumFileDark:LoadFromFile(QUORUM_FILE_DARK)
        textures:Add(QUORUM_FILE_LIGHT, quorumFileLight)
        textures:Add(QUORUM_FILE_DARK, quorumFileDark)

        //main file
        mainFile:LoadFromFile(MAIN_FILE)
        mainFileLight:LoadFromFile(MAIN_FILE_LIGHT)
        mainFileDark:LoadFromFile(MAIN_FILE_DARK)
        textures:Add(MAIN_FILE_LIGHT, mainFileLight)
        textures:Add(MAIN_FILE_DARK, mainFileDark)

        //folder
        folderImage:LoadFromFile(FOLDER)
        folderLight:LoadFromFile(FOLDER_LIGHT)
        folderDark:LoadFromFile(FOLDER_DARK)
        textures:Add(FOLDER_LIGHT, folderLight)
        textures:Add(FOLDER_DARK, folderDark)

        // Icons for CSV, JSON, glTF, OBJ, scene, zip, PNG, JPEG and G-code
        // files, light and dark.
        LoadIconTexture(CSV_FILE_LIGHT)
        LoadIconTexture(CSV_FILE_DARK)
        LoadIconTexture(JSON_FILE_LIGHT)
        LoadIconTexture(JSON_FILE_DARK)
        LoadIconTexture(GLTF_FILE_LIGHT)
        LoadIconTexture(GLTF_FILE_DARK)
        LoadIconTexture(OBJ_FILE_LIGHT)
        LoadIconTexture(OBJ_FILE_DARK)
        LoadIconTexture(SCENE_FILE_LIGHT)
        LoadIconTexture(SCENE_FILE_DARK)
        LoadIconTexture(ZIP_FILE_LIGHT)
        LoadIconTexture(ZIP_FILE_DARK)
        LoadIconTexture(PNG_FILE_LIGHT)
        LoadIconTexture(PNG_FILE_DARK)
        LoadIconTexture(JPG_FILE_LIGHT)
        LoadIconTexture(JPG_FILE_DARK)
        LoadIconTexture(GCODE_FILE_LIGHT)
        LoadIconTexture(GCODE_FILE_DARK)

        breakpointImage:LoadFromFile(BREAKPOINT)

        applicationIcon:SetPath(APPLICATION_ICON)

        //toolbar
        newProject:LoadFromFile(NEW_PROJECT)
        newFile:LoadFromFile(NEW_FILE)
        openProject:LoadFromFile(OPEN_PROJECT)
        saveAll:LoadFromFile(SAVE_ALL)
        undo:LoadFromFile(UNDO)
        redo:LoadFromFile(REDO)
        build:LoadFromFile(BUILD)
        cleanAndBuild:LoadFromFile(CLEAN_AND_BUILD)
        run:LoadFromFile(RUN)
        debug:LoadFromFile(DEBUG)
        stop:LoadFromFile(STOP)
        pause:LoadFromFile(PAUSE)
        continue:LoadFromFile(CONTINUE)
        stepOver:LoadFromFile(STEP_OVER)
        stepInto:LoadFromFile(STEP_INTO)
        stepOut:LoadFromFile(STEP_OUT)

        gridTexture:LoadFromFile(GRID_TEXTURE)

        backgroundColor:SetColor(226.0/255.0, 226.0/255.0, 226.0/255.0, 1)
        keyMap:Setup()
    end

    action GetUserAccountControlBatch returns File
        File file
        file:SetPath(USER_ACCOUNT_CONTROL)
        return file
    end

    action GetBackgroundColor returns Color
        return backgroundColor
    end

    action GetProjectLogo returns Icon
        Icon icon
        icon:Load(projectLogo)
        return icon
    end

    action GetQuorumFile returns Icon
        Icon icon
        icon:Load(quorumFile)
        return icon
    end

    // Loads a texture and keeps it under its path, for GetTexture.
    private action LoadIconTexture(text path)
        Texture texture
        texture:LoadFromFile(path)
        textures:Add(path, texture)
    end

    /*
        The interface options key of the icon for a file's kind:
        CSV_FILE_ICON, JSON_FILE_ICON, GLTF_FILE_ICON (.gltf and .glb),
        OBJ_FILE_ICON, SCENE_FILE_ICON (.qs), ZIP_FILE_ICON, PNG_FILE_ICON,
        JPG_FILE_ICON (.jpg and .jpeg), GCODE_FILE_ICON, or "" for any other
        file.
    */
    action GetFileTypeIconKey(File file) returns text
        OptionsConstants constants
        if file = undefined
            return ""
        end
        text extension = file:GetFileExtension()
        extension = extension:ToLowerCase()
        if extension = "csv"
            return constants:CSV_FILE_ICON
        elseif extension = "json"
            return constants:JSON_FILE_ICON
        elseif extension = "gltf" or extension = "glb"
            return constants:GLTF_FILE_ICON
        elseif extension = "obj"
            return constants:OBJ_FILE_ICON
        elseif extension = "qs"
            return constants:SCENE_FILE_ICON
        elseif extension = "zip"
            return constants:ZIP_FILE_ICON
        elseif extension = "png"
            return constants:PNG_FILE_ICON
        elseif extension = "jpg" or extension = "jpeg"
            return constants:JPG_FILE_ICON
        elseif extension = "gcode"
            return constants:GCODE_FILE_ICON
        end
        return ""
    end

    /*
        The icon for a file that isn't Quorum code, in the current theme,
        for the project tree and tabs; the Quorum file icon for other files.
    */
    action GetFileTypeIcon(File file) returns Icon
        text key = GetFileTypeIconKey(file)
        if key = ""
            return GetQuorumFile()
        end
        GameStateManager manager
        InterfaceOptions io = manager:GetInterfaceOptions()
        Texture texture = undefined
        if io not= undefined
            text path = io:GetCustomProperty(key)
            if path not= undefined
                texture = GetTexture(path)
            end
        end
        if texture = undefined
            return GetQuorumFile()
        end
        Icon icon
        icon:Load(texture)
        return icon
    end

