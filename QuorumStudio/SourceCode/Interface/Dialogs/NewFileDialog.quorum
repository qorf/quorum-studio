use Libraries.Interface.Events.KeyboardEvent
use Libraries.Interface.Selections.TreeSelection
use Libraries.Containers.HashTable
use Libraries.Development.Environment.Studio.CodeEditorTabPane
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Options.InterfaceOptions
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Forms.FormConstants
use Libraries.Interface.Controls.RadioButton
use Libraries.Interface.Events.TextChangeListener
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Game.Graphics.ColorGroup
use Libraries.Development.Environment.Studio.Behaviors.NewFileTypeBehavior


/*
New File and New Folder. New File makes a Quorum file or a scene (the Type
choice). Each type has its own folder, SourceCode or Scenes: the location
starts there, or in the folder chosen in the Project Tree, and follows the
type while it's still one of those two folders. The line under the location
says what will be made, and warns when a file is in the other type's folder.
*/
class NewFileDialog is Dialog, TextChangeListener

    boolean initialized = false 

    GameStateManager gameManager
    QuorumStudio studio = cast(QuorumStudio, gameManager:GetGame())
    text os = gameManager:GetOperatingSystem()
    // The current Quorum project that we're modifying the properties of.
    // Set during the SetProperties(QuorumProject) action.
    QuorumProject project = undefined   
    ProjectManager manager = undefined
    text projectName = ""
    
    //Variables for the NewFile Dialog
    TextField fileNameField
    TextField locationNameField
    Button browseButton
    Button okayButton
    Button cancelButton
    
    //Behaviors used by the Browse, Ok, and Cancel Buttons
    DialogCancelBehavior cancelBehavior
    NewFileOkBehavior okayBehavior
    OpenBrowseFoldersBehavior browseBehavior
    boolean isFolder = false

    // The Type choice (New File only), and the line under the location.
    RadioButton quorumTypeButton = undefined
    RadioButton sceneTypeButton = undefined
    Label hintLabel = undefined
    NewFileTypeBehavior typeBehavior
    boolean sceneType = false

    constant text SCENES_FOLDER = "Scenes"
    constant text SCENE_EXTENSION = "qs"
    constant text QUORUM_EXTENSION = "quorum"
    // An empty scene, copied for each new one. The path is from Studio's
    // folder, where its templates are.
    constant text BLANK_SCENE = "Templates/Scenes/Blank/Scenes/Scene.qs"

    on create
        cancelBehavior:SetDialog(me)
        okayBehavior:SetDialog(me)
        browseBehavior:SetDialog(me) 
        typeBehavior:SetDialog(me)
        SetBehavior(okayBehavior)
    end

    action Initialize

        initialized = true

        if IsFolder()
            SetName("New Folder")
        else
            SetName("New File")
        end
        // As tall as its rows, and half the window wide between 420 and 640
        // points, so it fits at any zoom and in a narrow window.
        SetFitToContents(true)
        SetFitWidth(0.5, 420, 640)

        CreateNewFileControl()
    end

    //sets the folderNameField in the dialog to the default filepath for the
    //project (e.g. GameApplication/SourceCode)
    action SetProperties(QuorumProject project, text displayText)//TreeSelection selection)
        me:project = project
        projectName = project:GetName()
        // Made from the Scenes folder, or a folder in it, it's a scene.
        sceneType = false
        if not IsFolder()
            sceneType = IsInFolder(displayText, SCENES_FOLDER)
            if quorumTypeButton not= undefined
                quorumTypeButton:SetToggleState(not sceneType)
                sceneTypeButton:SetToggleState(sceneType)
            end
        end
        if displayText = "" 
            displayText = DefaultFolder()
        end
        locationNameField:SetText(displayText)
        UpdateHint()
    end

    // The folder the chosen type goes in, with a separator after it.
    private action DefaultFolder returns text
        if sceneType
            return SCENES_FOLDER + Separator()
        end
        return project:PROJECT_SOURCES + Separator()
    end

    // The separator the rest of this dialog uses.
    private action Separator returns text
        if os:Contains("OS X")
            return "/"
        end
        return "\"
    end

    // Whether a location is the folder, or a folder in it.
    private action IsInFolder(text location, text folder) returns boolean
        text value = location:Trim()
        if value:EqualsIgnoringCase(folder)
            return true
        end
        text lower = value:ToLowerCase()
        text start = folder:ToLowerCase()
        return lower:StartsWith(start + "/") or lower:StartsWith(start + "\")
    end

    // Whether a location is still one of the two types' folders, or empty,
    // so it may follow the type.
    private action IsDefaultLocation(text location) returns boolean
        text value = location:Trim()
        if value = "" or value = projectName
            return true
        end
        text sources = project:PROJECT_SOURCES
        if value:EqualsIgnoringCase(sources) or value:EqualsIgnoringCase(sources + "/") or value:EqualsIgnoringCase(sources + "\")
            return true
        end
        if value:EqualsIgnoringCase(SCENES_FOLDER) or value:EqualsIgnoringCase(SCENES_FOLDER + "/") or value:EqualsIgnoringCase(SCENES_FOLDER + "\")
            return true
        end
        return false
    end

    /*
    This action is called when Quorum File or Scene is chosen. A location
    that's still one of the two types' folders moves to the chosen type's
    folder; one picked by hand stays.
    */
    action TypeChanged
        if sceneTypeButton = undefined
            return now
        end
        sceneType = sceneTypeButton:GetToggleState()
        if project not= undefined and IsDefaultLocation(locationNameField:GetText())
            locationNameField:SetText(DefaultFolder())
        end
        UpdateHint()
    end

    // The name or the location changed: the line under the location follows.
    action TextChanged(TextChangeEvent event)
        UpdateHint()
    end

    /*
    The line under the location: the file that will be made, how to load a
    scene, and a warning when the file is in the other type's folder. It is
    also the location field's description, read when the field is reached.
    */
    private action UpdateHint
        if hintLabel = undefined or project = undefined
            return now
        end
        text name = fileNameField:GetText():Trim()
        text location = locationNameField:GetText():Trim()
        if location = projectName
            location = DefaultFolder()
        end
        if location not= "" and not location:EndsWith("/") and not location:EndsWith("\")
            location = location + Separator()
        end

        text message = ""
        if name = ""
            message = "Type a name for the file."
        else
            text fileName = name
            if not name:Contains(".")
                if sceneType
                    fileName = name + "." + SCENE_EXTENSION
                else
                    fileName = name + "." + QUORUM_EXTENSION
                end
            end
            text madePath = location + fileName
            if sceneType
                text loadPath = madePath:Replace("\", "/")
                message = "Makes " + madePath + ", an empty scene. Load it with LoadScene(" + DoubleQuote() + loadPath + DoubleQuote() + ")."
            else
                message = "Makes " + madePath + "."
            end
        end

        if sceneType and IsInFolder(location, project:PROJECT_SOURCES)
            message = message + " Scenes usually go in " + SCENES_FOLDER + Separator() + "."
        elseif not sceneType and IsInFolder(location, SCENES_FOLDER)
            message = message + " Quorum files usually go in " + project:PROJECT_SOURCES + Separator() + "."
        end

        hintLabel:SetText(message)
        locationNameField:SetDescription(message)
    end

    private action DoubleQuote returns text
        text quote = ""
        return quote:GetDoubleQuote()
    end

    action IsInitialized returns boolean
        return initialized
    end

    action CreateNewFileControl()
        Page createNewFileContainer = InitializeDefaultPage()
        createNewFileContainer:SetSkipLabelsInFocus(true)

        // Quorum File or Scene; New Folder has no type.
        if not IsFolder()
            Label typeLabel = createNewFileContainer:AddLabel("Type")
            // A label before choices isn't made a caption by the page, so
            // it's styled like the others here.
            FormConstants formConstants
            typeLabel:SetFontSize(formConstants:SMALL_FONT_SIZE)
            ColorGroup mutedColor = GetMutedColor()
            if mutedColor not= undefined
                typeLabel:SetFontColor(mutedColor)
            end
            Grouping typeChoices = createNewFileContainer:AddGrouping("File Type")
            typeChoices:SetColumns(2)
            quorumTypeButton = typeChoices:AddRadioButton("Quorum File")
            quorumTypeButton:SetDescription("A file of Quorum code, in SourceCode.")
            quorumTypeButton:SetToggleState(true)
            quorumTypeButton:SetBehavior(typeBehavior)
            sceneTypeButton = typeChoices:AddRadioButton("Scene")
            sceneTypeButton:SetDescription("An empty scene, such as a level, in Scenes. It opens in the scene editor.")
            sceneTypeButton:SetBehavior(typeBehavior)
        end

        createNewFileContainer:AddLabel("Name")
        fileNameField = createNewFileContainer:AddTextField("New File")
        if IsFolder()
            fileNameField:SetName("New Folder Name")
        else
            fileNameField:SetName("New File Name")
        end
        fileNameField:SetText("")

        // The location and its Browse button, on one row beside the label.
        createNewFileContainer:AddLabel("Location")
        Grouping locationGroup = createNewFileContainer:AddGrouping("Location Row")
        locationNameField = locationGroup:AddTextField("Location")
        locationNameField:SetName("Location")
        browseButton = locationGroup:AddButton("Browse...")
        browseButton:SetBehavior(browseBehavior)

        // What will be made, as the name and location change (UpdateHint).
        if not IsFolder()
            hintLabel = createNewFileContainer:AddLabel("New File Result", "")
            ColorGroup hintColor = GetMutedColor()
            if hintColor not= undefined
                hintLabel:SetFontColor(hintColor)
            end
            fileNameField:AddTextChangeListener(me)
            locationNameField:AddTextChangeListener(me)
        end

        // The footer: Cancel, then the main action at the right.
        Grouping closingButtons = createNewFileContainer:AddGrouping("Closing Buttons")
        closingButtons:PositionFromBottom()
        cancelButton = closingButtons:AddButton("Cancel")
        cancelButton:SetBehavior(cancelBehavior)

        okayButton = closingButtons:AddButton("OK")
        okayButton:SetName("OK")
        InterfaceOptions options
        okayButton:SetInterfaceOptionsKey(options:DIALOG_ACCEPT_BUTTON)
        okayButton:SetBehavior(okayBehavior)
    end
    
    // The muted color of captions and notes.
    private action GetMutedColor returns ColorGroup
        GameStateManager themeState
        InterfaceOptions options = themeState:GetInterfaceOptions()
        if options = undefined
            return undefined
        end
        return options:GetFontColor("FieldCaption")
    end

    //returns the current QuorumProject that the NewFile is being added to
    //used by the OpenBrowseFoldersBehavior
    action GetProject returns QuorumProject
        return me:project
    end

    //updates the locationNameField to the file path that the new file will be added to
    //(e.g. GameApplication/SourceCode to GameApplication/SourceCode/images)
    //used by the OpenBrowseFoldersBehavior
    action UpdateFolderName(text folderName)
        locationNameField:Empty()
        locationNameField:SetText(folderName)    
    end

    /* 
    Creates the new file using the file path from the locationNameField in the
    dialog. if the locationNameField is the same as the project name, then the 
    new file is by default added to the SourceCode folder
    */
    action CreateNewFile()
        File file
        File value = project:GetLocation()
        text path = value:GetAbsolutePath():Trim()

        /* If the project itself is selected  when creating a new file, then the default 
        folder for adding new files is the source code folder, else add the new file to 
        the currently selected folder */
        if project:GetName():Equals(locationNameField:GetText():Trim())
            if os:Contains("OS X")
                path = path + "/" + DefaultFolder() + fileNameField:GetText():Trim()
            else
                path = path + "\" + DefaultFolder() + fileNameField:GetText():Trim()
            end
        else
            if os:Contains("OS X")
                path = path + "/" +  locationNameField:GetText():Trim() + fileNameField:GetText():Trim()
            else
                path = path + "\" +  locationNameField:GetText():Trim() + fileNameField:GetText():Trim()
            end
        end
        
        file:SetAbsolutePath(path)
        
        

        if IsFolder()
            if not file:Exists()
                file:CreateDirectories()
            end
            AppendToProjectTree(file) 
        else
            text contents = ""
            if sceneType
                // An empty scene, from Studio's blank scene.
                File blank
                blank:SetPath(BLANK_SCENE)
                if not blank:Exists()
                    hintLabel:SetText("Quorum Studio's empty scene is missing, so no scene was made. Reinstalling Quorum Studio should fix this.")
                    return now
                end
                contents = blank:Read()
                if file:GetFileExtension() = ""
                    file:SetAbsolutePath(path + "." + SCENE_EXTENSION)
                end
            elseif file:GetFileExtension() = ""
                file:SetAbsolutePath(path + "." + QUORUM_EXTENSION)
            end

            File mom = file:GetParentDirectory()
            if mom:IsFile()
                return now
            end
            if not mom:Exists()
                mom:CreateDirectories()
            end
    
            file:Write(contents)
            file:Close()
            AppendToProjectTree(file)  
        end
              
    end

    action AppendToProjectTree(File file) 
        QuorumProjectView projectView = cast(QuorumProjectView, project:GetProjectView())
        TreeItem treeItem = projectView:GetLogicalTree()
        CodeEditorTabPane tabPane = studio:GetTabPane()

        ProjectTree projectTree = studio:GetProjectTree()
        Iterator<TreeItem> items = projectTree:GetTreeItems()

        boolean found = false
        ProjectTreeItem oldProjectHeader = undefined

        integer counter = 0
        repeat while items:HasNext() and found = false
            oldProjectHeader = cast(ProjectTreeItem, items:Next())
            if oldProjectHeader:GetProject() = project
                found = true
            else
                counter = counter + 1
            end      
        end

        if found = false
            return now
        end

        HashTable<text, text> expand = projectTree:GetExpandState()
        projectTree:Remove(cast(TreeItem, oldProjectHeader))
        projectTree:Add(counter, treeItem)
        
        projectTree:LoadExpandState(expand)
        projectTree:RefreshGitMarks(project)
        if not IsFolder()
            Tab tab = tabPane:OpenNewTab(file)
            tabPane:Select(tab)
        end
    end

    action GetFileName returns text
        return fileNameField:GetText()
    end

    action ActivateCancelButton()
        cancelButton:Activate()
    end

    action OnHide
        fileNameField:Empty()
        locationNameField:Empty()
        projectName = ""
        project = undefined
        manager = undefined
    end

    action OnShow
        fileNameField:Focus()
    end

    action IsFolder returns boolean
        return isFolder
    end

    action SetIsFolder(boolean isFolder)
        me:isFolder = isFolder
    end
end