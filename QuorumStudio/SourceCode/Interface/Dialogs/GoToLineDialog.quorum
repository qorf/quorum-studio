package Libraries.Development.Environment.Studio.Interface

use Libraries.Interface.Controls.Dialog
use Libraries.Game.Graphics.Label
use Libraries.Game.GameStateManager
use Libraries.Game.Game
use Libraries.Game.Graphics.Drawable
use Libraries.Interface.Controls.Icon
use Libraries.Interface.Views.LabelBoxView
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Button
use Libraries.Development.Environment.Studio.Behaviors.GoToLineOkButtonBehavior
use Libraries.Development.Environment.Studio.Behaviors.DialogCancelBehavior
use Libraries.Interface.Events.TextChangeListener
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Game.InputSet
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Game.InputTable
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Forms.FormPanel

class GoToLineDialog is Dialog, TextChangeListener
    boolean initialized = false
    Button ok
    Button cancel
    TextField lineTextField
    Label lineLabel

    GoToLineOkButtonBehavior okBehavior
    DialogCancelBehavior cancelBehavior
    on create
        SetModal(true)
        parent:Item:visible = false
    end

    action Setup
        if initialized
            lineTextField:SetText("")
            return now
        end
        initialized = true

        SetName("Go To Line Dialog")
        SetPixelWidth(400)
        SetPixelHeight(135)
        okBehavior:SetDialog(me)
        cancelBehavior:SetDialog(me)
        SetBehavior(okBehavior)

        LayoutProperties properties
        Page page = InitializeDefaultPage() 
        page:LeftAlignContent()
        
        FormPanel goToPanel
        FlowLayout goToLayout
        goToPanel:SetLayout(goToLayout)
        page:Add(goToPanel)
        lineLabel = goToPanel:AddLabel("Go To Line")
        lineLabel:SetHorizontalLayoutMode(properties:STANDARD)
        lineLabel:SetPercentageWidth(0.2)
        lineLabel:SetFontSize(14)
        lineLabel:SetLeftMargin(20)
        lineLabel:SetPositionOnBaseLine(false)

        lineTextField = goToPanel:AddTextField("Go To Line Field")
lineTextField:SetFontSize(14)
        lineTextField:SetHorizontalLayoutMode(properties:STANDARD)
        lineTextField:SetPercentageWidth(0.7)
        
        InputSet enterSet
        InputSet numEnterSet
        KeyboardEvent keys
        enterSet:SetKeyboardInput(keys:ENTER)
        numEnterSet:SetKeyboardInput(keys:NUMPAD_ENTER)
        InputTable table = lineTextField:CopyAndActivateInputTable("GTLTextField")
        lineTextField:SetInputGroup("GTLTextField")
        table:Add(enterSet, okBehavior)
        table:Add(numEnterSet, okBehavior)
        
        lineTextField:SetText("")
        lineTextField:AddTextChangeListener(me)
        
        Grouping buttonGroup = page:AddGrouping("Confirm")
        buttonGroup:PositionFromBottom()
        cancel= buttonGroup:AddButton("Cancel")
        cancel:SetFontSize(14)
        cancel:SetBehavior(cancelBehavior)
        
//setup the ok button
        ok = buttonGroup:AddButton("Go To")
        ok:SetFontSize(14)
        ok:SetBehavior(okBehavior)

    end

    action TextChanged(TextChangeEvent event)
        text value = lineTextField:GetText()
        okBehavior:SetLine(value)
    end

    action OnShow
        lineTextField:Focus()
        parent:Item:visible = true
    end
    
    action OnHide
        parent:Item:visible = false
    end
end