package Libraries.Development.Environment.Studio.Interface

use Libraries.Interface.Controls.Dialog
use Libraries.Game.Graphics.Label
use Libraries.Game.GameStateManager
use Libraries.Game.Game
use Libraries.Game.Graphics.Drawable
use Libraries.Interface.Controls.Icon
use Libraries.Interface.Views.LabelBoxView
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Controls.ProgressBar
use Libraries.Language.Compile.Library

use Libraries.Language.Compile.CompilerListener
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Compute.Math
use Libraries.Containers.Array
use Libraries.Compute.Random
use Libraries.Interface.Accessibility
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Layouts.ManualLayout
use Libraries.Game.Graphics.ColorGroup
use Libraries.Interface.Options.InterfaceOptions

class SplashScreen is Dialog, CompilerListener
    boolean initialized = false
    Icon logo
    Label studio
    Label loading
    Label version
    SplashProgressBar progress
    Library library = undefined
    number currentPercent = 0
    GameStateManager manager
    Math math
    Random random
    Array<text> scanLabels
    Array<text> parsingLabels
    Array<text> typeCheckingLabels
    Array<text> semanticsLabels
    Array<text> doneLabels
    boolean playMessage = false
    text notification = ""

    // The card's width, the logo's size and the space around them, in
    // points (S2). The card is sized by its contents, never the window.
    constant number CARD_WIDTH = 320
    constant number LOGO_SIZE = 84
    constant number EDGE_SPACE = 24
    // ProgressBar's own height, 20 points.
    constant number BAR_ROW_HEIGHT = 20

    on create
        SetModal(true)
        SetTopBarVisible(false)

        scanLabels:Add("Taking the Upside Down to Prom")
        scanLabels:Add("Inviting the robots for totally good purposes, I promise")
        scanLabels:Add("Crowdsourcing loading messages")
        scanLabels:Add("Adding bugs to your programs")
        scanLabels:Add("Rolling Initiative")
scanLabels:Add("Quincy says hi.")
        scanLabels:Add("Live long and ... nevermind")
        scanLabels:Add("Putting swords in backpacks")
        

        parsingLabels:Add("Trolling Internet Trolls")
        parsingLabels:Add("I guess I'm like ... booting?")
parsingLabels:Add("Spacebar heating reenabled")
        parsingLabels:Add("Generating Free Tacos")
        parsingLabels:Add("Tears of the Kingdom on Switch 2? Yes, please.")
        parsingLabels:Add("Vulcan does not have a K")

        typeCheckingLabels:Add("Animating Rabbits doing standup")
        typeCheckingLabels:Add("Contemplating Rabbits")
        typeCheckingLabels:Add("Lowering human defenses")
        typeCheckingLabels:Add("Starting robot apocalypse")
        typeCheckingLabels:Add("Deleting your operating system ... with love?")

        semanticsLabels:Add("Blockifying Garden Gnomes")
        semanticsLabels:Add("Social distancing from Cthulu")
        semanticsLabels:Add("Suddenly ... kitties")
        semanticsLabels:Add("Feeling Spiky, Punk?")
        semanticsLabels:Add("Hugging adorable creatures")
        semanticsLabels:Add("Making things more prettyer (ish)")

        doneLabels:Add("Ironing Baby Yoda")
        doneLabels:Add("Returning that shirt you didn't like")
        doneLabels:Add("Shaving Chewbacca")
        doneLabels:Add("Hiding in the corner. Eating all your breakfast.")
        doneLabels:Add("INTENSIFYING TYPOES")
        doneLabels:Add("REINTENSFYING TYPTOES")
end

    action UpdatePercentageComplete(number percent)
        currentPercent = percent
    end

    action FindRandomPhrase(Array<text> phrases) returns text
        text result = ""
        if phrases not= undefined and not phrases:IsEmpty()
            integer i = random:RandomIntegerBetween(0, phrases:GetSize() - 1)
            result = phrases:Get(i)
        end
        return result
    end

    action UpdateLabel(text label)
        if label = "Started Scanning"
            notification = FindRandomPhrase(scanLabels)
        elseif label = "Parsing"
            notification = FindRandomPhrase(parsingLabels)
        elseif label = "Type Checking"
            notification = FindRandomPhrase(typeCheckingLabels)
        elseif label = "Semantic Analysis"
            notification = FindRandomPhrase(semanticsLabels)
        elseif label = "All done!"
            notification = FindRandomPhrase(doneLabels)
        end
        playMessage = true
    end

    action Initialize
        if initialized
            return now
        end
        initialized = true

        QuorumStudio qs = cast(QuorumStudio, manager:GetGame())
        SetName("Loading")
        LayoutProperties properties

        // A fixed width in points, so the window's size only moves the card.
        SetPercentageWidth(0)
        SetPixelWidth(CARD_WIDTH)
        SetCornerPixelRounding(12, 12, 12, 12)

        Control panel
        FlowLayout panelLayout
        panel:SetLayout(panelLayout)
        panel:SetInterfaceOptionsKey("Dialog")
        panel:SetPercentageWidth(1.0)
        panel:SetVerticalLayoutMode(properties:FIT_CONTENTS)
        panel:SetBorderStyle(properties:ALL)
        panel:SetBorderThickness(1)
        panel:SetCornerPixelRounding(12, 12, 12, 12)
        panel:SetBorderColor(GetBorderColor())

        // The logo, centered in a row of its own.
        Control logoRow
        ManualLayout logoLayout
        logoRow:SetLayout(logoLayout)
        logoRow:SetPercentageWidth(1.0)
        logoRow:SetVerticalLayoutMode(properties:STANDARD)
        logoRow:SetPixelHeight(LOGO_SIZE)
        logoRow:SetTopMargin(EDGE_SPACE)

        logo:Load("Resources/Graphics/Interface/BunnySplash.png")
        logo:SetHorizontalLayoutMode(properties:STANDARD)
        logo:SetVerticalLayoutMode(properties:STANDARD)
        // LOGO_SIZE tall, as wide as the picture's shape allows.
        number logoWidth = LOGO_SIZE
        if logo:GetRegionHeight() > 0
            logoWidth = LOGO_SIZE * logo:GetRegionWidth() / cast(number, logo:GetRegionHeight())
        end
        logo:SetPixelWidth(logoWidth)
        logo:SetPixelHeight(LOGO_SIZE)
        LayoutProperties logoProperties = logo:GetDefaultLayoutProperties()
        logoProperties:SetPercentageOriginX(0.5)
        logo:SetPercentageX(0.5)
        logoRow:Add(logo)
        panel:Add(logoRow)

        // The name, then the version, muted.
        studio:SetText("Quorum Studio")
        studio:SetFontSize(20)
        AddCenteredRow(panel, studio, 28, 14)

        text versionText = qs:GetVersion()
        if qs:GetDisplayName():Contains("Vulkan")
            versionText = versionText + ", Vulkan beta"
        end
        version:SetText(versionText)
        ColorGroup muted = GetMutedColor()
        if muted not= undefined
            version:SetColor(muted)
        end
        AddCenteredRow(panel, version, 20, 2)

        // The bar, centered, most of the card's width. It keeps its own
        // height (ProgressBar's BAR_HEIGHT), which leaves room for the fill
        // inside its edge.
        progress:SetHorizontalLayoutMode(properties:STANDARD)
        progress:SetPercentageWidth(0.85)
        progress:SetBorderThickness(0)
        AddCenteredRow(panel, progress, BAR_ROW_HEIGHT, 18)

        // The message, under the bar. Long ones wrap onto a second line,
        // which the row has room for.
        loading:SetText("Loading ...")
        loading:SetPercentageWidth(0.85)
        loading:SetAlignment(loading:CENTER_ALIGN)
        Control messageRow = AddCenteredRow(panel, loading, 44, 6)
        messageRow:SetBottomMargin(EDGE_SPACE - 10)

        ControlShaderView view
        view:Initialize()
        panel:SetView2D(view)

        Add(panel)
        progress:SetFocusable(true)
    end

    /*
    This action puts a piece in a full-width row of its own, centered, and
    adds the row to the panel. The panel's FlowLayout then only stacks rows.
    */
    private action AddCenteredRow(Control panel, Control piece, number rowHeight, number topMargin) returns Control
        LayoutProperties properties
        Control row
        ManualLayout rowLayout
        row:SetLayout(rowLayout)
        row:SetPercentageWidth(1.0)
        row:SetVerticalLayoutMode(properties:STANDARD)
        row:SetPixelHeight(rowHeight)
        row:SetTopMargin(topMargin)

        LayoutProperties pieceProperties = piece:GetDefaultLayoutProperties()
        pieceProperties:SetPercentageOriginX(0.5)
        pieceProperties:SetPercentageOriginY(0.5)
        piece:SetPercentageX(0.5)
        piece:SetPercentageY(0.5)
        if piece is Label
            Label label = cast(Label, piece)
            label:SetPositionOnBaseLine(false)
        end
        row:Add(piece)
        panel:Add(row)
        return row
    end

    private action GetMutedColor returns ColorGroup
        InterfaceOptions options = manager:GetInterfaceOptions()
        if options = undefined
            return undefined
        end
        return options:GetTabFontColor()
    end

    action OnShow
        progress:Focus()
    end

    action Update(number seconds)
        number value = math:RoundToNearestInteger(currentPercent)
        progress:SetValue(value)

        if playMessage
            Accessibility access = manager:GetAccessibility()
            if access not= undefined
                access:Notify(manager:GetFocus(), notification)
            end
            loading:SetText(notification)
            playMessage = false
        end
    end

    action GetLibrary returns Library
        return library
    end

    action SetLibrary(Library library)
        me:library = library
        library:AddListener(me)
    end
end
