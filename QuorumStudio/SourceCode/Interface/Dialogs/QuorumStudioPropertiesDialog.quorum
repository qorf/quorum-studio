package Libraries.Development.Environment.Studio.Interface

use Libraries.Interface.Controls.Dialog
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Controls.TabPane
use Libraries.Interface.Controls.Tab
use Libraries.Interface.Controls.ScrollPane
use Libraries.Interface.Views.LabelBoxView
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Label
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Button
use Libraries.Development.Environment.Projects.Quorum.QuorumProject
use Libraries.Development.Environment.Projects.ProjectProperty
use Libraries.Containers.Iterator
use Libraries.Containers.Array
use Libraries.Game.Graphics.Gradient
use Libraries.Development.Environment.Studio.Behaviors.DialogCancelBehavior
use Libraries.Interface.Events.MouseWheelListener
use Libraries.Interface.Events.MouseEvent
use Libraries.System.File
use Libraries.Development.Environment.Studio.Behaviors.EmptyTextFieldBehavior
use Libraries.Interface.Controls.TextBox
use Libraries.Interface.Selections.TabPaneSelection
use Libraries.Game.GameStateManager
use Libraries.Development.Environment.Studio.QuorumStudio
use Libraries.Development.Environment.Configuration.Options
use Libraries.Development.Environment.Projects.Credentials
use Libraries.Development.Environment.Studio.Behaviors.QuorumStudioPropertiesOkBehavior
use Libraries.Interface.Views.ControlShaderView
use Libraries.Interface.Controls.RadioButton
use Libraries.Interface.Controls.ButtonGroup
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Pages.StackedRowPage
use Libraries.Interface.Forms.Banner
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Layouts.FormRowLayout
use Libraries.Interface.Forms.Page
use Libraries.Interface.Layouts.LayoutProperties
use Libraries.Interface.Controls.Scenes.TerrainCursorSettings


class QuorumStudioPropertiesDialog is Dialog, MouseWheelListener

    boolean initialized = false

    RadioButton lightModeButton = undefined
    RadioButton darkModeButton = undefined
    TextField frameRateField = undefined
    Checkbox overrideLibraryCheckbox = undefined
    TextField libraryField = undefined
    Checkbox framesPerSecondCheckbox = undefined
    Checkbox blockModeCheckbox = undefined
    TextField blockHeightField = undefined
    TextField blockWidthField = undefined

    // The Scene Editor tab: the terrain cursor's beam, crosshair and pulse.
    Checkbox showBeamCheckbox = undefined
    Checkbox showCrosshairCheckbox = undefined
    Array<RadioButton> colorButtons
    Array<RadioButton> pulseButtons
    TextField glowStrengthField = undefined
    TextField glowWidthField = undefined
    TextField topFadeField = undefined
    TextField crosshairOpacityField = undefined

    TabPane tabPane

    EmptyTextFieldBehavior emptyTextFieldBehavior
    // Behaviors used by the OK and Cancel buttons.
    QuorumStudioPropertiesOkBehavior okBehavior
    DialogCancelBehavior cancelBehavior
    Options options = undefined

    action OnShow
        tabPane:Focus()
        Tab tab = tabPane:GetSelectedTab()
        if not tab:Equals(tabPane:Get(0))
            tab:Activate()
        end
    end

    on create
        okBehavior:SetDialog(me)
        cancelBehavior:SetDialog(me)
        SetBehavior(okBehavior)

        GameStateManager manager
        QuorumStudio studio = cast(QuorumStudio, manager:GetGame())
        options = studio:GetOptions()
    end

    action Initialize
        initialized = true
        SetName("Quorum Studio Properties")
        SetPercentageWidth(0.50)
        SetVerticalLayoutMode(parent:Libraries.Interface.Controls.Control:STANDARD)
        SetPercentageHeight(0.72)
        
        LayoutProperties viewProperties = tabPane:GetViewAreaLayoutProperties()
        viewProperties:SetPercentageWidth(1.0)
        viewProperties:SetPercentageHeight(1.0)
        FlowLayout tabLayout
        tabPane:SetViewAreaLayout(tabLayout)
        tabPane:SetPercentageWidth(1.0)
        tabPane:SetVerticalLayoutMode(viewProperties:FILL)
        tabPane:Add(CreateGeneralTab())
        tabPane:Add(CreateSceneEditorTab())
        Add(tabPane)
        Load()
    end

    action Save
        if lightModeButton:GetToggleState()
            options:SetToLightMode()
        else
            options:SetToDarkMode()
        end

        if overrideLibraryCheckbox:GetToggleState()
            options:SetOverridingStandardLibrary(true)
        else
            options:SetOverridingStandardLibrary(false)
        end 

        if framesPerSecondCheckbox:GetToggleState()
            options:SetIsShowingFramesPerSecondCounter(true)
        else
            options:SetIsShowingFramesPerSecondCounter(false)
        end

        if blockModeCheckbox:GetToggleState()
            options:SetIsBlockMode(true)
        else
            options:SetIsBlockMode(false)
        end

        number frameRate = 30
        check
            frameRate = cast(number, frameRateField:GetText())
        detect e
        end
        options:SetFrameRateLimit(frameRate)
        
        number blockHeight = 1
        check
            blockHeight = cast(number, blockHeightField:GetText())
        detect error
        end
        options:SetBlocksHeightScaling(blockHeight)
        
        number blockWidth = 1
        check
            blockWidth = cast(number, blockWidthField:GetText())
        detect error
        end
        options:SetBlocksScopeWidthScaling(blockWidth)
        
        //for this one, there's a series of different checks we could do here,
        //but realistically, the user could put this pointing to basically anything
        //and there's hardly a guarantee it's valid even if the structure is the same
        //Just check if it's a valid folder and move on
        text location = libraryField:GetText()
        if location not= undefined and location not= ""
            File file
            file:SetAbsolutePath(location)
            if file:Exists() and file:IsDirectory()
                options:SetStandardLibraryOverrideRawLocation(location)
            else //if it's not valid, turn off the override
                options:SetOverridingStandardLibrary(false)
            end
        else
            options:SetStandardLibraryOverrideRawLocation("")
            options:SetOverridingStandardLibrary(false)
        end

        // The Scene Editor tab. Every open scene shares these settings, so
        // they change there at once.
        TerrainCursorSettings settings = options:GetTerrainCursorSettings()
        settings:SetShowBeam(showBeamCheckbox:GetToggleState())
        settings:SetShowCrosshair(showCrosshairCheckbox:GetToggleState())
        integer colorIndex = 0
        repeat while colorIndex < colorButtons:GetSize()
            RadioButton colorButton = colorButtons:Get(colorIndex)
            if colorButton:GetToggleState()
                Array<text> colorNames = settings:GetColorNames()
                settings:SetColorName(colorNames:Get(colorIndex))
            end
            colorIndex = colorIndex + 1
        end
        integer pulseIndex = 0
        repeat while pulseIndex < pulseButtons:GetSize()
            RadioButton pulseButton = pulseButtons:Get(pulseIndex)
            if pulseButton:GetToggleState()
                settings:SetPulse(pulseIndex)
            end
            pulseIndex = pulseIndex + 1
        end
        settings:SetGlowStrength(ReadWhole(glowStrengthField, settings:GetGlowStrength()))
        settings:SetGlowWidth(ReadWhole(glowWidthField, settings:GetGlowWidth()))
        settings:SetTopFade(ReadWhole(topFadeField, settings:GetTopFade()))
        settings:SetCrosshairOpacity(ReadWhole(crosshairOpacityField, settings:GetCrosshairOpacity()))
    end

    action Load
        if options:IsLightMode()
            lightModeButton:SetToggleState(true)
        else
            darkModeButton:SetToggleState(true)
        end

        if options:IsOverridingStandardLibrary()
            overrideLibraryCheckbox:SetToggleState(true)
        else
            overrideLibraryCheckbox:SetToggleState(false)
        end

        if options:IsShowingFramesPerSecondCounter()
            framesPerSecondCheckbox:SetToggleState(true)
        else
            framesPerSecondCheckbox:SetToggleState(false)
        end

        if options:IsBlockMode()
            blockModeCheckbox:SetToggleState(true)
        else
            blockModeCheckbox:SetToggleState(false)
        end
        
        number blockHeight = options:GetBlocksHeightScaling()
        blockHeightField:SetText("" + blockHeight)
        
        number blockWidth = options:GetBlocksScopeWidthScaling()
        blockWidthField:SetText("" + blockWidth)
        
        number frames = options:GetFrameRateLimit()
        frameRateField:SetText("" + frames)

        text libraryLocation = options:GetStandardLibraryOverrideRawLocation()
        libraryField:SetText(libraryLocation)

        TerrainCursorSettings settings = options:GetTerrainCursorSettings()
        showBeamCheckbox:SetToggleState(settings:IsShowingBeam())
        showCrosshairCheckbox:SetToggleState(settings:IsShowingCrosshair())
        Array<text> colorNames = settings:GetColorNames()
        integer colorIndex = colorNames:GetFirstLocation(settings:GetColorName())
        if colorIndex >= 0 and colorIndex < colorButtons:GetSize()
            RadioButton colorButton = colorButtons:Get(colorIndex)
            colorButton:SetToggleState(true)
        end
        integer pulseIndex = settings:GetPulse()
        if pulseIndex >= 0 and pulseIndex < pulseButtons:GetSize()
            RadioButton pulseButton = pulseButtons:Get(pulseIndex)
            pulseButton:SetToggleState(true)
        end
        glowStrengthField:SetText("" + settings:GetGlowStrength())
        glowWidthField:SetText("" + settings:GetGlowWidth())
        topFadeField:SetText("" + settings:GetTopFade())
        crosshairOpacityField:SetText("" + settings:GetCrosshairOpacity())
    end

    action IsInitialized returns boolean
        return initialized
    end

    /*
        The General tab: appearance, blocks and the library.
    */
    private action CreateGeneralTab returns Tab
        Tab tab
        tab:SetName("General")
        tab:DisplayCloseButton(false)

        StackedRowPage page
        page:LeftAlignContent()
        ApplyDefaultStyleToPage(page)
        // No offset for a top bar, since this page is in a pane.
        page:SetPixelHeight(0)
        page:SetSkipLabelsInFocus(true)

        Grouping appearanceCard = page:AddGrouping("Appearance")
        appearanceCard:SetTitle("Appearance")
        appearanceCard:AddLabel("Color Mode")
        Grouping colorModeChoices = appearanceCard:AddGrouping("Color Mode Grouping")
        lightModeButton = colorModeChoices:AddRadioButton("Light Mode")
        darkModeButton = colorModeChoices:AddRadioButton("Dark Mode")
        framesPerSecondCheckbox = appearanceCard:AddCheckbox("Display Framerate")
        appearanceCard:AddLabel("Frame Rate")
        frameRateField = appearanceCard:AddTextField("Frame Rate")

        Grouping blocksCard = page:AddGrouping("Blocks")
        blocksCard:SetTitle("Blocks")
        blockModeCheckbox = blocksCard:AddCheckbox("Blocks")
        blocksCard:AddLabel("Height Scaling")
        blockHeightField = blocksCard:AddTextField("Blocks Height Scaling")
        blocksCard:AddLabel("Scope Width Scaling")
        blockWidthField = blocksCard:AddTextField("Blocks Scope Width Scaling")

        Grouping libraryCard = page:AddGrouping("Library")
        libraryCard:SetTitle("Library")
        overrideLibraryCheckbox = libraryCard:AddCheckbox("Override Library")
        libraryCard:AddLabel("Override Library Path")
        libraryField = libraryCard:AddTextField("Library Location")

        Grouping buttonGroup = page:AddGrouping("Confirm")
        Button cancelButton = buttonGroup:AddButton("Cancel")
        Button okayButton = buttonGroup:AddButton("Ok")
        // The main action: the accent button style.
        okayButton:SetInterfaceOptionsKey("DialogAcceptButton")
        buttonGroup:PositionFromBottom() 

        cancelButton:SetBehavior(cancelBehavior)
        okayButton:SetBehavior(okBehavior)

        tab:SetFocusTarget(lightModeButton)
        tab:SetRelatedItem(page)
        return tab
    end

    /*
        The Scene Editor tab: how the terrain cursor is marked so it can be
        seen from far away.
    */
    private action CreateSceneEditorTab returns Tab
        Tab tab
        tab:SetName("Scene Editor")
        tab:DisplayCloseButton(false)

        StackedRowPage page
        page:LeftAlignContent()
        ApplyDefaultStyleToPage(page)
        page:SetPixelHeight(0)
        page:SetSkipLabelsInFocus(true)

        TerrainCursorSettings settings = options:GetTerrainCursorSettings()

        Grouping beamCard = page:AddGrouping("Beam")
        beamCard:SetTitle("Beam")
        showBeamCheckbox = beamCard:AddCheckbox("Show Beam")
        beamCard:AddLabel("Color")
        Grouping colorChoices = beamCard:AddGrouping("Color Choices")
        Array<text> colorNames = settings:GetColorNames()
        integer colorIndex = 0
        repeat while colorIndex < colorNames:GetSize()
            colorButtons:Add(colorChoices:AddRadioButton(colorNames:Get(colorIndex)))
            colorIndex = colorIndex + 1
        end
        beamCard:AddLabel("Glow Strength (%)")
        glowStrengthField = beamCard:AddTextField("Glow Strength")
        beamCard:AddLabel("Glow Width")
        glowWidthField = beamCard:AddTextField("Glow Width")
        beamCard:AddLabel("Top Fade (%)")
        topFadeField = beamCard:AddTextField("Top Fade")

        Grouping crosshairCard = page:AddGrouping("Crosshair")
        crosshairCard:SetTitle("Crosshair")
        showCrosshairCheckbox = crosshairCard:AddCheckbox("Show Crosshair")
        crosshairCard:AddLabel("Opacity (%)")
        crosshairOpacityField = crosshairCard:AddTextField("Crosshair Opacity")

        Grouping motionCard = page:AddGrouping("Motion")
        motionCard:SetTitle("Motion")
        motionCard:AddLabel("Pulse")
        Grouping pulseChoices = motionCard:AddGrouping("Pulse Choices")
        Array<text> pulseNames = settings:GetPulseNames()
        integer pulseIndex = 0
        repeat while pulseIndex < pulseNames:GetSize()
            pulseButtons:Add(pulseChoices:AddRadioButton(pulseNames:Get(pulseIndex)))
            pulseIndex = pulseIndex + 1
        end

        Grouping buttonGroup = page:AddGrouping("Confirm")
        Button cancelButton = buttonGroup:AddButton("Cancel")
        Button okayButton = buttonGroup:AddButton("Ok")
        // The main action: the accent button style.
        okayButton:SetInterfaceOptionsKey("DialogAcceptButton")
        buttonGroup:PositionFromBottom()
        cancelButton:SetBehavior(cancelBehavior)
        okayButton:SetBehavior(okBehavior)

        tab:SetFocusTarget(showBeamCheckbox)
        tab:SetRelatedItem(page)
        return tab
    end

    // A whole number from a field, or a fallback if it isn't one.
    private action ReadWhole(TextField field, integer fallback) returns integer
        integer value = fallback
        check
            number typed = cast(number, field:GetText())
            value = cast(integer, typed + 0.5)
        detect error
        end
        return value
    end

    action OnHide()
    end
end