    private action SetButtonTextToAwesomeFontUnicode(integer unicode, Button button)
        text value = ""
        value = value:GetUnicodeValue(unicode)

        button:SetFontSize(50)
        button:SetFont(fontAwesome)
        button:SetLabelText(value)
    end

    /*
    This adds the common set of elements to the bottom of a page:
    the file name and location fields, browse button, and confirm
    and cancel buttons.
    */
    private action SetupSecondPageElements(Page page)
        ApplyDefaultStyleToPage(page)
        page:LeftAlignContent()
        
        
        FormPanel labelPanel
        FormRowLayout labelLayout
        labelPanel:SetLayout(labelLayout)
        me:secondPageLabel = labelPanel:AddLabel("Selected Template: " + selectedProject)
        
        page:Add(labelPanel)
        
        Color color
        LayoutProperties properties
        
        FormPanel evenBiggerPanel
        evenBiggerPanel:SetPercentageWidth(0.9)
        evenBiggerPanel:SetPercentageHeight(0.4)
        ManualLayout biggerLayout
        evenBiggerPanel:SetLayout(biggerLayout)
        
        FormPanel iconPanel
        
        iconPanel:SetPercentageHeight(0.8)
        iconPanel:SetPercentageWidth(0.3)
        iconPanel:SetVerticalLayoutMode(properties:MAINTAIN_ASPECT_RATIO)
        ControlShaderView iconPanelShader
        iconPanelShader:Initialize()
        iconPanel:SetView2D(iconPanelShader)
        ManualLayout iconPanelLayout
        iconPanel:SetLayout(iconPanelLayout)
        iconPanel:SetBackgroundColor(color:White())
        iconPanel:SetCornerPixelRounding(10,10,10,10)
        iconPanel:SetBorderThickness(1.5)
        
        evenBiggerPanel:Add(iconPanel)
        iconPanel:SetPercentageOriginX(0.5)
        iconPanel:SetPercentageX(0.5)
        page:Add(evenBiggerPanel)
        
        CharacterIcon temp
        me:secondTemplateVisual = temp
        secondTemplateVisual:SetPercentageHeight(0.9)
        secondTemplateVisual:SetPercentageWidth(0.9)
        secondTemplateVisual:SetPercentageOriginX(0.5)
        secondTemplateVisual:SetPercentageOriginY(0.5)
        secondTemplateVisual:SetPercentageX(0.5)
        secondTemplateVisual:SetPercentageY(0.5)
        //SetTemplateImage(selectedProject, secondTemplateVisual)
        
        iconPanel:Add(secondTemplateVisual)
        
        page:AddLabel("Project Name")
        TextField nameField = page:AddTextField(NAME_FIELD_ID)

        FormPanel locationGrouping
        FlowLayout locationLayout
        locationGrouping:SetLayout(locationLayout)
        Label locationLabel = locationGrouping:AddLabel("Project Location")
        locationLabel:SetPositionOnBaseLine(false)
        locationLabel:SetHorizontalLayoutMode(properties:STANDARD)
        locationLabel:SetPercentageWidth(0.7)
        //Grouping locationGrouping = page:AddGrouping("Location")
        Button browseButton = locationGrouping:AddButton("Browse...")
        browseButton:SetHorizontalLayoutMode(properties:STANDARD)
        browseButton:SetVerticalLayoutMode(properties:FIT_FONT)
        browseButton:SetFontSize(14)
        browseButton:SetPercentageWidth(0.3)
        
        page:Add(locationGrouping)
        TextField locationField = page:AddTextField(LOCATION_FIELD_ID)

        Grouping buttonGroup = page:AddGrouping("Confirm")
        Button backButton = buttonGroup:AddButton("Back")
        Button cancelButton = buttonGroup:AddButton("Cancel")
        Button okButton = buttonGroup:AddButton("Ok")
        buttonGroup:PositionFromBottom()
        
        me:nameField = nameField
        me:locationField = locationField
        me:cancelButton = cancelButton

        cancelButton:SetBehavior(cancelBehavior)
        backButton:SetBehavior(backBehavior)
        okButton:SetBehavior(okBehavior)
        browseButton:SetBehavior(browseBehavior)
    end
    
    action UpdateSecondPage
        me:secondPageLabel:SetText("Selected Template: " + selectedProject)
        SetTemplateImage(selectedProject, me:secondTemplateVisual)
    end

    action GetLocation returns text
        return locationField:GetText()
    end

    action ActivateCancelButton()
        cancelButton:Activate()
    end

    action SetLocation(File file)
        locationPath = file
        UpdateLocationName(file:GetAbsolutePath())
    end

    private action UpdateLocationName(text location)
        locationField:SetText(location)
    end

    action CreateNewProject returns QuorumProject
        QuorumProject project
        
        File file
        File projectPath    //new project path 
        File template       //template to copy from
        File newProjectFolderLocation   
        //template folders containing the files that need to be copied into the new project
        //dependent on the type of application chosen by the user
        template:SetPath(templatePath)  //sets the template of the user defined application            
        
        text path = locationField:GetText():Trim() + "/" + nameField:GetText():Trim() + "/Main.quorum"
        file:SetAbsolutePath(path)
        if file:GetParentDirectory():Exists()
            return undefined
        end
        project:SetLocation(file:GetParentDirectory())

        projectPath = project:GetLocation()
        text newProjectPath = projectPath:GetAbsolutePath()
        newProjectFolderLocation:SetWorkingDirectory(newProjectPath)
        boolean copySuccess = template:Copy(newProjectFolderLocation, true)
        
        project:SetName(nameField:GetText():Trim())

        File dad = newProjectFolderLocation:GetParentDirectory()
        if not dad:Exists()
            dad:CreateDirectories()
        end

        return project
    end
    
    action GetProjectName() returns text
        return nameField:GetText():Trim()
    end

    action OnHide
        nameField:Empty()
        locationField:Empty()
    end

    action OnShow
        SetCurrentPage(templatePage)
        SetBehavior(nextBehavior)
        Iterator<TreeItem> categories = templateTree:GetTreeItems()
        repeat while categories:HasNext()
            TreeItem category = categories:Next()
            category:Close()
        end
        categories:Rewind()
        TreeItem firstItem = categories:Next()
        firstItem:Open()
        
        templateTree:Select(initialSelection)
        templateTree:Focus()
        //SetTemplateImage(BLANK, templateVisual)
        
        locationField:SetText(studio:GetProjectsFolder():GetAbsolutePath())
    end

    action GetSelectedProject returns text
        return selectedProject
    end

    action SetSelectedProject(text selectedProject)
        templatePath = templateHash:GetValue(selectedProject)
        me:selectedProject = selectedProject
    end
    
    action SetupDefaultPage()
        Page page1 = InitializeDefaultPage()
        page1:SetName("Template Page")
        Color color
        LayoutProperties properties
        page1:SetScrollRegionResizing(page1:parent:ScrollPane:MANUAL_REGION_SIZING)
        //Control scrollRegion = page1:GetScrollableRegion()
        //ScrollPaneRenderer renderer = cast(ScrollPaneRenderer, scrollRegion)
        LayoutProperties regionProps = page1:GetScrollRegionProperties()
        regionProps:SetPercentageHeight(1)
        regionProps:SetPercentageWidth(1)
        
        //page1:SetBackgroundColor(color:Gray())
        FormRowLayout leftLayout
        ControlShaderView panelShader
        panelShader:Initialize()
        
        FormPanel leftPanel
        leftPanel:SetLayout(leftLayout)
        leftPanel:SetPercentageHeight(1.0)
        leftPanel:SetPercentageWidth(0.5)
        
        FormScrollPane treeContainer
        treeContainer:SetPercentageHeight(0.85)
        treeContainer:SetView2D(panelShader)
        treeContainer:SetCornerPixelRounding(10,10,10,10)
        treeContainer:SetBorderThickness(1)
        treeContainer:SetBackgroundColor(color:White())
        //treeContainer:GetScrollableRegion():SetBorderThickness(1)
        //treeContainer:GetScrollableRegion():SetCornerPixelRounding(10,10,10,10)
        leftPanel:Add(treeContainer)
        // set the tree field
        me:templateTree = treeContainer:AddTree("TemplateTree")
        templateTree:SetTopMargin(15)
        templateTree:SetLeftMargin(15)
        
        FormPanel rightPanel
        rightPanel:SetPercentageHeight(1.0)
        rightPanel:SetPercentageWidth(0.5)
        FormRowLayout rightLayout
        rightPanel:SetLayout(rightLayout)
        
        FormPanel iconPanel
        iconPanel:SetPercentageHeight(0.5)
        ControlShaderView iconPanelShader
        iconPanelShader:Initialize()
        iconPanel:SetView2D(iconPanelShader)
        ManualLayout iconPanelLayout
        iconPanel:SetLayout(iconPanelLayout)
        iconPanel:SetBackgroundColor(color:White())
        iconPanel:SetCornerPixelRounding(10,10,10,10)
        iconPanel:SetBorderThickness(1)
        
        CharacterIcon temp
        me:templateVisual = temp
        templateVisual:SetPercentageHeight(0.9)
        templateVisual:SetPercentageWidth(0.9)
        templateVisual:SetPercentageOriginX(0.5)
        templateVisual:SetPercentageOriginY(0.5)
        templateVisual:SetPercentageX(0.5)
        templateVisual:SetPercentageY(0.5)
        //SetTemplateImage(BLANK, templateVisual)
        
        iconPanel:Add(templateVisual)
        rightPanel:Add(iconPanel)
        
        FormPanel labelContainer
        ControlShaderView labelContainerShader
        labelContainerShader:Initialize()
        labelContainer:SetView2D(labelContainerShader)
        FormRowLayout labelLayout
        labelContainer:SetLayout(labelLayout)
        labelContainer:LeftAlignContent()
        labelContainer:SetPercentageHeight(0.333)
        labelContainer:SetBackgroundColor(color:White())
        labelContainer:SetBorderThickness(1)
        labelContainer:SetCornerPixelRounding(10,10,10,10)
        // set the label field
        me:templateDescription = labelContainer:AddLabel("TemplateDescription")
        templateDescription:SetText("This a blank template for starting from scratch")
        
        rightPanel:Add(labelContainer)
        Grouping nextGroup
        nextGroup:PositionFromBottom()
        Button nextButton = nextGroup:AddButton("Next")
        rightPanel:Add(nextGroup)
        nextButton:SetBehavior(me:nextBehavior)
        
        FlowLayout outerLayout
        outerLayout:SetSingleLine(true)
        page1:SetLayout(outerLayout)
        page1:Add(leftPanel)
        page1:Add(rightPanel)
        //page1:SetCornerRounding(10,10,0,0)
        page1:SetBorderThickness(GetBorderThickness())
        page1:SetBorderColor(GetBorderColor())
        
        SetupTemplateTree(templateTree)
    end
    
    action SetupTemplateTree(Tree tree)
        TreeItem generalTemplates = MakeTreeItem("General")
        initialSelection:Add(generalTemplates)
        TreeItem blank = MakeTreeItem(BLANK)
        initialSelection:Add(blank)
        generalTemplates:Add(blank)
        generalTemplates:Add(MakeTreeItem(APP))
        generalTemplates:Add(MakeTreeItem(GAMES))
        generalTemplates:Add(MakeTreeItem(SCENE))
        generalTemplates:Add(MakeTreeItem(MOBILE))
        tree:Add(generalTemplates)
        
        TreeItem gameTemplates = MakeTreeItem("Games")
        gameTemplates:Add(MakeTreeItem(IMAGE_SHEET))
        gameTemplates:Add(MakeTreeItem(PHYSICS2D))
        gameTemplates:Add(MakeTreeItem(PHYSICS3D))
        gameTemplates:Add(MakeTreeItem(SKYBOX))
        gameTemplates:Add(MakeTreeItem(SCENE2D))
        gameTemplates:Add(MakeTreeItem(SCENE3D))
        tree:Add(gameTemplates)
        
        TreeItem dataTemplates  = MakeTreeItem("Data Science")
        dataTemplates:Add(MakeTreeItem(BAR_CHART))
        dataTemplates:Add(MakeTreeItem(PIE_CHART))
        dataTemplates:Add(MakeTreeItem(SCATTERPLOT))
        dataTemplates:Add(MakeTreeItem(DESCRIPTIVES))
        dataTemplates:Add(MakeTreeItem(CORRELATIONS))
        dataTemplates:Add(MakeTreeItem(COMPARE_MEANS))
        tree:Add(dataTemplates)
        
        TreeItem soundTemplates = MakeTreeItem("Sound")
        soundTemplates:Add(MakeTreeItem(PLAY_SOUND))
        soundTemplates:Add(MakeTreeItem(SINE_WAVE))
        soundTemplates:Add(MakeTreeItem(MIDI))
        tree:Add(soundTemplates)
        
        TreeItem otherTemplates = MakeTreeItem("Other")
        otherTemplates:Add(MakeTreeItem(DATABASE))
        otherTemplates:Add(MakeTreeItem(LEGO_MINDSTORMS))
        otherTemplates:Add(MakeTreeItem(DOCUMENT))
        otherTemplates:Add(MakeTreeItem(INTERNET_SERVICE))
        otherTemplates:Add(MakeTreeItem(LEGO_SPIKE_MOVE))
        tree:Add(otherTemplates)
    end
    
    action MakeTreeItem(text name) returns TreeItem
        TreeItem item
        Color color
        item:SetBackgroundColor(color:White())
        item:SetBehavior(nextBehavior)
        item:SetName(name)
        return item
    end
    
    action GetProjectNamePage returns Page
        return projectNamePage
    end

    action GetTemplatePage returns Page
        return templatePage
    end

    action GetOkBehavior returns NewProjectOkBehavior
        return okBehavior
    end

end
