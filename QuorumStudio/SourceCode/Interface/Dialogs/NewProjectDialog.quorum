class NewProjectDialog is Dialog, SelectionListener
    boolean initialized = false
    GameStateManager gameManager
    TabPane tabPane
    QuorumStudio studio = cast(QuorumStudio, gameManager:GetGame())
    Font fontAwesome
    Resources resources
    HashTable<text, text> templateHash

    constant text BLANK = "Blank"
    constant text APP = "App"
    constant text GAMES = "Game"
    constant text SCENE = "Scene"
    constant text MOBILE = "Mobile"
    constant text IMAGE_SHEET = "Image Sheet"
    constant text PHYSICS2D = "2D Physics"
    constant text PHYSICS3D = "3D Physics"
    constant text SKYBOX = "Skybox"
    constant text SCENE2D = "2D Scene"
    constant text SCENE3D = "3D Scene"
    constant text BAR_CHART = "Bar Chart"
    constant text PIE_CHART = "Pie Chart"
    constant text SCATTERPLOT = "Scatterplot"
    constant text DESCRIPTIVES = "Descriptive Statistics"
    constant text CORRELATIONS = "Correlations"
    constant text COMPARE_MEANS = "Compare Means"
    constant text PLAY_SOUND = "Play Sound"
    constant text SINE_WAVE = "Sine Wave"
    constant text MIDI = "MIDI"
    constant text DATABASE = "Database"
    constant text LEGO_MINDSTORMS = "Lego EV3"
constant text LEGO_SPIKE_MOVE = "Lego Spike"
    constant text DOCUMENT = "Document"
    constant text INTERNET_SERVICE = "Networking"
    
    //Dialog Controls
    TextField nameField = undefined
    TextField locationField = undefined
    Button cancelButton = undefined
    Tree templateTree = undefined
    Array<TreeItem> initialSelection
    Label templateDescription = undefined
    CharacterIcon templateVisual = undefined
    CharacterIcon secondTemplateVisual = undefined
    Label secondPageLabel = undefined
    
    Page templatePage = undefined
    Page projectNamePage = undefined

    // Names for the nameField and locationField
    constant text NAME_FIELD_ID = "Name"
    constant text LOCATION_FIELD_ID = "Location"
    constant text CANCEL_BUTTON = "Cancel"
    constant text OK_BUTTON = "Ok"

    //Dialog Behaviors
    DialogCancelBehavior cancelBehavior
    NewProjectBrowseBehavior browseBehavior
    NewProjectOkBehavior okBehavior
    NewProjectNextBehavior nextBehavior
    NewProjectBackBehavior backBehavior
    text selectedProject = BLANK
    
    //set by the browseBehavior, used by the okayBehavior to set the QuorumProject location
    File locationPath
    //set to blank application template by default. Changes based on user's application selection in the dialog
    text templatePath = "Templates/New/Blank" 

    on create
        File file
        file:SetPath("Resources/Fonts/Font Awesome 6 Free-Solid-900.otf")
        fontAwesome:LoadFont(file)

        browseBehavior:SetDialog(me)
        browseBehavior:SetMainApplication(studio)
        cancelBehavior:SetDialog(me)
        okBehavior:SetDialog(me)
        okBehavior:SetMainApplication(studio)
        nextBehavior:SetDialog(me)
        nextBehavior:SetMainApplication(studio)
        backBehavior:SetDialog(me)
        backBehavior:SetMainApplication(studio)
        SetBehavior(nextBehavior)

        SetVerticalLayoutMode(parent:Control:STANDARD)
    end

    action Initialize
        initialized = true
        SetName("New Project Dialog")
        SetPercentageWidth(0.50)
        SetPercentageHeight(0.75)
        
        SetupDefaultPage()
        templateTree:AddSelectionListener(me)
        templatePage = GetDefaultPage()
        StackedRowPage temp
        projectNamePage = temp
        SetupSecondPageElements(projectNamePage)
        PrepareTemplateHash()
    end

    action SelectionChanged(SelectionEvent selection)
        TreeSelection treeSelection = templateTree:GetSelection() 

        if treeSelection = undefined
            return now
        end
        
TreeItem selected = treeSelection:GetTreeItem()

        if selected = undefined
            return now
        end
        
        if selected:IsSubtree()
            return now
        end
        
        text templateName = selected:GetName()
        selectedProject = templateName
        templatePath = templateHash:GetValue(selectedProject)
        SetTemplateImage(templateName, templateVisual)
        if templateName = BLANK
            templateDescription:SetText("A blank template for starting from scratch.")
        elseif templateName = APP
            templateDescription:SetText("Get started making Apps using the Form Library.")
            elseif templateName = GAMES
            templateDescription:SetText("A template to get started making games using the Quorum Game Library.")
        elseif templateName = SCENE
            templateDescription:SetText("A project to get started with using Scenes.")
        elseif templateName = MOBILE
            templateDescription:SetText("A project for making apps that can run on mobile devices.")
        elseif templateName = IMAGE_SHEET
            templateDescription:SetText("A project for learning how to use image sheets with the Game Library.")
            elseif templateName = PHYSICS2D
            templateDescription:SetText("A template for learning how to simulate physics in 2D space.")
            elseif templateName = PHYSICS3D
            templateDescription:SetText("A template for learning how to simulate physics in 3D space.")
            elseif templateName = SKYBOX
            templateDescription:SetText("A project for learning how to use Skyboxes to create immersive backgrounds for games.")
            elseif templateName = SCENE2D
            templateDescription:SetText("A project to get started with using Scenes.")
            elseif templateName = SCENE3D
            templateDescription:SetText("A project to get started with using Scenes in 3D.")
            elseif templateName = BAR_CHART
            templateDescription:SetText("Create a Bar Chart using Quorum Charts.")
            elseif templateName = PIE_CHART
            templateDescription:SetText("Create a Pie Chart using Quorum Charts.")
            elseif templateName = SCATTERPLOT
            templateDescription:SetText("Create a Scatter Plot using Quorum Charts.")
            elseif templateName = DESCRIPTIVES
            templateDescription:SetText("Get started using DataFrames to get information about data.")
            elseif templateName = CORRELATIONS
            templateDescription:SetText("A project to get correlations from data using the Statistics Library.")
            elseif templateName = COMPARE_MEANS
            templateDescription:SetText("A project to compare means from data using the Statistics Library.")
            elseif templateName = PLAY_SOUND
            templateDescription:SetText("A project to learn to how get your programs to make sound.")
        elseif templateName = SINE_WAVE
            templateDescription:SetText("Use the audio library to make sounds from different sine waves and frequencies.")
        elseif templateName = MIDI
            templateDescription:SetText("Get sounds from using the Musical Instrument Digital Interface (MIDI)." )
        elseif templateName = DATABASE
            templateDescription:SetText("Get started using Quorum to query from a database.")
        elseif templateName = LEGO_MINDSTORMS
            templateDescription:SetText("A template to use Quorum to control a Lego EV3 robot.")
        elseif templateName = LEGO_SPIKE_MOVE
            templateDescription:SetText("A template to use Quorum to control a Lego Spike robot.")
        elseif templateName = DOCUMENT
            templateDescription:SetText("A template to build your project as an HTML document.")
        elseif templateName = INTERNET_SERVICE
            templateDescription:SetText("Get started using Quorum to send and recieve network requests.")
        end
    end

    /*
        Compares the location of any template project on the system
    */
    action PrepareTemplateHash
        templateHash:Add(BLANK,"Templates/New/Blank")
        templateHash:Add(APP,"Templates/New/Form")
        templateHash:Add(GAMES,"Templates/New/Game")
        templateHash:Add(SCENE,"Templates/Scenes/Blank")
        templateHash:Add(MOBILE,"Templates/New/Mobile")
        templateHash:Add(IMAGE_SHEET,"Templates/Other/ImageSheets")
        templateHash:Add(PHYSICS2D,"Templates/Other/Physics2D")
        templateHash:Add(PHYSICS3D,"Templates/Other/Physics3D")
        templateHash:Add(SKYBOX,"Templates/Other/Skybox")
        templateHash:Add(SCENE2D,"Templates/Scenes/Blank")
        templateHash:Add(SCENE3D,"Templates/Scenes/Scene3D")
        templateHash:Add(BAR_CHART,"Templates/New/BarChart")
        templateHash:Add(PIE_CHART,"Templates/New/PieChart")
        templateHash:Add(SCATTERPLOT,"Templates/New/Scatterplot")
        templateHash:Add(DESCRIPTIVES,"Templates/New/Descriptives")
        templateHash:Add(CORRELATIONS,"Templates/New/Correlations")
        templateHash:Add(COMPARE_MEANS,"Templates/New/CompareMeans")
        templateHash:Add(PLAY_SOUND,"Templates/Other/PlaySound")
        templateHash:Add(SINE_WAVE,"Templates/Other/SineWaves")
        templateHash:Add(MIDI,"Templates/Other/MIDI")
        templateHash:Add(DATABASE,"Templates/Other/Database")
        templateHash:Add(LEGO_MINDSTORMS,"Templates/New/Lego")
templateHash:Add(LEGO_SPIKE_MOVE,"Templates/Spike/Move")
        templateHash:Add(DOCUMENT,"Templates/Other/Document")
        templateHash:Add(INTERNET_SERVICE,"Templates/Other/InternetServices")
    end
    
