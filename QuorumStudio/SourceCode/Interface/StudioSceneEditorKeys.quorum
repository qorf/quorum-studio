package Libraries.Development.Environment.Studio.Interface

use Libraries.Game.InputSet
use Libraries.Interface.SceneEditorKeys

/*
    StudioSceneEditorKeys gives the scene editor the keys from Quorum Studio's
    key map, so a user's key map file can change them (step 6). A key the key
    map doesn't have uses the scene editor's own default. QuorumStudio gives
    it to Game:ReplaceSceneEditorInput once the key map is loaded.

    The keyboard camera keys in the key map aren't bound by the scene editor
    yet, so they aren't here.
*/
class StudioSceneEditorKeys is SceneEditorKeys
    KeyMap keyMap = undefined

    /*
        Sets the key map the keys come from.

        Attribute: Parameter map Studio's loaded key map
    */
    action SetKeyMap(KeyMap map)
        keyMap = map
    end

    /*
        Returns the key map the keys come from.

        Attribute: Returns The key map
    */
    action GetKeyMap returns KeyMap
        return keyMap
    end

    /*
        Returns the key map's key, or the default when the key map has none.
    */
    private action Choose(InputSet fromMap, InputSet fallback) returns InputSet
        if fromMap = undefined
            return fallback
        end
        return fromMap
    end

    action GetCameraFocusKey returns InputSet
        return Choose(keyMap:GetCameraFocusKey(), parent:SceneEditorKeys:GetCameraFocusKey())
    end

    action GetSelectionMoveLeft2DKey returns InputSet
        return Choose(keyMap:GetSelectionMoveLeft2DKey(), parent:SceneEditorKeys:GetSelectionMoveLeft2DKey())
    end

    action GetSelectionMoveRight2DKey returns InputSet
        return Choose(keyMap:GetSelectionMoveRight2DKey(), parent:SceneEditorKeys:GetSelectionMoveRight2DKey())
    end

    action GetSelectionMoveUp2DKey returns InputSet
        return Choose(keyMap:GetSelectionMoveUp2DKey(), parent:SceneEditorKeys:GetSelectionMoveUp2DKey())
    end

    action GetSelectionMoveDown2DKey returns InputSet
        return Choose(keyMap:GetSelectionMoveDown2DKey(), parent:SceneEditorKeys:GetSelectionMoveDown2DKey())
    end

    action GetSelectionMoveLeft3DKey returns InputSet
        return Choose(keyMap:GetSelectionMoveLeft3DKey(), parent:SceneEditorKeys:GetSelectionMoveLeft3DKey())
    end

    action GetSelectionMoveRight3DKey returns InputSet
        return Choose(keyMap:GetSelectionMoveRight3DKey(), parent:SceneEditorKeys:GetSelectionMoveRight3DKey())
    end

    action GetSelectionMoveUp3DKey returns InputSet
        return Choose(keyMap:GetSelectionMoveUp3DKey(), parent:SceneEditorKeys:GetSelectionMoveUp3DKey())
    end

    action GetSelectionMoveDown3DKey returns InputSet
        return Choose(keyMap:GetSelectionMoveDown3DKey(), parent:SceneEditorKeys:GetSelectionMoveDown3DKey())
    end

    action GetSelectionMoveForward3DKey returns InputSet
        return Choose(keyMap:GetSelectionMoveForward3DKey(), parent:SceneEditorKeys:GetSelectionMoveForward3DKey())
    end

