        return Choose(keyMap:GetTerrainNextLayerKey(), parent:SceneEditorKeys:GetTerrainNextLayerKey())
    end

    action GetTerrainRampPointKey returns InputSet
        return Choose(keyMap:GetTerrainRampPointKey(), parent:SceneEditorKeys:GetTerrainRampPointKey())
    end

    action GetTerrainTakeHeightKey returns InputSet
        return Choose(keyMap:GetTerrainTakeHeightKey(), parent:SceneEditorKeys:GetTerrainTakeHeightKey())
    end

    action GetTerrainToolKey(integer tool) returns InputSet
        InputSet fromMap = undefined
        if tool = 1
            fromMap = keyMap:GetTerrainTool1Key()
        elseif tool = 2
            fromMap = keyMap:GetTerrainTool2Key()
        elseif tool = 3
            fromMap = keyMap:GetTerrainTool3Key()
        elseif tool = 4
            fromMap = keyMap:GetTerrainTool4Key()
        elseif tool = 5
            fromMap = keyMap:GetTerrainTool5Key()
        elseif tool = 6
            fromMap = keyMap:GetTerrainTool6Key()
        elseif tool = 7
            fromMap = keyMap:GetTerrainTool7Key()
        elseif tool = 8
            fromMap = keyMap:GetTerrainTool8Key()
        elseif tool = 9
            fromMap = keyMap:GetTerrainTool9Key()
        elseif tool = 10
            fromMap = keyMap:GetTerrainTool10Key()
        elseif tool = 11
            fromMap = keyMap:GetTerrainTool11Key()
        elseif tool = 12
            fromMap = keyMap:GetTerrainTool12Key()
        end
        return Choose(fromMap, parent:SceneEditorKeys:GetTerrainToolKey(tool))
    end
end
