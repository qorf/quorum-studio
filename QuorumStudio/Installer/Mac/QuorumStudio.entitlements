<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    What Java needs to run under the hardened runtime. These match the ones
    Eclipse Temurin signs its own java with. BuildSignedInstaller.sh gives
    them to the app and to every program in the bundled JDK.
    - allow-jit and allow-unsigned-executable-memory: Java compiles code
      while it runs.
    - disable-library-validation: Java loads natives signed by others, such
      as LWJGL's, unpacked to a temporary folder, and those of a user's game.
    - allow-dyld-environment-variables: kept from Temurin's list.
    - debugger: Studio's debugger attaches to the Java it starts.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<key>com.apple.security.cs.debugger</key>
	<true/>
</dict>
</plist>
