
<config>
  <mainJar>../../Default.jar</mainJar>
  <os>ios</os>
  <target>ios</target>
  <resources>
    <resource>
      <directory>media</directory>
      <targetPath>media</targetPath>
    </resource>
  </resources>
  <classpath>
    <classpathentry>../../Default.jar</classpathentry>
    <classpathentry>../../QuorumStandardLibrary.jar</classpathentry>
    <classpathentry>../../QuorumStandardPlugins.jar</classpathentry>
  </classpath>
  <libs>
    <lib>../../jni/iosSimulator.a</lib>
  </libs>
  <weakFrameworks>
    <framework>OpenGLES</framework>
    <framework>UIKit</framework>
    <framework>QuartzCore</framework>
    <framework>CoreGraphics</framework>
    <framework>OpenAL</framework>
    <framework>AudioToolbox</framework>
    <framework>AVFoundation</framework>
  </weakFrameworks>
  <iosInfoPList>Info.plist.xml</iosInfoPList>
  <forceLinkClasses>
    <pattern>plugins.quorum.Libraries.Game.IOSSceneDelegate</pattern>
  </forceLinkClasses>
</config>
